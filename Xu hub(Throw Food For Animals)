local AutoFarmStatusParagraph
local function SetAutoFarmStatus(status)
    if AutoFarmStatusParagraph then
        AutoFarmStatusParagraph:SetDesc(status)
    end
end

local function WaitAutoFarm(seconds)
    local endTime = os.clock() + seconds
    while _G.AutoFarmEnabled and os.clock() < endTime do
        task.wait(math.min(0.25, endTime - os.clock()))
    end
    return _G.AutoFarmEnabled
end

task.spawn(function()
    while task.wait(0.25) do
        if not LocalPlayer or not LocalPlayer:IsDescendantOf(Players) then break end
        if _G.AutoFarmEnabled then
            SetAutoFarmStatus("前往投擲區")
            StartWalking()
            if WaitAutoFarm(60) then
                StopWalking()
                StartWalking(GetOwnedPullUpStand)
                SetAutoFarmStatus("跑步機中")
                if _G.AutoFarmEnabled and WaitAutoFarm(60) then
                    SetAutoFarmStatus("離開跑步機")
                    StopTraining()
                end
            end

            StopWalking()
            if not _G.AutoFarmEnabled then StopTraining() end
        end
    end
end)

