-- Auto Walk To Throw Area
local AutoWalkConnection
local LastMoveToTime = 0
local MOVE_TO_INTERVAL = 0.25

local function GetTargetPosition(target)
    if not target then return nil end
    if target:IsA("BasePart") then
        return target.Position
    elseif target:IsA("Model") then
        return target:GetPivot().Position
    end
    return nil
end

local function StopWalking()
    if AutoWalkConnection then
        AutoWalkConnection:Disconnect()
        AutoWalkConnection = nil
    end
end

local function StartWalking()
    StopWalking()
    LastMoveToTime = 0

    AutoWalkConnection = RunService.Heartbeat:Connect(function()
        if not _G.AutoWalkToThrowAreaEnabled then
            StopWalking()
            return
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local targetObject = workspace:FindFirstChild("StarterArea")

        if humanoid and root and targetObject then
            local targetPosition = GetTargetPosition(targetObject)
            if targetPosition then
                local destination = Vector3.new(targetPosition.X, root.Position.Y, targetPosition.Z)
                if (destination - root.Position).Magnitude > 3 then
                    local now = os.clock()
                    if now - LastMoveToTime >= MOVE_TO_INTERVAL then
                        LastMoveToTime = now
                        -- 遊戲可能會暫停或取消 MoveTo，持續重發以便恢復後繼續移動
                        humanoid:MoveTo(destination)
                    end
                else
                    LastMoveToTime = 0
                end
            end
        end
    end)
end

if _G.AutoWalkToThrowAreaEnabled then
    StartWalking()
end

--Auto Tap
local Controllers = LocalPlayer.PlayerScripts:WaitForChild("Client"):WaitForChild("Controllers")

-- Auto Buy Best Food
local CHECK_EVERY = 3
local RETRY_FAILED_AFTER = 30
local DataController = require(Controllers:WaitForChild("DataController"))
local FoodsConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("FoodsConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local FailedFoodPurchases = {}

local function IsFoodOwned(food)
    return DataController:GetPath("OwnedFoods." .. food.Index) == true
end

local function TryBuyFood(slot)
    local failedTime = FailedFoodPurchases[slot]
    if failedTime and os.clock() - failedTime < RETRY_FAILED_AFTER then
        return false
    end

    local ok, result = pcall(Remotes.Invoke, "Shop_Buy", slot)
    if ok and type(result) == "table" and result.Ok then
        FailedFoodPurchases[slot] = nil
        return true
    end

    FailedFoodPurchases[slot] = os.clock()
    return false
end

local function EquipFood(slot)
    local ok, result = pcall(Remotes.Invoke, "Shop_Equip", slot)
    return ok and type(result) == "table" and result.Ok == true
end

local function CheckBuyBestFood()
    local money = DataController:Get("Money") or 0
    local equipped = DataController:Get("EquippedFood")

    for slot = FoodsConfig.CountAll(), 1, -1 do
        local food = FoodsConfig.GetAny(slot)
        if food and not FoodsConfig.IsLocked(food.Index) then
            if IsFoodOwned(food) then
                if equipped ~= food.Index then
                    EquipFood(slot)
                end
                return
            end

            if food.Price <= money and TryBuyFood(slot) then
                EquipFood(slot)
                return
            end
        end
    end
end

task.spawn(function()
    while task.wait(CHECK_EVERY) do
        if not LocalPlayer or not LocalPlayer:IsDescendantOf(Players) then break end
        if _G.AutoBuyBestFoodEnabled then
            pcall(CheckBuyBestFood)
        end
    end
end)

if _G.AutoBuyBestFoodEnabled then
    pcall(CheckBuyBestFood)
end

local InputActions = require(Controllers:WaitForChild("InputActions"))
local ConfirmAction = InputActions.GetAction("Confirm")
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local CHECK_MIN_AGE = 0.45
local TAP_RETRY = 0.5
local CurrentMeter
local MeterFirstSeen = 0
local PromptAtStart
local LastTapTime = 0

local function Tap()
    if ConfirmAction then
        firesignal(ConfirmAction.Pressed)
        return
    end

    local camera = workspace.CurrentCamera
    local screen = camera and camera.ViewportSize or Vector2.new(800, 600)
    firesignal(UserInputService.InputBegan, {
        UserInputType = Enum.UserInputType.MouseButton1,
        KeyCode = Enum.KeyCode.Unknown,
        Position = Vector3.new(screen.X / 2, screen.Y / 2, 0),
    }, false)
end

local function GetMeterParts()
    local gui = PlayerGui:FindFirstChild("ThrowSequence")
    local meter = gui and gui:FindFirstChild("Meter")
    local bar = meter and meter:FindFirstChild("Bar")
    local marker = bar and bar:FindFirstChild("Marker")
    local numberLabel = marker and marker:FindFirstChild("Text")
    local prompt = meter and meter:FindFirstChild("Prompt")
    return meter, numberLabel, prompt
end

local AutoTapConnection = RunService.RenderStepped:Connect(function()
    if not _G.AutoTapEnabled then
        CurrentMeter = nil
        return
    end

    local meter, numberLabel, prompt = GetMeterParts()
    if not meter or not numberLabel or not numberLabel:IsA("TextLabel") then
        CurrentMeter = nil
        return
    end

    if meter ~= CurrentMeter then
        CurrentMeter = meter
        MeterFirstSeen = os.clock()
        PromptAtStart = prompt and prompt.Text
        LastTapTime = 0
    end

    if prompt and prompt.Text ~= PromptAtStart then return end

    local number = tonumber(numberLabel.Text:match("%d+"))
    if not number or number < _G.TapTarget then return end

    local now = os.clock()
    if now - MeterFirstSeen < CHECK_MIN_AGE or now - LastTapTime < TAP_RETRY then return end

    LastTapTime = now
    Tap()
end)

