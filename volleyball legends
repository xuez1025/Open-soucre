-- [SECTION 1.5] 核心模組：動態碰撞箱 (Hitbox)
-- ============================================================
local Hitbox = (function()
    local enabled      = false
    local currentSize  = 3.0 -- 統一調整的尺寸
    local lastUpdate   = 0
    local interval     = 5
    local updateThread = nil

    -- 移除 getRandomSize 函數，改為直接對球體套用 currentSize
    local function applyToBall(model)
        if not model:IsA("Model") then return end
        if not model.Name:match("^CLIENT_BALL_%d+$") then return end
        local basePart
        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") then basePart = child; break end
        end
        if not basePart then return end
        local hitbox = model:FindFirstChild("DYNAMIC_HITBOX")
        if not hitbox then
            hitbox = Instance.new("Part")
            hitbox.Name         = "DYNAMIC_HITBOX"
            hitbox.Shape        = Enum.PartType.Ball
            hitbox.Size         = Vector3.new(2, 2, 2) * currentSize
            hitbox.CFrame       = basePart.CFrame
            hitbox.Anchored     = true
            hitbox.CanCollide   = false
            hitbox.Transparency = 0.9
            hitbox.Material     = Enum.Material.Neon
            hitbox.Color        = Color3.fromRGB(255, 0, 0)
            hitbox.Parent       = model
        else
            hitbox.Size = Vector3.new(2, 2, 2) * currentSize
        end
    end

    local function updateAll()
        if not enabled then return end
        -- 取消隨機，直接拿目前的統一尺寸更新所有球體
        for _, model in ipairs(workspace:GetChildren()) do
            if model:IsA("Model") and model.Name:match("^CLIENT_BALL_%d+$") then
                applyToBall(model)
            end
        end
    end

    local function cleanup()
        for _, model in ipairs(workspace:GetChildren()) do
            if model:IsA("Model") and model.Name:match("^CLIENT_BALL_%d+$") then
                local hitbox = model:FindFirstChild("DYNAMIC_HITBOX")
                if hitbox then hitbox:Destroy() end
            end
        end
        if updateThread then
            updateThread:Disconnect()
            updateThread = nil
        end
    end

    local function startAutoUpdate()
        if updateThread then updateThread:Disconnect() end
        updateThread = RunService.Heartbeat:Connect(function()
            if tick() - lastUpdate >= interval then
                updateAll()
                lastUpdate = tick()
            end
        end)
    end

    -- 監聽新球體加入場景
    workspace.ChildAdded:Connect(function(child)
        if child:IsA("Model") and child.Name:match("^CLIENT_BALL_%d+$") then
            task.wait(0.1)
            if enabled then applyToBall(child) end
        end
    end)

    return {
        setEnabled = function(state)
            enabled = state
            if state then
                startAutoUpdate()
                updateAll()
            else
                cleanup()
            end
        end,
        setSize = function(v) -- 改為單一設定尺寸的介面
            currentSize = v
            if enabled then updateAll() end
        end,
    }
end)()

