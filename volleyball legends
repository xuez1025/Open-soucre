-- 儲存狀態與數值的變數
local isJumpEnabled = false
local customJumpValue = 10   -- 對應 Slider 的預設值
local defaultJumpValue = nil -- 用來記錄玩家最初的原始高度
local heartbeatConnection = nil -- 用來儲存循環監聽的連線

-- 取得並記錄原始跳躍高度的函數
local function getAndRecordDefaultJump(humanoid)
    if not defaultJumpValue then
        if humanoid.UseJumpPower then
            defaultJumpValue = humanoid.JumpPower
        else
            defaultJumpValue = humanoid.JumpHeight
        end
    end
end

-- 更新玩家跳躍高度的核心函數
local function updateJump()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- 確保有紀錄到初始值
    getAndRecordDefaultJump(humanoid)

    -- 根據 Toggle 狀態決定要給予自訂值還是恢復初始值
    local targetValue = isJumpEnabled and customJumpValue or defaultJumpValue

    if humanoid.UseJumpPower then
        humanoid.JumpPower = targetValue
    else
        humanoid.JumpHeight = targetValue
    end
end

-- 啟動或停止不斷刷新的循環
local function toggleLoop(enable)
    if enable then
        if not heartbeatConnection then
            heartbeatConnection = RunService.Heartbeat:Connect(function()
                updateJump()
            end)
        end
    else
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
        updateJump() -- 關閉時再執行一次，確保恢復成預設值
    end
end

-- 監聽角色重生
LocalPlayer.CharacterAdded:Connect(function(character)
    defaultJumpValue = nil -- 重置初始值紀錄
    local humanoid = character:WaitForChild("Humanoid")
    task.wait(0.5) -- 稍微等待確保 Humanoid 完全載入
    
    -- 如果原本就是開啟狀態，重生後自動繼續循環
    if isJumpEnabled then
        updateJump()
    end
end)

-- [[ 核心服務 ]]
local Camera = workspace.CurrentCamera

-- [[ ESP 變數與清理機制 ]]
local espEnabled = false
local linesPool  = {}

local function removePlayerLine(player)
    if linesPool[player] then
        linesPool[player]:Remove()
        linesPool[player] = nil
    end
end

local function createLine(isLocalPlayer)
    local line           = Drawing.new("Line")
    line.Thickness       = 2.5
    line.Transparency    = 1
    line.Visible         = false
    line.Color           = isLocalPlayer
                            and Color3.fromRGB(50, 255, 50)   -- 自己：綠色
                            or  Color3.fromRGB(255, 50, 50)   -- 他人：紅色
    return line
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
            local rootPart = char.HumanoidRootPart
            local head     = char.Head
            if not linesPool[player] then
                linesPool[player] = createLine(player == LocalPlayer)
            end
            local line            = linesPool[player]
            local lineStartPos    = head.Position + Vector3.new(0, 1.5, 0)
            local bodyLook        = rootPart.CFrame.LookVector
            local horizontalLook  = Vector3.new(bodyLook.X, 0, bodyLook.Z).Unit
            local lineEndPos      = lineStartPos + (horizontalLook * 15)
            local startSP, startV = Camera:WorldToViewportPoint(lineStartPos)
            local endSP,   endV   = Camera:WorldToViewportPoint(lineEndPos)
            if startV and endV
                and char:FindFirstChild("Humanoid")
                and char.Humanoid.Health > 0 then
                line.From    = Vector2.new(startSP.X, startSP.Y)
                line.To      = Vector2.new(endSP.X,   endSP.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            if linesPool[player] then
                linesPool[player].Visible = false
            end
        end
    end
end)

Players.PlayerRemoving:Connect(removePlayerLine)

