-- [SECTION 2] 核心模組：速度控制
-- ============================================================
local Speed = (function()
    local initialChar     = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local initialHumanoid = initialChar:WaitForChild("Humanoid")
    local DefaultSpeed    = initialHumanoid.WalkSpeed

    local enabled     = false
    local targetSpeed = DefaultSpeed
    local connection  = nil

    local function applySpeed()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = targetSpeed
        end
    end
    local function restoreSpeed()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = DefaultSpeed
        end
    end
    local function setEnabled(state)
        enabled = state
        if connection then connection:Disconnect(); connection = nil end
        if enabled then
            connection = RunService.Heartbeat:Connect(applySpeed)
        else
            restoreSpeed()
        end
    end
    local function setTarget(value) targetSpeed = value end

    LocalPlayer.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid")
        if enabled then hum.WalkSpeed = targetSpeed
        else DefaultSpeed = hum.WalkSpeed end
    end)

    return {
        setEnabled = setEnabled,
        setTarget  = setTarget,
        getDefault = function() return DefaultSpeed end,
    }
end)()

