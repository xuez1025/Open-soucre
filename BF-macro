-- ========================================================
-- 核心功能函數
-- ========================================================
local function Skill_Auto(Key)
    local Code = (Key == "Space") and Enum.KeyCode.Space or Enum.KeyCode[Key:upper()]
    if not Code then return end
    VirtualInputManager:SendKeyEvent(true,  Code, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Code, false, game)
end

local function Skill_AutoHold(Key, durationMs)
    local Code = (Key == "Space") and Enum.KeyCode.Space or Enum.KeyCode[Key:upper()]
    if not Code then return end
    VirtualInputManager:SendKeyEvent(true,  Code, false, game)
    task.wait(math.max(durationMs or 100, 50) / 1000)
    VirtualInputManager:SendKeyEvent(false, Code, false, game)
end

local function CheckItem(Item)
    if not Character then return nil end
    return Character:FindFirstChild(Item) or LocalPlayer.Backpack:FindFirstChild(Item)
end

local function GetCurrentWeapon()
    if not Character then return nil end
    local tool = Character:FindFirstChildOfClass("Tool")
    return tool and tool.Name or nil
end

local function EquipWeapon(weaponName)
    local item = LocalPlayer.Backpack:FindFirstChild(weaponName)
    if item and Character and Character:FindFirstChild("Humanoid") then
        Character.Humanoid:EquipTool(item)
        return true
    end
    return false
end

local function CheckSkill(Weapon, Key)
    local ok, result = pcall(function()
        local itemObj = CheckItem(Weapon)
        if not itemObj then return false end
        local Weapon2 = itemObj:FindFirstChild("ToolTip") and itemObj.ToolTip.Value or itemObj.Name
        if _G.Config.Farm and _G.Config.Farm.Mastery then
            if _G.Config.Farm.MasteryType ~= Weapon2 then return false end
        end
        local Skills = _G.Config.Setting and _G.Config.Setting.Skill and _G.Config.Setting.Skill[Weapon2]
        if not Skills then return true end
        for _, v in ipairs(Skills) do
            if v == Key then return true end
        end
        return false
    end)
    return ok and result
end

local function CoolDown_Auto()
    if SkillCoolDown or not AutoSkillEnabled then return end
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui or not PlayerGui:FindFirstChild("Main") or not PlayerGui.Main:FindFirstChild("Skills") then return end
    local Skills = PlayerGui.Main.Skills
    for _, Weapon in pairs(Skills:GetChildren()) do
        for _, v in pairs(Weapon:GetChildren()) do
            if table.find({"Z","X","C","V","F"}, v.Name) then
                local Key          = v.Name
                local Cooldown     = v:FindFirstChild("Cooldown", true)
                local Level        = v:FindFirstChild("Level")
                local targetWeapon = CheckItem(Weapon.Name)
                if Cooldown and Level and targetWeapon and CheckSkill(Weapon.Name, Key) then
                    local reqLevel     = tonumber(Level.Text:match("%d+")) or 0
                    local currentLevel = targetWeapon:FindFirstChild("Level") and targetWeapon.Level.Value or 0
                    if Cooldown.Size.X.Scale == 0 and reqLevel <= currentLevel then
                        task.spawn(function()
                            SkillCoolDown = true
                            Skill_Auto(Key)
                            task.wait(0.5)
                            SkillCoolDown = false
                        end)
                    end
                end
            end
        end
    end
end

-- ========================================================
-- Macro 播放
-- ========================================================
local function RunMacro(macroIndex)
    local macro = _G.Macros[macroIndex]
    if not macro then return end
    local co = coroutine.create(function()
        for _, step in ipairs(macro.steps) do
            if step.type == "skill" then
                Skill_AutoHold(step.key, step.duration or 100)
                if (step.waitAfter or 0) > 0 then task.wait(step.waitAfter / 1000) end
            elseif step.type == "switch" then
                EquipWeapon(step.weapon)
                if (step.waitAfter or 0) > 0 then task.wait(step.waitAfter / 1000) end
            elseif step.type == "wait" then
                task.wait((step.ms or 100) / 1000)
            end
        end
        MacroRunning[macroIndex] = nil
    end)
    MacroRunning[macroIndex] = co
    coroutine.resume(co)
end

local function StopMacro(macroIndex)
    MacroRunning[macroIndex] = nil
end

-- ========================================================
-- Macro 熱鍵監聽
-- ========================================================
local HotkeyConnections = {}

local function RefreshHotkeyListeners()
    for _, conn in pairs(HotkeyConnections) do conn:Disconnect() end
    HotkeyConnections = {}
    for i, macro in ipairs(_G.Macros) do
        if macro.hotkey then
            local idx = i
            local connBegan = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                local matched = (macro.hotkey.keyCode and input.KeyCode == macro.hotkey.keyCode)
                             or (macro.hotkey.mouseButton and input.UserInputType == macro.hotkey.mouseButton)
                if not matched then return end
                if macro.triggerMode == "toggle" then
                    if MacroRunning[idx] then StopMacro(idx) else RunMacro(idx) end
                elseif macro.triggerMode == "press" or macro.triggerMode == "hold" then
                    RunMacro(idx)
                end
            end)
            table.insert(HotkeyConnections, connBegan)
            if macro.triggerMode == "hold" or macro.triggerMode == "release" then
                local connEnded = UserInputService.InputEnded:Connect(function(input, gpe)
                    if gpe then return end
                    local matched = (macro.hotkey.keyCode and input.KeyCode == macro.hotkey.keyCode)
                                 or (macro.hotkey.mouseButton and input.UserInputType == macro.hotkey.mouseButton)
                    if not matched then return end
                    if macro.triggerMode == "hold" then StopMacro(idx)
                    elseif macro.triggerMode == "release" then RunMacro(idx) end
                end)
                table.insert(HotkeyConnections, connEnded)
            end
        end
    end
end

-- ========================================================
-- 錄製系統
-- ========================================================
local RecordConnections = {}

local function StartRecording()
    RecordState.active        = true
    RecordState.startTime     = tick()
    RecordState.lastEventTime = tick()
    RecordState.steps         = {}
    RecordState.currentWeapon = GetCurrentWeapon()

    local skillKeys    = {"Z","X","C","V","F"}
    local keyPressTime = {}

    local conn1 = UserInputService.InputBegan:Connect(function(input, _gpe)
        if not RecordState.active then return end
        for _, sk in ipairs(skillKeys) do
            if input.KeyCode == Enum.KeyCode[sk] then
                local now = tick()
                if #RecordState.steps > 0 then
                    local last = RecordState.steps[#RecordState.steps]
                    if last.type == "skill" or last.type == "switch" then
                        last.waitAfter = math.max(math.floor((now - RecordState.lastEventTime) * 1000), 0)
                    end
                end
                keyPressTime[sk] = now
                break
            end
        end
    end)

    local conn2 = UserInputService.InputEnded:Connect(function(input, _gpe)
        if not RecordState.active then return end
        for _, sk in ipairs(skillKeys) do
            if input.KeyCode == Enum.KeyCode[sk] then
                local now      = tick()
                local pressAt  = keyPressTime[sk]
                local duration = pressAt and math.max(math.floor((now - pressAt) * 1000), 50) or 100
                keyPressTime[sk]          = nil
                RecordState.lastEventTime = now

                local cw = GetCurrentWeapon()
                if cw and cw ~= RecordState.currentWeapon then
                    table.insert(RecordState.steps, { type="switch", weapon=cw, waitAfter=0 })
                    RecordState.currentWeapon = cw
                end

                table.insert(RecordState.steps, { type="skill", key=sk, duration=duration, waitAfter=0 })
                break
            end
        end
    end)

    table.insert(RecordConnections, conn1)
    table.insert(RecordConnections, conn2)
end

local function StopRecording()
    RecordState.active = false
    for _, c in pairs(RecordConnections) do c:Disconnect() end
    RecordConnections = {}
    EditSteps = DeepCopy(RecordState.steps)
end

