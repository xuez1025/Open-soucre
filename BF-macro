        dragStart = input.Position
        startPos  = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        TabBar.Visible     = false
        for _, p in pairs(TabPages) do p.Visible = false end
        MainFrame.Size     = UDim2.new(0, SZ.winW, 0, SZ.topH)
        MinimizeBtn.Text   = "展開"
    else
        TabBar.Visible     = true
        for n, p in pairs(TabPages) do p.Visible = (n == CurrentTab) end
        MainFrame.Size     = UDim2.new(0, SZ.winW, 0, SZ.winH)
        MinimizeBtn.Text   = "縮小"
    end
end)

local HeartbeatConnection
CloseBtn.MouseButton1Click:Connect(function()
    if HeartbeatConnection then HeartbeatConnection:Disconnect() end
    for _, c in pairs(HotkeyConnections) do c:Disconnect() end
    for _, c in pairs(RecordConnections) do c:Disconnect() end
    ScreenGui:Destroy()
end)

-- ========================================================
-- 主循環：技能狀態更新 & 自動冷卻
-- ========================================================
HeartbeatConnection = RunService.Heartbeat:Connect(function()
    CoolDown_Auto()

    if CurrentTab ~= "skill" then return end

    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui or not PlayerGui:FindFirstChild("Main") or not PlayerGui.Main:FindFirstChild("Skills") then
        for _, label in pairs(KeyLabels) do
            label.Text       = "等待 UI 載入中"
            label.TextColor3 = C.sub
        end
        return
    end

    local Skills               = PlayerGui.Main.Skills
    local currentEquippedWeapon = GetCurrentWeapon()

    if not currentEquippedWeapon then
        for _, label in pairs(KeyLabels) do
            label.Text       = "未裝備武器"
            label.TextColor3 = C.sub
        end
        return
    end

    local weaponSkillFolder = Skills:FindFirstChild(currentEquippedWeapon)
    if not weaponSkillFolder then
        for _, label in pairs(KeyLabels) do
            label.Text       = "未獲取該武器技能數據"
            label.TextColor3 = C.sub
        end
        return
    end

    for key, label in pairs(KeyLabels) do
        local skillUI = weaponSkillFolder:FindFirstChild(key)
        if skillUI then
            local cooldown     = skillUI:FindFirstChild("Cooldown", true)
            local levelObj     = skillUI:FindFirstChild("Level")
            local targetWeapon = CheckItem(currentEquippedWeapon)
            if levelObj and targetWeapon then
                local reqLevel     = tonumber(levelObj.Text:match("%d+")) or 0
                local currentLevel = targetWeapon:FindFirstChild("Level") and targetWeapon.Level.Value or 0
                if currentLevel < reqLevel then
                    label.Text       = "未解鎖  需求 Lv." .. reqLevel
                    label.TextColor3 = C.red
                elseif cooldown and cooldown.Size.X.Scale > 0 then
                    local pct        = math.floor((1 - cooldown.Size.X.Scale) * 100)
                    label.Text       = "冷卻中  " .. pct .. "%"
                    label.TextColor3 = C.yellow
                else
                    label.Text       = "準備就緒"
                    label.TextColor3 = C.green
                end
            else
                label.Text       = "數據解析中"
                label.TextColor3 = C.sub
            end
        else
            label.Text       = "無此技能"
            label.TextColor3 = C.border
        end
    end
end)
