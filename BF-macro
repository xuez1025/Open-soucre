local function RebuildStepsList()
    for _, child in pairs(StepsScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for idx, step in ipairs(EditSteps) do
        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, SZ.stepH)
        row.BackgroundColor3 = C.bg3
        row.LayoutOrder      = idx
        row.Parent           = StepsScroll
        MakeCorner(row, 5)
        MakePadding(row, 0, 0, 8, 4)

        -- 序號
        MakeLabel(row, {
            text = tostring(idx),
            color = C.sub, size = SZ.fsS,
            sz = UDim2.new(0, 22, 1, 0),
            xalign = Enum.TextXAlignment.Center,
        })

        -- 類型文字
        local typeStr = (step.type == "skill" and "技能") or (step.type == "switch" and "切換") or "等待"
        local typeColor = (step.type == "skill" and C.yellow) or (step.type == "switch" and C.accent) or C.green
        MakeLabel(row, {
            text = typeStr, color = typeColor, size = SZ.fsS,
            font = Enum.Font.SourceSansBold,
            sz = UDim2.new(0, 32, 1, 0), pos = UDim2.new(0, 22, 0, 0),
        })

        local fieldX = 58   -- 欄位起始 X

        if step.type == "skill" then
            MakeLabel(row, { text = "鍵", color = C.sub, size = SZ.fsS,
                sz = UDim2.new(0, 18, 1, 0), pos = UDim2.new(0, fieldX, 0, 0) })
            local keyInput = MakeInput(row, {
                text = step.key or "Z", bg = C.bg2, size = SZ.fsS,
                sz = UDim2.new(0, 34, 0, SZ.inputH - 2), pos = UDim2.new(0, fieldX+20, 0, 2),
            })
            keyInput.FocusLost:Connect(function()
                local k = keyInput.Text:upper()
                if table.find({"Z","X","C","V","F","SPACE"}, k) then
                    EditSteps[idx].key = k
                else
                    keyInput.Text = EditSteps[idx].key or "Z"
                end
            end)

            MakeLabel(row, { text = "持續ms", color = C.sub, size = SZ.fsS,
                sz = UDim2.new(0, 46, 1, 0), pos = UDim2.new(0, fieldX+58, 0, 0) })
            local durInput = MakeInput(row, {
                text = tostring(step.duration or 100), bg = C.bg2, size = SZ.fsS,
                sz = UDim2.new(0, 54, 0, SZ.inputH - 2), pos = UDim2.new(0, fieldX+106, 0, 2),
            })
            durInput.FocusLost:Connect(function()
                EditSteps[idx].duration = tonumber(durInput.Text) or 100
                durInput.Text = tostring(EditSteps[idx].duration)
            end)

            MakeLabel(row, { text = "等待ms", color = C.sub, size = SZ.fsS,
                sz = UDim2.new(0, 46, 1, 0), pos = UDim2.new(0, fieldX+164, 0, 0) })
            local waitInput = MakeInput(row, {
                text = tostring(step.waitAfter or 0), bg = C.bg2, size = SZ.fsS,
                sz = UDim2.new(0, 54, 0, SZ.inputH - 2), pos = UDim2.new(0, fieldX+212, 0, 2),
            })
            waitInput.FocusLost:Connect(function()
                EditSteps[idx].waitAfter = tonumber(waitInput.Text) or 0
                waitInput.Text = tostring(EditSteps[idx].waitAfter)
            end)

        elseif step.type == "switch" then
            MakeLabel(row, { text = "武器", color = C.sub, size = SZ.fsS,
                sz = UDim2.new(0, 32, 1, 0), pos = UDim2.new(0, fieldX, 0, 0) })
            local wInput = MakeInput(row, {
                text = step.weapon or "", placeholder = "武器名稱", bg = C.bg2, size = SZ.fsS,
                sz = UDim2.new(0, 140, 0, SZ.inputH - 2), pos = UDim2.new(0, fieldX+34, 0, 2),
            })
            wInput.FocusLost:Connect(function() EditSteps[idx].weapon = wInput.Text end)

            MakeLabel(row, { text = "等待ms", color = C.sub, size = SZ.fsS,
                sz = UDim2.new(0, 46, 1, 0), pos = UDim2.new(0, fieldX+178, 0, 0) })
            local waitInput2 = MakeInput(row, {
                text = tostring(step.waitAfter or 0), bg = C.bg2, size = SZ.fsS,
                sz = UDim2.new(0, 54, 0, SZ.inputH - 2), pos = UDim2.new(0, fieldX+226, 0, 2),
            })
            waitInput2.FocusLost:Connect(function()
                EditSteps[idx].waitAfter = tonumber(waitInput2.Text) or 0
                waitInput2.Text = tostring(EditSteps[idx].waitAfter)
            end)

        elseif step.type == "wait" then
            MakeLabel(row, { text = "等待時間ms", color = C.sub, size = SZ.fsS,
                sz = UDim2.new(0, 72, 1, 0), pos = UDim2.new(0, fieldX, 0, 0) })
            local msInput = MakeInput(row, {
                text = tostring(step.ms or 100), bg = C.bg2, size = SZ.fsS,
                sz = UDim2.new(0, 70, 0, SZ.inputH - 2), pos = UDim2.new(0, fieldX+74, 0, 2),
            })
            msInput.FocusLost:Connect(function()
                EditSteps[idx].ms = tonumber(msInput.Text) or 100
                msInput.Text = tostring(EditSteps[idx].ms)
            end)
        end

        -- 右側操作按鈕：刪除 / 上移 / 下移
        local ctrlW = 30
        local delBtn = MakeBtn(row, {
            text = "X", bg = C.bg2, color = C.red, size = SZ.fsS,
            sz = UDim2.new(0, ctrlW, 0, SZ.stepH - 6), pos = UDim2.new(1, -(ctrlW + 2), 0, 3),
        })
        local upBtn = MakeBtn(row, {
            text = "위", bg = C.bg2, color = C.sub, size = SZ.fsS,
            sz = UDim2.new(0, ctrlW, 0, SZ.stepH - 6), pos = UDim2.new(1, -(ctrlW*2 + 5), 0, 3),
        })
        local dnBtn = MakeBtn(row, {
            text = "아", bg = C.bg2, color = C.sub, size = SZ.fsS,
            sz = UDim2.new(0, ctrlW, 0, SZ.stepH - 6), pos = UDim2.new(1, -(ctrlW*3 + 8), 0, 3),
        })

        -- 上移/下移改用中文，避免符號顯示問題
        upBtn.Text = "上"
        dnBtn.Text = "下"

        local capturedIdx = idx
        delBtn.MouseButton1Click:Connect(function()
            table.remove(EditSteps, capturedIdx)
            RebuildStepsList()
        end)
        upBtn.MouseButton1Click:Connect(function()
            if capturedIdx > 1 then
                EditSteps[capturedIdx], EditSteps[capturedIdx-1] = EditSteps[capturedIdx-1], EditSteps[capturedIdx]
                RebuildStepsList()
            end
        end)
        dnBtn.MouseButton1Click:Connect(function()
            if capturedIdx < #EditSteps then
                EditSteps[capturedIdx], EditSteps[capturedIdx+1] = EditSteps[capturedIdx+1], EditSteps[capturedIdx]
                RebuildStepsList()
            end
        end)
    end
end

-- 載入 Macro 到編輯器
local function LoadMacroToEditor(idx)
    EditingIndex   = idx
    local macro    = _G.Macros[idx]
    if not macro then return end

    NameInput.Text = macro.name or ""
    EditSteps      = DeepCopy(macro.steps or {})
    EditHotkey     = macro.hotkey and DeepCopy(macro.hotkey) or nil

    CurrentTrigger = macro.triggerMode or "toggle"
    for m, b in pairs(TriggerBtns) do
        b.BackgroundColor3 = (m == CurrentTrigger) and C.purple or C.bg2
        b.TextColor3       = (m == CurrentTrigger) and Color3.fromRGB(255,255,255) or C.sub
    end

    if EditHotkey then
        local hkText = EditHotkey.keyCode
            and tostring(EditHotkey.keyCode):gsub("Enum.KeyCode.", "")
            or (EditHotkey.mouseButton and tostring(EditHotkey.mouseButton):gsub("Enum.UserInputType.", ""))
            or "未設定"
        HotkeyDisplay.Text       = hkText
        HotkeyDisplay.TextColor3 = C.yellow
    else
        HotkeyDisplay.Text       = "點擊設定"
        HotkeyDisplay.TextColor3 = C.sub
    end

    EditTitle.Text = "編輯：" .. (macro.name or "未命名")
    RebuildStepsList()
end

-- 清除編輯器
local function ClearEditor()
    EditingIndex             = nil
    EditSteps                = {}
    EditHotkey               = nil
    NameInput.Text           = ""
    HotkeyDisplay.Text       = "點擊設定"
    HotkeyDisplay.TextColor3 = C.sub
    CurrentTrigger           = "toggle"
    for m, b in pairs(TriggerBtns) do
        b.BackgroundColor3 = (m == "toggle") and C.purple or C.bg2
        b.TextColor3       = (m == "toggle") and Color3.fromRGB(255,255,255) or C.sub
    end
    EditTitle.Text = "新增連招"
    RebuildStepsList()
end

