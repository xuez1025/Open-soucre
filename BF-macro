-- 輔助函數
local function MakeCorner(parent, r)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, r or 7)
    return c
end
local function MakeStroke(parent, col, thick)
    local s = Instance.new("UIStroke", parent)
    s.Color = col or C.border; s.Thickness = thick or 1
    return s
end
local function MakePadding(parent, t, b, l, r)
    local p = Instance.new("UIPadding", parent)
    p.PaddingTop    = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft   = UDim.new(0, l or 0)
    p.PaddingRight  = UDim.new(0, r or 0)
    return p
end
local function MakeLabel(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.TextColor3    = props.color  or C.text
    l.TextSize      = props.size   or SZ.fs
    l.Font          = props.font   or Enum.Font.SourceSans
    l.Text          = props.text   or ""
    l.TextXAlignment = props.xalign or Enum.TextXAlignment.Left
    l.TextYAlignment = props.yalign or Enum.TextYAlignment.Center
    l.Size          = props.sz     or UDim2.new(1, 0, 0, SZ.rowH)
    l.Position      = props.pos    or UDim2.new(0, 0, 0, 0)
    l.TextWrapped   = props.wrap   or false
    l.Parent        = parent
    return l
end
local function MakeBtn(parent, props)
    local b = Instance.new("TextButton")
    b.BackgroundColor3 = props.bg    or C.bg2
    b.TextColor3       = props.color or C.text
    b.TextSize         = props.size  or SZ.fs
    b.Font             = props.font  or Enum.Font.SourceSansBold
    b.Text             = props.text  or "Button"
    b.AutoButtonColor  = true
    b.Size             = props.sz   or UDim2.new(0, 90, 0, SZ.btnH)
    b.Position         = props.pos  or UDim2.new(0, 0, 0, 0)
    b.Parent           = parent
    MakeCorner(b, 6)
    return b
end
local function MakeInput(parent, props)
    local b = Instance.new("TextBox")
    b.BackgroundColor3  = props.bg          or C.bg2
    b.TextColor3        = props.color       or C.text
    b.TextSize          = props.size        or SZ.fs
    b.Font              = props.font        or Enum.Font.SourceSans
    b.Text              = props.text        or ""
    b.PlaceholderText   = props.placeholder or ""
    b.PlaceholderColor3 = C.sub
    b.ClearTextOnFocus  = false
    b.Size              = props.sz  or UDim2.new(0, 120, 0, SZ.inputH)
    b.Position          = props.pos or UDim2.new(0, 0, 0, 0)
    b.Parent            = parent
    MakeCorner(b, 6)
    MakePadding(b, 0, 0, 8, 8)
    return b
end

