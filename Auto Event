function Halloween.KnockDoor(entry)
    if not Halloween.Auto() then return end
    Halloween.PendingDoor = entry
    if Halloween.IsBossDoor(entry.Door) or (Halloween.BossEntered and Halloween.BossDoor == entry.Door) then Halloween.EnterBoss(entry); return end
    if entry.StackPaused or not entry.Door or not entry.Door:GetAttribute("DoorOpen") then
        _tp(entry.CFrame + Vector3.new(0, 3, 0), function() return not Halloween.Auto() end)
    end
    if not Halloween.Auto() then entry.StackPaused = Halloween.Paused(); return end
    entry.StackPaused = nil
    task.wait(0.2)
    if not Halloween.Auto() then entry.StackPaused = Halloween.Paused(); return end

    pcall(function()
        local dialogue = LocalPlayer.PlayerGui.Main.Dialogue
        if dialogue.Visible then dialogue.Visible = false end
    end)

    local prompt = Halloween.EntryPrompt(entry)
    local door = entry.Door
    if not (prompt and door and fireproximityprompt) then Halloween.PendingDoor = nil; return end

    local opened = door:GetAttribute("DoorOpen") == true
    if not opened then
        for _ = 1, 2 do
            pcall(fireproximityprompt, prompt)
            local openBy = os.clock() + Halloween.KnockDelay + 1
            while os.clock() < openBy and Halloween.Auto() and Halloween.InWindow() do
                if door:GetAttribute("DoorOpen") then opened = true break end
                task.wait(0.1)
            end
            if opened or not Halloween.Auto() or not Halloween.InWindow() then break end
        end
    end
    if not opened then
        entry.StackPaused = Halloween.Paused()
        if not entry.StackPaused then Halloween.PendingDoor = nil end
        return
    end

    local state = entry.StackState or {}
    entry.StackState = state
    local deadline = os.clock() + Halloween.EventMaxSeconds
    local seen, fired, hiddenAt = state.Seen or false, state.Fired or false, state.HiddenAt
    while door:GetAttribute("DoorOpen") and os.clock() < deadline and Halloween.Auto() do
        if Halloween.IsBossDoor(door) then Halloween.EnterBoss(entry); break end
        Halloween.HandleDoorEvent(door, state)
        if not Halloween.Auto() then break end
        if Halloween.DialogueVisible() then
            seen, hiddenAt = true, nil
        elseif seen and not fired then
            hiddenAt = hiddenAt or os.clock()
            if os.clock() - hiddenAt >= 1.5 then
                fired = true
                Halloween.FireDoorRemotes()
            end
        end
        state.Seen, state.Fired, state.HiddenAt = seen, fired, hiddenAt
        task.wait(0.2)
    end
    entry.StackPaused = Halloween.Paused()
    if not entry.StackPaused then Halloween.PendingDoor = nil; entry.StackState = nil end
end

