function Halloween.NearestPumpkin(origin)
    local folder = Workspace:FindFirstChild("PumpkinHunt")
    if not folder then return nil, false, false end
    local now = os.clock()
    local children = folder:GetChildren()
    local nearest, best, bestRare, rarePresent = nil, nil, false, false
    local ready = #children > 0
    for _, pumpkin in ipairs(children) do
        local rare = pumpkin:GetAttribute("PumpkinRare") == true
        if pumpkin.Name == "Pumpkin" or rare then
            local root = pumpkin:FindFirstChild("RootPart")
            local state = pumpkin:GetAttribute("PumpkinState")
            if not root or state == nil then ready = false end
            if rare and (not root or Halloween.PumpkinReachable(root.Position)) then rarePresent = true end
            if root and Halloween.PumpkinReachable(root.Position) and state == "Idle" and (_G.AutoPumpkin or rare)
                and (not (_G.AutoRarePumpkin and _G.AutoRarePumpkinHop) or rare)
                and (Halloween.PumpkinSkip[pumpkin] or 0) < now then
                local dist = (root.Position - origin).Magnitude
                if not best or (rare and not bestRare) or (rare == bestRare and dist < best) then
                    nearest, best, bestRare = pumpkin, dist, rare
                end
            end
        end
    end
    return nearest, rarePresent, ready
end

