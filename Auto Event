function Halloween.PumpkinBoss.Arena()
    local map = Workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("DapperJackArena")
end

function Halloween.PumpkinBoss.Inside(arena)
    arena = arena or Halloween.PumpkinBoss.Arena()
    local center, root = arena and arena:GetAttribute("ArenaCenter"), GetHRP()
    if typeof(center) ~= "Vector3" or not root then return false end
    local delta = root.Position - center
    return Vector3.new(delta.X, 0, delta.Z).Magnitude <= 360 and math.abs(delta.Y) <= 420
end

-- 是否已離開競技場 (用於判斷上一輪 BOSS 是否結束)
function Halloween.PumpkinBoss.Outside(arena)
    arena = arena or Halloween.PumpkinBoss.Arena()
    local center, root = arena and arena:GetAttribute("ArenaCenter"), GetHRP()
    if not arena or typeof(center) ~= "Vector3" or not root then return false end
    local delta = root.Position - center
    return Vector3.new(delta.X, 0, delta.Z).Magnitude > 360 or math.abs(delta.Y) > 420
end

function Halloween.PumpkinBoss.Tagged(tag, name)
    for _, object in ipairs(CollectionService:GetTagged(tag)) do
        if object:IsDescendantOf(Workspace) then return object end
    end
    return name and Workspace:FindFirstChild(name)
end

function Halloween.PumpkinBoss.Ready(info)
    if type(info) ~= "table" or not info.Open then return false end
    if info.Active then return true end
    if info.Busy or type(info.Costs) ~= "table" then return false end
    local count = 0
    for _, cost in pairs(info.Costs) do
        if type(cost) ~= "table" or not tonumber(cost.Have) or not tonumber(cost.Amount) or tonumber(cost.Have) < tonumber(cost.Amount) then return false end
        count = count + 1
    end
    return count > 0
end

function Halloween.PumpkinBoss.Loot(arena)
    local center, root = arena:GetAttribute("ArenaCenter"), GetHRP()
    if typeof(center) ~= "Vector3" or not root then return nil, 0 end
    local nearest, distance, count = nil, math.huge, 0
    for _, folder in ipairs(CollectionService:GetTagged("HalloweenCandySpill")) do
        local owner, origin = folder:GetAttribute("SpillOwner"), folder:GetAttribute("SpillOrigin")
        if folder:IsDescendantOf(Workspace) and (owner == nil or owner == LocalPlayer.UserId)
            and typeof(origin) == "Vector3" and (origin - center).Magnitude <= 700 then
            for name, position in pairs(folder:GetAttributes()) do
                local id = name:match("^Candy_(%d+)$") or name:match("^Chest_.+_(%d+)$")
                if id and typeof(position) == "Vector3" then
                    count = count + 1
                    local dist = (root.Position - position).Magnitude
                    if dist < distance then
                        nearest, distance = { Folder = folder, Attribute = name, Id = tonumber(id), Position = position }, dist
                    end
                end
            end
        end
    end
    return nearest, count
end

function Halloween.PumpkinBoss.Collect(arena, active)
    local item, count = Halloween.PumpkinBoss.Loot(arena)
    if not item then return count end
    local function cancelled()
        return not active() or not item.Folder.Parent or item.Folder:GetAttribute(item.Attribute) == nil
    end
    _tp(CFrame.new(item.Position + Vector3.new(0, 2, 0)), cancelled)
    ReleaseHover()
    local root = GetHRP()
    if not cancelled() and root then
        local delta = root.Position - item.Position
        if Vector3.new(delta.X, 0, delta.Z).Magnitude <= 7 and math.abs(delta.Y) <= 14 then
            HalloweenEventRemote:FireServer("CandySpillClaim", item.Folder.Name, item.Id)
            local deadline = tick() + 1
            while not cancelled() and tick() < deadline do task.wait(0.1) end
        end
    end
    return count
end

function Halloween.PumpkinBoss.Leave(active)
    local state = Halloween.PumpkinBoss
    local arena = state.Arena()
    if not arena or not state.Inside(arena) then return true end
    -- 上一輪已結束且仍留在競技場：走出場地後才能重新召喚
    local opened = arena:GetAttribute("PortalOpen") == true
    local core
    if opened then
        local portal = arena:FindFirstChild("ExitPortal")
        core = portal and portal:FindFirstChild("Core")
    end
    if not (core and core:IsA("BasePart")) then
        -- 沒有可用出口時直接傳送到鍋台，讓伺服器把玩家移出競技場
        local cauldron = state.Tagged("DapperJackCauldron")
        if cauldron then
            _tp(cauldron:GetPivot() + Vector3.new(0, 3, 5), function() return not active() or state.Outside(arena) end)
            ReleaseHover()
        end
    else
        _tp(core.CFrame, function() return not active() or state.Outside(arena) end)
        ReleaseHover()
        local root = GetHRP()
        if active() and root and state.Inside(arena) and (root.Position - core.Position).Magnitude < 10 and firetouchinterest then
            pcall(function() firetouchinterest(root, core, 0); firetouchinterest(root, core, 1) end)
        end
    end
    local deadline = tick() + 8
    while active() and tick() < deadline do
        if state.Outside(arena) then return true end
        task.wait(0.2)
    end
    return state.Outside(arena)
end

function Halloween.PumpkinBoss.Enter(active)
    local state = Halloween.PumpkinBoss
    local arena = state.Arena()
    if state.Inside(arena) then
        -- 上一輪已打完 (場地已清空) 時先離開，讓同一個伺服器可以再次召喚
        if arena and arena:GetAttribute("ArenaState") == "Cleared" then
            if not state.Leave(active) then return false end
        else
            return true
        end
    end
    local cauldron = state.Tagged("DapperJackCauldron")
    if not cauldron then return false end
    if not ForceUnseat(3, active) then return false end
    _tp(cauldron:GetPivot() + Vector3.new(0, 3, 5), function() return not active() end)
    if not active() then return false end
    local remote = RS.Remotes:FindFirstChild("DapperJackRitual")
    if not remote then return false end
    local info = remote:InvokeServer("Status")
    state.StatusCache, state.StatusAt = nil, 0
    if type(info) ~= "table" or not info.Open then return false end
    if not info.Active then
        if info.Busy then return false end
        if not state.Ready(info) then return false end
        local result = remote:InvokeServer("Summon")
        if result ~= "Started" and result ~= "Active" and result ~= "Busy" then
            return false
        end
    end
    local deadline, enteredAt = tick() + 45, 0
    while active() and tick() < deadline do
        if state.Inside() then return true end
        local gateway = state.Tagged("DapperJackGateway", "DapperJackGateway")
        local prompt = gateway and gateway:FindFirstChildWhichIsA("ProximityPrompt", true)
        local part = gateway and (gateway:FindFirstChild("Part") or gateway:FindFirstChildWhichIsA("BasePart", true))
        if part and tick() - enteredAt >= 5 then
            _tp(part.CFrame, function() return not active() or state.Inside() or not gateway.Parent end)
            ReleaseHover()
            local root = GetHRP()
            if active() and root and gateway.Parent and (root.Position - part.Position).Magnitude <= 10 then
                enteredAt = tick()
                if prompt and prompt.Enabled and fireproximityprompt then pcall(fireproximityprompt, prompt) end
                if not state.Inside() then HalloweenEventRemote:FireServer("DapperJackArenaEnter") end
            end
        end
        task.wait(0.25)
    end
    return false
end

function Halloween.PumpkinBoss.Round(active)
    local state, clearedAt, quietAt, cardAt = Halloween.PumpkinBoss, nil, nil, nil
    local deadline, character = tick() + 900, LocalPlayer.Character
    while active() and tick() < deadline do
        local arena = state.Arena()
        local hum = GetHumanoid()
        if not hum or hum.Health <= 0 or LocalPlayer.Character ~= character then return end
        if not state.Inside(arena) then return end
        if arena:GetAttribute("ArenaState") == "Cleared" then
            clearedAt = clearedAt or tick()
            local pending = state.Collect(arena, active)
            if pending > 0 then quietAt = nil
            else
                quietAt = quietAt or tick()
                if not cardAt then
                    HalloweenEventRemote:FireServer("DapperJackCardClaim")
                    cardAt = tick()
                end
                if tick() - quietAt >= 5 and tick() - clearedAt >= 8 and arena:GetAttribute("PortalOpen") == true then
                    local portal = arena:FindFirstChild("ExitPortal")
                    local core = portal and portal:FindFirstChild("Core")
                    if core and core:IsA("BasePart") then
                        _tp(core.CFrame, function() return not active() or not state.Inside(arena) end)
                        ReleaseHover()
                        local root = GetHRP()
                        if active() and root and state.Inside(arena) and (root.Position - core.Position).Magnitude < 10 and firetouchinterest then
                            pcall(function() firetouchinterest(root, core, 0); firetouchinterest(root, core, 1) end)
                        end
                        task.wait(2)
                    end
                end
            end
        else
            local boss = Workspace:FindFirstChild("Dapper Jack", true)
            if boss and Attack.Alive(boss) then
                Halloween.Target, Halloween.FloorY = boss, arena:GetAttribute("ArenaCenter").Y
                KillLoop(boss, function() return active() and state.Inside(arena) end,
                    function() return arena:GetAttribute("ArenaState") == "Cleared" end, false, true)
                Halloween.Target, Halloween.FloorY = nil, nil
            end
        end
        task.wait(0.25)
    end
end

function Halloween.PumpkinBoss.Run()
    local state = Halloween.PumpkinBoss
    if not _G.AutoPumpkinBoss or state.Busy or Halloween.Knocking or Halloween.BossEntered or HopPending then return end
    -- 整點活動期間不搶占，待 XX:00~XX:10 結束後重新判斷
    if Halloween.EventOwns() then return end
    if not Halloween.BossGate() then return end
    local sched = Halloween.Scheduler
    if tick() < state.NextCheck then return end
    -- 召喚材料足夠：通知南瓜刷取讓出執行權
    sched.BossPending = true
    if Halloween.PumpkinBusy then
        -- 等南瓜刷取停下再召喚，超時才強制中斷，避免流程互相干擾
        if sched.BossConflictAt == 0 then sched.BossConflictAt = tick() + 3 end
        if tick() < sched.BossConflictAt then return end
    end
    state.Busy, state.NextCheck = true, tick() + 10
    local function active() return _G.AutoPumpkinBoss == true end
    local ok, err = pcall(function()
        if not active() or Halloween.Knocking or Halloween.EventOwns() then return end
        HopCancelPending()
        StopTween(); ClearBringJobs(); ReleaseHover()
        task.wait(0.5)
        if not active() then return end
        if state.Enter(active) then state.Round(active) end
    end)
    Halloween.Target, Halloween.FloorY = nil, nil
    state.Busy = false
    state.StatusCache, state.StatusAt = nil, 0
    -- BOSS 完成後恢復：解除搶占，南瓜刷取重新判斷時間 / 伺服器狀態 / 自動換服元件
    sched.BossPending, sched.BossConflictAt = false, 0
    Halloween.RareHoldUntil, Halloween.RareMissingAt = 0, nil
    if not ok then warn("[Pumpkin Boss] " .. tostring(err)) end
end

function Halloween.PumpkinBoss.Status()
    local state = Halloween.PumpkinBoss
    local cached = state.StatusCache
    if cached and tick() - (state.StatusAt or 0) < 0.5 then return cached end
    local remote = RS.Remotes:FindFirstChild("DapperJackRitual")
    if not remote then return nil end
    local ok, info = pcall(function() return remote:InvokeServer("Status") end)
    if not ok or type(info) ~= "table" then return nil end
    state.StatusCache, state.StatusAt = info, tick()
    return info
end

Halloween.PumpkinBoss.Init = true

task.spawn(function()
    while task.wait(1) do
        pcall(Halloween.BossGate)
        pcall(Halloween.PumpkinBoss.Run)
    end
end)

