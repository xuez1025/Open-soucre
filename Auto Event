    local inWindow = Halloween.InWindow()
    for _, mob in ipairs(enemies:GetChildren()) do
        local root = mob:IsA("Model") and mob:FindFirstChild("HumanoidRootPart")
        if root and mob:FindFirstChild("Humanoid") and Attack.Alive(mob) and Halloween.SameArea(root) then
            local owner = mob:GetAttribute("LocalEnemy")
            local owned = owner == nil or owner == LocalPlayer.Name or owner == LocalPlayer.UserId
            if owned and Halloween.HuntAnywhere(mob.Name) then
                local own = GetHRP()
                local inside = Halloween.BossEntered and (not bossEntry or Halloween.BossDoor == bossEntry.Door)
                if bossEntry and own and (own.Position - bossEntry.CFrame.Position).Magnitude > 500
                    and (root.Position - own.Position).Magnitude < 500 then
                    Halloween.BossDoor, Halloween.BossEntered = bossEntry.Door, true
                    inside = true
                end
                if not bossEntry or inside then Halloween.FloorY = nil; return mob end
            end
            local near, floor = Halloween.NearDoor(root.Position)
            if owned and inWindow and table.find(Halloween.Enemies, mob.Name) and near and root.Position.Y >= floor - 12 then
                Halloween.FloorY = floor
                return mob
            end
        end
    end
    return nil
end

