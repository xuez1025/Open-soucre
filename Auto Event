function Halloween.CraftPotion(recipe, quantity)
    quantity = tonumber(quantity or 1)
    if Halloween.PotionBusy then return end
    if not table.find(Halloween.PotionRecipes, recipe) or not quantity or quantity % 1 ~= 0 or quantity < 1 or quantity > 99 then
        Notify("女巫藥水", "請選擇藥水並輸入 1 到 99 的整數", 4)
        return
    end
    local readIdentity, writeIdentity = getthreadidentity or getidentity, setthreadidentity or setidentity
    if type(readIdentity) ~= "function" or type(writeIdentity) ~= "function" then
        Notify("女巫藥水", "執行器不支援身分識別 API", 4)
        return
    end
    Halloween.PotionBusy = true
    task.spawn(function()
        local identity, crafted = nil, 0
        local ok, result = pcall(function()
            identity = readIdentity()
            if type(identity) ~= "number" then error("Cannot read thread identity.") end
            writeIdentity(2)
            local remote = require(Net):RemoteFunction("Craft")
            for i = 1, quantity do
                local response = remote:InvokeServer("Craft", recipe, 1, {})
                if type(response) ~= "table" then error(tostring(response), 0) end
                crafted = crafted + 1
                if i < quantity then task.wait(0.15) end
            end
        end)
        if type(identity) == "number" then
            local restored, err = pcall(writeIdentity, identity)
            if not restored then warn("[女巫藥水] Identity restore failed: " .. tostring(err)) end
        end
        Halloween.PotionBusy = false
        Notify("女巫藥水", "已製作 " .. crafted .. "/" .. quantity .. ": " .. recipe .. (ok and "" or (" | " .. tostring(result))), 4)
    end)
end

