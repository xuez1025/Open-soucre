function FindNearestEnemy(pred, folders, requireRoot)
    local hrp = GetHRP()
    if not hrp then return nil end
    local myPos = hrp.Position
    local best, bestDist
    for _, folder in ipairs(folders or { Workspace:FindFirstChild("Enemies") }) do
        if folder then
            for _, v in ipairs(folder:GetChildren()) do
                local hum = v:FindFirstChildOfClass("Humanoid")
                if hum and Attack.Alive(v) and (not pred or pred(v)) then
                    local root = v:FindFirstChild("HumanoidRootPart")
                    if not root and folder.Name == "SeaBeasts" then root = v.PrimaryPart end
                    if not requireRoot or root then
                        local d = root and (root.Position - myPos).Magnitude or math.huge
                        if not bestDist or d < bestDist then
                            bestDist, best = d, v
                        end
                    end
                end
            end
        end
    end
    return best
end

function FindEnemy(names)
    local predicate = (type(names) == "string") and function(mob) return mob.Name == names end
        or function(mob) return names[mob.Name] == true end
    return FindNearestEnemy(predicate)
end

function KillLoop(mob, isActive, shouldStop, sameName, priority)
    local function hover()
        if not mob.Parent or not Attack.Alive(mob) then return nil end
        return GetHoverCFrame(mob)
    end

    local noBring = IsNoBringMob(mob)
    if noBring then
        BringBlocked = true
        ClearBringJobs()
    else
        BringBlocked = false
    end
    if _G.BringMobs and not noBring then
        task.spawn(function()
            while isActive() and mob.Parent and Attack.Alive(mob) do
                pcall(BringEnemy, mob, sameName)
                task.wait(0.3)
            end
        end)
    end
    repeat
        task.wait()
        if not isActive() then break end
        _tp(hover, function()
            return not isActive() or not mob.Parent or not Attack.Alive(mob) or (shouldStop and shouldStop())
        end)
        if not isActive() then break end
        Attack.Kill(mob, true, sameName)
    until not isActive() or not mob.Parent or not Attack.Alive(mob) or (shouldStop and shouldStop())
    if noBring then BringBlocked = false end
    if not isActive() then ReleaseHover() end
end

