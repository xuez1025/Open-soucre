                    Title = "支援錯誤",
                    Content = "你目前的注入器不支援",
                    Duration = 3
                })
            end
        else
            if queue_on_teleport and isfile("AutoEvent.file") then
                delfile("AutoEvent.file")
            end
            WindUI:Notify({
                Title = "通知",
                Content = "已關閉自動執行",
                Duration = 3
            })
        end
    end
})

Tabs.Settings:Toggle({ 
    Title    = "Anti AFK", 
    Desc     = "防止閒置被踢出", 
    Value    = _G.AntiAFK_ENABLED,
    Callback = function(v) 
        _G.AntiAFK_ENABLED = v
        if _G.AntiAFK_ENABLED then 
            EnableAntiAFK() 
        else 
            DisableAntiAFK() 
        end 
    end
})

Tabs.Settings:Keybind({ 
    Title = "快捷鍵", 
    Desc = "可更改", 
    Value = _G.CurrentKey,
    Callback = function(v)
        _G.CurrentKey = v
        
        if not _G.KeyDisabled then
            Window:SetToggleKey(Enum.KeyCode[v])
        end
    end
})

Tabs.Settings:Toggle({
    Title = "停用快捷鍵",
    Desc = "開啟後將禁用快捷鍵",
    Value = _G.KeyDisabled,
    Callback = function(state)
        _G.KeyDisabled = state
        
        if state then
            Window:SetToggleKey(nil)
        else
            Window:SetToggleKey(Enum.KeyCode[_G.CurrentKey])
        end
    end
})

