function Halloween.PumpkinStep()
    if not Halloween.PumpkinActive() then Halloween.RareMissingAt = nil; return end
    local hrp = GetHRP()
    if not hrp then Halloween.RareMissingAt = nil; return end
    local pumpkin, rarePresent, scanReady = Halloween.NearestPumpkin(hrp.Position)
    local rareHop = _G.AutoRarePumpkin and _G.AutoRarePumpkinHop
    -- 情況 A：開啟自動換服時只找稀有南瓜，普通南瓜不另外刷取
    -- 情況 B：未開啟自動換服時，有稀有南瓜優先稀有，否則改刷普通南瓜
    if rareHop and not rarePresent then
        pumpkin = nil
    elseif rarePresent and pumpkin and pumpkin:GetAttribute("PumpkinRare") ~= true then
        pumpkin = Halloween.NearestRarePumpkin(hrp.Position) or pumpkin
    end
    local jack = Halloween.NearbyJack(hrp.Position)
    local snowman = jack and jack.Name == Halloween.SnowmanName
    if _G.AutoRarePumpkin and _G.AutoRarePumpkinHop and not rarePresent and not snowman
        and scanReady and tick() >= Halloween.RareHoldUntil then
        if not Halloween.RareMissingAt then
            Halloween.RareMissingAt = tick()
            Notify("萬聖節活動", "未發現稀有南瓜，3 秒後換服", 3)
        elseif tick() - Halloween.RareMissingAt >= 3 then
            Halloween.RareMissingAt = nil
            Halloween.RareHoldUntil = tick() + 15
            HopServer(true, true, true)
        end
        return
    end
    Halloween.RareMissingAt = nil
    if jack and (snowman or not (pumpkin and pumpkin:GetAttribute("PumpkinRare") == true)) then
        if snowman then Halloween.RareHoldUntil = tick() + 15 end
        Halloween.PumpkinTarget = jack
        local ok, err = pcall(KillLoop, jack, Halloween.PumpkinActive)
        Halloween.PumpkinTarget = nil
        if snowman then Halloween.RareHoldUntil = tick() + 5 end
        if not ok then error(err, 0) end
        return
    end
    if not pumpkin then return end
    local rare = pumpkin:GetAttribute("PumpkinRare") == true
    if rare then Halloween.RareHoldUntil = tick() + 15 end
    local root = pumpkin.RootPart
    if (root.Position - hrp.Position).Magnitude > 8 then
        _tp(CFrame.new(root.Position + Vector3.new(0, 4, 3)), function() return not Halloween.PumpkinActive() end)
    end
    if not Halloween.PumpkinActive() then return end
    Halloween.EquipMelee()
    if Halloween.HitPumpkin(pumpkin) then
        if rare then Halloween.RareHoldUntil = tick() + 15 end
        task.wait(1.5)
    else
        Halloween.RareFailures[pumpkin] = (Halloween.RareFailures[pumpkin] or 0) + 1
        local exhausted = Halloween.RareFailures[pumpkin] >= 3
        Halloween.PumpkinSkip[pumpkin] = os.clock() + (exhausted and 120 or 20)
        if rare then Halloween.RareHoldUntil = tick() + (exhausted and 5 or 22) end
    end
end

