local HopTeleportStarted = false
local HopPending = false
local HopPendingToken = 0
local HopLastJob = nil

function HopCancelPending(reason)
    if not HopPending then return false end
    HopPendingToken = HopPendingToken + 1
    HopPending = false
    getgenv().IsServerHopping = false
    Notify("換服", reason or "已取消換服", 3)
    return true
end

function FetchServerList()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
        .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and type(res) == "table" and type(res.data) == "table" then
        return res.data
    end
    return nil
end

function PickServer(servers, random)
    if random then
        local shuffled = {}
        for i, server in ipairs(servers) do shuffled[i] = server end
        for i = #shuffled, 2, -1 do
            local j = math.random(i)
            shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
        end
        servers = shuffled
    end
    local function scan(minPlayers)
        for _, s in ipairs(servers) do
            local id = s.id and tostring(s.id)
            local playing = tonumber(s.playing) or 0
            local maxPlayers = tonumber(s.maxPlayers) or 12
            if id and id ~= game.JobId and id ~= HopLastJob
                and playing >= minPlayers and playing < maxPlayers then
                return id
            end
        end
        return nil
    end
    return scan(random and 0 or (tonumber(_G.HopMinPlayers) or 7)) or scan(2)
end

