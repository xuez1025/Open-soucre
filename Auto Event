function Halloween.CellKey(cell)
    local parts = {}
    for k, v in pairs(cell) do
        if k ~= "State" then parts[#parts + 1] = tostring(k) .. "=" .. tostring(v) end
    end
    table.sort(parts)
    return table.concat(parts, ";")
end

function Halloween.FlipCard(matching, index)
    if not Halloween.Auto() then return nil end
    local before = matching:GetBoard()
    local flips = before and before.FlipCount or -1
    local root = LocalPlayer.PlayerGui:FindFirstChild("ConcentrationGameRoot")
    local container = root and root:FindFirstChild("Container", true)
    local card = container and container:FindFirstChild("Card" .. index)
    local button = card and card:FindFirstChild("Card")
    if not button then return nil end
    Halloween.ClickButton(button)
    local deadline = os.clock() + 4
    while os.clock() < deadline and matching:IsOpen() and Halloween.Auto() do
        local board = matching:GetBoard()
        if board and board ~= before and board.FlipCount ~= flips then return board end
        task.wait(0.05)
    end
    return matching:GetBoard()
end

function Halloween.SolveMatching(matching)
    if Halloween.Solving then
        while Halloween.Solving and matching:IsOpen() do task.wait(0.2) end
        return
    end
    Halloween.Solving = true
    local ok, err = pcall(Halloween.SolveBoard, matching)
    Halloween.Solving = false
    if not ok then warn("Halloween Matching Error:", err) end
end

function Halloween.SolveBoard(matching)
    local known = {}
    local function learn(board, index)
        local cell = board and board.Cells[index]
        if cell and cell.State ~= "Hidden" then known[index] = Halloween.CellKey(cell) end
    end
    for _ = 1, 25 do
        if not matching:IsOpen() or not Halloween.Auto() then return end
        local board = matching:GetBoard()
        if not board then return end
        local open = {}
        for i, cell in ipairs(board.Cells) do
            if cell.State ~= "Matched" then open[#open + 1] = i end
        end
        if #open == 0 then return end
        local first, second
        for x = 1, #open do
            for y = x + 1, #open do
                local i, j = open[x], open[y]
                if known[i] and known[i] == known[j] then first, second = i, j end
            end
        end
        if first then
            Halloween.FlipCard(matching, first)
            Halloween.FlipCard(matching, second)
        else
            for _, i in ipairs(open) do
                if not known[i] then first = i break end
            end
            if not first then return end
            learn(Halloween.FlipCard(matching, first), first)
            for _, i in ipairs(open) do
                if i ~= first and known[i] and known[i] == known[first] then second = i break end
            end
            if not second then
                for _, i in ipairs(open) do
                    if i ~= first and not known[i] then second = i break end
                end
            end
            if not second then return end
            local after = Halloween.FlipCard(matching, second)
            learn(after, second)
            if not (after and after.Cells[second] and known[second] == known[first]) then task.wait(2.3) end
        end
        task.wait(0.3)
    end
end

