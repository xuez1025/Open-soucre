function Halloween.DoorEntries()
    local now = os.clock()
    if Halloween.EntryCache and now - Halloween.EntryAt < 30 then return Halloween.EntryCache end
    local list = {}
    for _, d in ipairs(Workspace:GetDescendants()) do
        if d.Name == "HalloweenDoor" and d:IsA("Model") then
            local prox = d:FindFirstChild("Proximity")
            local prompt = prox and prox:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                list[#list + 1] = { Door = d, Prompt = prompt, CFrame = CFrame.new(prox.Position) }
            end
        end
    end
    if #list == 0 then
        for _, cf in ipairs(Halloween.Doors()) do list[#list + 1] = { CFrame = cf } end
    end
    Halloween.EntryCache, Halloween.EntryAt = list, now
    return list
end

function Halloween.NearestPrompt(position)
    local nearest, dist = nil, 10
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local parent = v.Parent
            local root = parent and (parent:FindFirstChild("HumanoidRootPart") or parent:FindFirstChild("Head") or parent:FindFirstChild("Torso") or parent)
            local ok, pos = pcall(function() return root.Position end)
            if ok and typeof(pos) == "Vector3" then
                local d = (pos - position).Magnitude
                if d < dist then
                    dist = d
                    nearest = v
                end
            end
        end
    end
    return nearest
end

