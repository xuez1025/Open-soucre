            end)
            if AttackObfuscatedRemote and AttackObfuscatedId then
                pcall(function()
                    local salt = math.floor(Workspace:GetServerTimeNow() / 10 % 10) + 1
                    local name = string.gsub("RE/RegisterHit", ".", function(c) return string.char(bit32.bxor(string.byte(c), salt)) end)
                    local id = bit32.bxor(AttackObfuscatedId + 909090, Attack_GetSeed() * 2)
                    Attack_Clone(AttackObfuscatedRemote):FireServer(name, id, root, { { pumpkin, root } })
                end)
