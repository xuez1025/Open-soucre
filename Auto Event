local HopDelay = 5

function HopCountdownLabel(seconds)
    return "換服倒數: " .. tostring(seconds or HopDelay) .. " 秒"
end

function HopToJob(jobId, message, delay, watchdog)
    if type(jobId) ~= "string" or jobId == "" then return false end
    if HopPending then return false end
    local waitTime = tonumber(delay) or HopDelay
    HopPendingToken = HopPendingToken + 1
    local token = HopPendingToken
    HopPending = true
    HopTeleportStarted = false
    HopLastJob = jobId
    getgenv().IsServerHopping = true
    getgenv().ServerHopAt = tick()
    local suffix = ""
    if waitTime > 0 then suffix = " · " .. HopCountdownLabel(waitTime) end
    Notify("換服", (message or ("換服中 " .. jobId:sub(1, 8))) .. suffix, math.max(1, waitTime))
    task.spawn(function()
        local deadline = tick() + waitTime
        while true do
            if HopPendingToken ~= token or getgenv().IsServerHopping == false then
                HopPending = false
                return
            end
            local left = deadline - tick()
            if left <= 0 then break end
            task.wait(math.min(left, 0.25))
        end
        HopPending = false
        if HopPendingToken ~= token then return end
        HopQueueAutoExec()
        local ok = pcall(function()
            local remote = RS:FindFirstChild("__ServerBrowser") or RS:WaitForChild("__ServerBrowser", 3)
            if remote then
                remote:InvokeServer("teleport", jobId)
            else
                TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
            end
        end)
        if not ok then
            getgenv().IsServerHopping = false
            Notify("換服", "換服傳送失敗", 4)
        end
    end)
    return true
end

function HopServer(force, immediate, random)
    if not force then
        getgenv().IsServerHopping = false
        return
    end
    local now = tick()
    if getgenv().IsServerHopping and getgenv().ServerHopAt and (now - getgenv().ServerHopAt) > 45 then
        getgenv().IsServerHopping = false
    end
    if getgenv().IsServerHopping then return end
    getgenv().IsServerHopping = true
    getgenv().ServerHopAt = now
    local servers = FetchServerList()
    if not servers then
        getgenv().IsServerHopping = false
        Notify("換服", "未取到伺服器列表", 3)
        return
    end
    local target = PickServer(servers, random)
    if not target then
        target = PickServer(servers, random)
    end
    if not target then
        getgenv().IsServerHopping = false
        Notify("換服", "沒有找到可用的伺服器", 5)
        return
    end
    return HopToJob(target, "換服中 " .. target, immediate and 0 or HopDelay, immediate == true)
end

