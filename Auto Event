    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = state end
end

local function resetCharPhysics()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Velocity = Vector3.zero
        end
    end
end

local function globalStopTween()
    _G.isMovementActive = false
    _G.isTeleporting = false
    _G.SetNoclipState(false)

    if _G.ActiveTween then
        _G.ActiveTween:Cancel()
        _G.ActiveTween = nil
    end

    local char = LocalPlayer.Character
    if char then
        local HRP = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if HRP then
            HRP.AssemblyLinearVelocity = Vector3.zero
            HRP.AssemblyAngularVelocity = Vector3.zero
            local bodyClip = HRP:FindFirstChild("BodyClip")
            if bodyClip then bodyClip:Destroy() end
        end

        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end

        setPlatformStand(false)
        resetCharPhysics()
    end
end

local function globalTweenTo(targetCFrame, callback)
    local char = LocalPlayer.Character
    local HRP = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid") or char and char:FindFirstChildOfClass("Humanoid")
    if not HRP or not hum then return end

    if os.clock() >= _G.Fruit_TeleportPauseUntil then
        local bestEntrance = GetBestEntrance(HRP.Position, targetCFrame.Position)
        if bestEntrance then
            local teleported = TryTeleportEntrance(bestEntrance, HRP)
            if teleported then
                task.wait(1.2)
                char = LocalPlayer.Character
                HRP = char and char:FindFirstChild("HumanoidRootPart")
                hum = char and char:FindFirstChildOfClass("Humanoid")
                if not HRP or not hum then return end
            end
        end
    else
        local waitTime = _G.Fruit_TeleportPauseUntil - os.clock()
        if waitTime > 0 then task.wait(waitTime) end
        char = LocalPlayer.Character
        HRP = char and char:FindFirstChild("HumanoidRootPart")
        hum = char and char:FindFirstChildOfClass("Humanoid")
        if not HRP or not hum then return end
    end

    local bodyClip = HRP:FindFirstChild("BodyClip")
    if not bodyClip then
        bodyClip = Instance.new("BodyVelocity")
        bodyClip.Name = "BodyClip"
        bodyClip.Parent = HRP
    end
    bodyClip.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyClip.Velocity = Vector3.zero

    HRP.AssemblyLinearVelocity = Vector3.zero
    HRP.AssemblyAngularVelocity = Vector3.zero
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    setPlatformStand(true)

    local distance = (targetCFrame.Position - HRP.Position).Magnitude
    local speed = _G.FruitFlySpeed or 200

    if _G.ActiveTween then _G.ActiveTween:Cancel() end

    _G.isMovementActive = true
    _G.SetNoclipState(true)

    _G.ActiveTween = TweenService:Create(
        HRP,
        TweenInfo.new(distance / speed, Enum.EasingStyle.Linear),
        {CFrame = targetCFrame}
    )

    _G.ActiveTween:Play()

    local connection
    connection = _G.ActiveTween.Completed:Connect(function(playbackState)
        connection:Disconnect()
        if playbackState == Enum.PlaybackState.Completed then
            globalStopTween()
            if callback then callback() end
        end
    end)
end

local _isAutoChecking = false
local _isTargeting = false
local targetTrackConn = nil 
local unvisitedLocations = {}
local hoverHeight = 15
local ProcessNextLocation

local function CheckForMagnet()
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return false, nil end
    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        if enemy:FindFirstChild("MagnetModeProxy") and hum and hum.Health > 0 then
            return true, enemy
        end
    end
    return false, nil
end

local function GetAndRemoveClosestLocation()
    local char = LocalPlayer.Character
    local HRP = char and char:FindFirstChild("HumanoidRootPart")
    if not HRP or #unvisitedLocations == 0 then return nil end

    local currentPos = HRP.Position
    local closestIndex = 1
    local minDistance = math.huge

    for i, loc in ipairs(unvisitedLocations) do
        local dist = (loc.Pos.Position - currentPos).Magnitude
        if dist < minDistance then
            minDistance = dist
            closestIndex = i
        end
    end
    local closestLoc = unvisitedLocations[closestIndex]
    table.remove(unvisitedLocations, closestIndex)
    return closestLoc
end

local function EngageTarget(enemyObj, locationName)
    if _isTargeting then return end
    _isTargeting = true
    globalStopTween()

    local enemyName = enemyObj.Name
    SendNotify("🚨 發現目標!", "在 [" .. (locationName or "中途") .. "] 找到目標怪物 ["..enemyName.."]，啟動動態鎖定...", 5)
    local lastTweenTargetPos = nil

    local function cleanupAndNext()
        if targetTrackConn then 
            targetTrackConn:Disconnect() 
            targetTrackConn = nil 
        end
        globalStopTween()
        _isTargeting = false
        if not _isAutoChecking then return end
        SendNotify("目標已消滅", "[" .. enemyName .. "] 已死亡，繼續巡邏下一個座標點", 3)
        ProcessNextLocation()
    end

    targetTrackConn = RunService.Heartbeat:Connect(function()
        if not _isAutoChecking then
            cleanupAndNext()
            return
        end
        if not enemyObj or not enemyObj.Parent then
            cleanupAndNext()
            return
        end
        local hum = enemyObj:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            cleanupAndNext()
            return
        end
        local root = enemyObj:FindFirstChild("HumanoidRootPart") or enemyObj.PrimaryPart
        if root then
            local tpos = Vector3.new(root.Position.X, root.Position.Y + hoverHeight, root.Position.Z)
            local targetCFrame = CFrame.new(tpos)
            if not _G.isMovementActive or not lastTweenTargetPos or (lastTweenTargetPos - tpos).Magnitude > 2 then
                lastTweenTargetPos = tpos
                globalTweenTo(targetCFrame)
            end
        else
            cleanupAndNext()
        end
    end)
end

ProcessNextLocation = function()
    if not _isAutoChecking or _isTargeting then return end
    if #unvisitedLocations == 0 then
        SendNotify("巡邏完畢", "已歷遍所有座標，未發現 MagnetModeProxy，等待下個整點", 5)
        _isAutoChecking = false
        _isTargeting = false
        return
    end

    local currentLoc = GetAndRemoveClosestLocation()
    if not currentLoc then return end

    globalTweenTo(currentLoc.Pos, function()
        if not _isAutoChecking or _isTargeting then return end
        task.wait(2)
        if not _isAutoChecking or _isTargeting then return end
        local found, enemyObj = CheckForMagnet()
        if found and enemyObj then
            EngageTarget(enemyObj, currentLoc.Name)
        else
            ProcessNextLocation()
        end
    end)
end

local function StartPatrol()
    if #CheckLocations == 0 then
        SendNotify("錯誤", "無法辨識當前地圖，或地圖無預設座標。", 3)
        return
    end
    _isAutoChecking = true
    _isTargeting = false
    unvisitedLocations = {}
    for _, loc in ipairs(CheckLocations) do
        table.insert(unvisitedLocations, loc)
    end
    SendNotify("整點巡邏開始", "啟動 Magnet Proxy 全圖搜索", 3)
    
    task.spawn(function()
        while _isAutoChecking do
            task.wait(0.3)
            if _isAutoChecking and not _isTargeting then
                local found, enemyObj = CheckForMagnet()
                if found and enemyObj then
                    EngageTarget(enemyObj, "巡邏中途")
                end
            end
        end
    end)
    ProcessNextLocation()
end

local function StopPatrol()
    _isAutoChecking = false
    _isTargeting = false
    unvisitedLocations = {}
    if targetTrackConn then 
        targetTrackConn:Disconnect() 
        targetTrackConn = nil 
    end
    globalStopTween()
end

