        WindUI:Notify({ Title = title, Content = message, Duration = duration or 3 })
    end
end

function ReleaseHover()
    AttackTarget = nil
    HoldCFrame = nil
    LiveHoldGetter = nil
    NoClip(false)
end

function GetHRP()
    local char = LocalPlayer.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

function GetHumanoid()
    local char = LocalPlayer.Character
    if char then
        return char:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

function GetCharParts()
    local char = LocalPlayer.Character
    if char and char == cachedChar and cachedParts then
        return cachedParts
    end
    local parts = {}
    if char then
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                parts[#parts + 1] = v
            end
        end
    end
    cachedChar, cachedParts = char, parts
    return parts
end

function WatchCharParts(char)
    cachedChar, cachedParts = nil, nil
    if not char then return end
    char.DescendantAdded:Connect(function()
        cachedChar, cachedParts = nil, nil
    end)
    char.DescendantRemoving:Connect(function()
        cachedChar, cachedParts = nil, nil
    end)
end

function SendKey(key, hold)
    local code = Enum.KeyCode[key:upper()]
    if not code then return end
    VirtualInputManager:SendKeyEvent(true, code, false, game)
    task.wait(hold or 0.1)
    VirtualInputManager:SendKeyEvent(false, code, false, game)
end

function GetMobHealth(model)
    if not model or typeof(model) ~= "Instance" then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        local hp = tonumber(hum.Health)
        if hp then return hp end
    end
    local value = model:FindFirstChild("Humanoid")
    if value and value:IsA("ValueBase") then
        local hp = tonumber(value.Value)
        if hp then return hp end
    end
    return nil
end

function NoClip(v)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    for _, part in ipairs(GetCharParts()) do
        if part:IsA("BasePart") then
            if v then
                part.CanCollide = false
            elseif part.Name == "HumanoidRootPart" or part.Name:find("LowerTorso")
                or part.Name:find("UpperTorso") then
                part.CanCollide = true
            else
                part.CanCollide = false
            end
        end
    end
end

-- 小怪 Y 值上方(預設 15)
function GetHoverCFrame(model, height)
    local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
    if not root then return nil end
    local p = root.Position
    local hrp = GetHRP()
    local rot = hrp and (hrp.CFrame - hrp.CFrame.Position) or CFrame.new()
    local y = p.Y + (height or _G.HoverHeight or 15)
    if Halloween and Halloween.Target == model and Halloween.FloorY then y = math.max(y, Halloween.FloorY + 3) end
    return CFrame.new(p.X, y, p.Z) * rot
end

function GetTweenSpeed()
    return math.clamp(tonumber(_G.TweenSpeed) or 150, 150, 200)
end

function GetTweenPart()
    local part = Workspace:FindFirstChild(TWEEN_PART_NAME)
    if part and part:IsA("BasePart") then
        return part
    end
    part = Instance.new("Part")
    part.Name = TWEEN_PART_NAME
    part.Size = Vector3.new(1, 1, 1)
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Massless = true
    part.Transparency = 1
    part.Parent = Workspace
    return part
end

function StopTween()
    _G.RJRTweenStopped = true
    TweenStopToken = TweenStopToken + 1
    if ActiveTween then
        pcall(function() ActiveTween:Cancel() end)
        ActiveTween = nil
    end
    local char = LocalPlayer.Character
    local charRoot = char and char:FindFirstChild("HumanoidRootPart")
    if charRoot then
        local bodyClip = charRoot:FindFirstChild("BodyClip")
        if bodyClip then bodyClip:Destroy() end
    end
    local highlight = char and char:FindFirstChild("Highlight")
    if highlight then highlight:Destroy() end
    NoClip(false)
    task.defer(function()
        task.wait(0.1)
        _G.RJRTweenStopped = false
    end)
end

function TweenStandUp(hum)
    if not hum or (not hum.Sit and hum.SeatPart == nil) then return end
    pcall(function()
        hum.Sit = false
        hum.SeatPart = nil
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
end

function _tp(targetPos, abortCheck)
    if _G.RJRTweenStopped then return false end
    local startChar = LocalPlayer.Character
    local myHRP = GetHRP()
    if not myHRP then return false end
    local myToken = TweenStopToken
    local targetCFrame
    local liveTarget = nil
    if typeof(targetPos) == "function" then
        targetCFrame = targetPos()
        if not targetCFrame then return false end
        liveTarget = targetPos
    elseif typeof(targetPos) == "Vector3" then
        targetCFrame = CFrame.new(targetPos)
    elseif typeof(targetPos) == "CFrame" then
        targetCFrame = targetPos
    elseif typeof(targetPos) == "Instance" and targetPos:IsA("BasePart") then
        targetCFrame = targetPos.CFrame
    else
        return false
    end
    HoldCFrame = nil
    LiveHoldGetter = nil
    myHRP = GetHRP()
    if not myHRP then return false end
    NoClip(true)
    if not liveTarget then
        local flat = (Vector3.new(myHRP.Position.X, 0, myHRP.Position.Z)
            - Vector3.new(targetCFrame.Position.X, 0, targetCFrame.Position.Z)).Magnitude
        if flat <= TweenSnapDist and math.abs(myHRP.Position.Y - targetCFrame.Position.Y) <= 30 then
            if ActiveTween then
                pcall(function() ActiveTween:Cancel() end)
                ActiveTween = nil
            end
            myHRP.CFrame = targetCFrame
            myHRP.AssemblyLinearVelocity = Vector3.zero
            HoldCFrame = targetCFrame
            return true
        end
    end
    local part = GetTweenPart()
    part.CFrame = myHRP.CFrame
    local tweenSpeed = GetTweenSpeed()
    if ActiveTween then
        pcall(function() ActiveTween:Cancel() end)
    end
    local tween = { PlaybackState = Enum.PlaybackState.Playing }
    function tween:Cancel()
        if self.PlaybackState == Enum.PlaybackState.Playing then self.PlaybackState = Enum.PlaybackState.Cancelled end
    end
    ActiveTween = tween
    local targetRot = targetCFrame - targetCFrame.Position
    local aborted = false
    local arrived = false
    local lostTargetAt = nil
    local nextAbortAt = 0
    local lastSetPos = nil
    local pausedUntil = 0
    local deadline = tick() + math.max(8, (targetCFrame.Position - myHRP.Position).Magnitude / tweenSpeed + 8)
    local connection
    connection = RunService.Stepped:Connect(function(_, deltaTime)
        if tween.PlaybackState ~= Enum.PlaybackState.Playing then return end
        local dt = deltaTime or (1 / 60)
        local curChar = LocalPlayer.Character
        local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
        local currentHRP = GetHRP()
        if not currentHRP or curChar ~= startChar
            or not curHum or curHum.Health <= 0
            or TweenStopToken ~= myToken then
            aborted = true
            tween:Cancel()
            return
        end
        if curHum.Sit or curHum.SeatPart ~= nil then TweenStandUp(curHum) end
        if lastSetPos and (currentHRP.Position - lastSetPos).Magnitude > TweenPullbackDist then
            part.CFrame = currentHRP.CFrame
            pausedUntil = tick() + 0.25
            local goalPos = (liveTarget and liveTarget() or targetCFrame).Position
            deadline = tick() + (goalPos - currentHRP.Position).Magnitude / tweenSpeed + 8
        end
        local goal = targetCFrame
        if liveTarget then
            goal = liveTarget()
            if goal then
                lostTargetAt = nil
            elseif not lostTargetAt then
                lostTargetAt = tick()
            elseif tick() - lostTargetAt > 0.5 then
                aborted = true
                tween:Cancel()
                return
            end
        end
        if goal and tick() >= pausedUntil then
            local cur = part.Position
            local delta = goal.Position - cur
            local dist = delta.Magnitude
            local step = tweenSpeed * dt
            if dist <= step or (liveTarget and dist <= TweenSnapDist) then
                part.CFrame = goal
                arrived = true
                tween.PlaybackState = Enum.PlaybackState.Completed
            elseif liveTarget then
                part.CFrame = CFrame.new(cur + delta.Unit * step)
            else
                part.CFrame = CFrame.new(cur + delta.Unit * step) * targetRot
            end
        end
        currentHRP.CFrame = part.CFrame
        currentHRP.AssemblyLinearVelocity = Vector3.zero
        lastSetPos = part.Position
        local parts = GetCharParts()
        for i = 1, #parts do
            parts[i].CanCollide = false
        end
        if abortCheck and not aborted and not arrived then
            local now = tick()
            if now >= nextAbortAt then
                nextAbortAt = now + 0.1
                local ok, stop = pcall(abortCheck)
                if ok and stop then
                    aborted = true
                    tween:Cancel()
                end
            end
        end
    end)
    repeat
        task.wait()
    until arrived or aborted or tween.PlaybackState ~= Enum.PlaybackState.Playing
        or tick() > deadline or TweenStopToken ~= myToken
    connection:Disconnect()
    tween:Cancel()
    TweenStandUp(GetHumanoid())
    if ActiveTween == tween then ActiveTween = nil end
    if TweenStopToken ~= myToken then aborted = true end
    if aborted then
        HoldCFrame = nil
    elseif arrived then
        HoldCFrame = part.CFrame
        if liveTarget then LiveHoldGetter = liveTarget end
    end
    return not aborted
end

function HoverTo(cf, arriveDist)
    if not cf then return false end
    local hrp = GetHRP()
    if not hrp then return false end
    AttackTarget = nil
    LiveHoldGetter = nil
    if (hrp.Position - cf.Position).Magnitude > (arriveDist or 10) then
        if not _tp(cf) then return false end
        if not GetHRP() then return false end
    end
    AttackTarget = nil
    HoldCFrame = cf
    return true
end

