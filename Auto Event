local function Attack_BuildHitList(character, origin)
    local hitList = {}
    local folders = {
        Workspace:FindFirstChild("Enemies"),
        Workspace:FindFirstChild("Characters"),
        Workspace:FindFirstChild("SeaBeasts"),
    }
    for _, folder in ipairs(folders) do
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                if model ~= character then
                    local root = model:FindFirstChild("HumanoidRootPart")
                    if root then
                        local hp = GetMobHealth(model)
                        if hp and hp > 0 and (root.Position - origin).Magnitude <= 60 then
                            hitList[#hitList + 1] = { model, root }
                            if #hitList >= 12 then return hitList end
                        end
                    end
                end
            end
        end
    end
    return hitList
end

