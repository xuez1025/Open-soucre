function Halloween.BossGate()
    local state = Halloween.PumpkinBoss
    local canRun = _G.AutoPumpkinBoss == true
        and not Halloween.Paused()
        and not Halloween.Knocking
        and not Halloween.BossEntered
        and not Halloween.EnteringDoor
        and not HopPending
        and tick() >= (Halloween.BossWarpUntil or 0)
    if not canRun then state.GateReady = false; return false end
    local info = state.Status()
    local ready = state.Ready(info)
    -- 同一個伺服器重複召喚：上一輪已清空且人還留在競技場內時，視為可再次召喚
    if not ready then
        local arena = state.Arena()
        if arena and arena:GetAttribute("ArenaState") == "Cleared" and state.Inside(arena)
            and info and info.Open and not info.Busy then
            ready = true
        end
    end
    if ready then
        state.GateReady = true
        return not Halloween.EventOwns()
    end
    state.GateReady = false
    return false
end

