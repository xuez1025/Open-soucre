        BringJobs[mob] = nil
    end
end

function IsNoBringMob(model)
    local name = model and model.Name or ""
    return (Halloween and (Halloween.Target == model or Halloween.PumpkinTarget == model))
        or name == "Tyrant of the Skies" or name:find("Snowman", 1, true) ~= nil
end

function BringStart(mob)
    if BringJobs[mob] then return end
    local root = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local job = { Done = false, ExpireAt = tick() + 60 }
    BringJobs[mob] = job
    task.spawn(function()
        local bodyPos = root:FindFirstChild("BringBodyPos")
        if not bodyPos then
            bodyPos = Instance.new("BodyPosition")
            bodyPos.Name = "BringBodyPos"
            bodyPos.MaxForce = Vector3.new(1000000, 1000000, 1000000)
            bodyPos.P = 8000
            bodyPos.D = 600
            bodyPos.Position = root.Position
            bodyPos.Parent = root
        end
        local failCount = 0
        while _G.BringMobs and not job.Done and mob.Parent and root.Parent and hum.Health > 0
            and tick() < (job.ExpireAt or 0) do
            local targetCF = BringTargetCFrame
            if targetCF then
                for _, part in ipairs(mob:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                bodyPos.Position = targetCF.Position
                failCount = 0
            else
                failCount = failCount + 1
            end
            if failCount > 15 then break end
            task.wait(0.04)
        end
        job.Done = true
        if BringJobs[mob] == job then BringJobs[mob] = nil end
        pcall(function()
            if bodyPos and bodyPos.Parent then bodyPos:Destroy() end
            for _, part in ipairs(mob:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end)
    end)
end

function BringEnemy(Mon, sameName)
    if BringBlocked or not _G.BringMobs then return end
    local now = tick()
    if now - BringScanAt < 0.25 then return end
    BringScanAt = now
    local targetRoot = Mon:FindFirstChild("HumanoidRootPart") or Mon.PrimaryPart
    if not targetRoot or not Attack.Alive(Mon) then return end
    if now - BringSimAt > 3 then
        BringSimAt = now
        pcall(function()
            if sethiddenproperty then
                local sim = math.clamp(BringRange + 50, 100, 500)
                sethiddenproperty(LocalPlayer, "SimulationRadius", sim)
                sethiddenproperty(LocalPlayer, "MaxSimulationRadius", sim)
            end
        end)
    end
    BringAnchor = Mon
    BringTargetCFrame = targetRoot.CFrame
    BringStart(Mon)
    for mob, job in pairs(BringJobs) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
        if not mob.Parent or not hum or hum.Health <= 0 or not root then
            job.Done = true
            BringJobs[mob] = nil
        else
            job.ExpireAt = tick() + 60
        end
    end
    local active = 0
    for _ in pairs(BringJobs) do active = active + 1 end
    if active >= 8 then return end
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return end
    local targetPos = targetRoot.Position
    local newCount = 0
    for _, v in ipairs(enemies:GetChildren()) do
        if v ~= Mon and not BringJobs[v] and (not sameName or v.Name == Mon.Name) then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
            if hum and hum.Health > 0 and root
                and (root.Position - targetPos).Magnitude <= BringRange then
                BringStart(v)
                newCount = newCount + 1
                if newCount >= 4 then break end
            end
        end
    end
end

