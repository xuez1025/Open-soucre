function Halloween.NearestRarePumpkin(origin)
    local folder = Workspace:FindFirstChild("PumpkinHunt")
    if not folder then return nil end
    local now = os.clock()
    local nearest, best
    for _, pumpkin in ipairs(folder:GetChildren()) do
        if pumpkin:GetAttribute("PumpkinRare") == true then
            local root = pumpkin:FindFirstChild("RootPart")
            if root and pumpkin:GetAttribute("PumpkinState") == "Idle"
                and Halloween.PumpkinReachable(root.Position) and (Halloween.PumpkinSkip[pumpkin] or 0) < now then
                local dist = (root.Position - origin).Magnitude
                if not best or dist < best then nearest, best = pumpkin, dist end
            end
        end
    end
    return nearest
end

function Halloween.NearbyJack(origin)
    local nearest, best, bestRare
    for _, name in ipairs({ "Enemies", "PumpkinHunt" }) do
        local folder = Workspace:FindFirstChild(name)
        if folder then
            for _, mob in ipairs(folder:GetChildren()) do
                local rare = mob.Name == Halloween.SnowmanName
                local wanted = rare or (_G.AutoPumpkin and not (_G.AutoRarePumpkin and _G.AutoRarePumpkinHop) and mob.Name == Halloween.JackName)
                local root = wanted and mob:FindFirstChild("HumanoidRootPart")
                if root and Halloween.PumpkinReachable(root.Position) and Attack.Alive(mob) then
                    local dist = (root.Position - origin).Magnitude
                    if (rare and _G.AutoRarePumpkin or dist < 100)
                        and (not best or (rare and not bestRare) or (rare == bestRare and dist < best)) then
                        nearest, best, bestRare = mob, dist, rare
                    end
                end
            end
        end
    end
    return nearest
end

