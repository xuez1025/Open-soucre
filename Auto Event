function Halloween.OnBossEvent(command, door, plr, data)
    if command == "DoorOpened" and door and type(data) == "table"
        and (data.Boss == true or data.Event == "Boss Fight" or data.Event == "Hellfire Boss") then
        local part = door:FindFirstChild("Proximity") or door:FindFirstChild("Part")
        if part and part:IsA("BasePart") and not Halloween.BossEntered then
            Halloween.BossDoorEntry = { Door = door, CFrame = part.CFrame }
        end
    elseif command == "BossTeleportSound" or command == "HellfireTransition" then
        if Halloween.ExitingDoor then
            Halloween.ExitConfirmed = true
        elseif Halloween.EnteringDoor then
            Halloween.BossDoor, Halloween.BossEntered = Halloween.EnteringDoor, true
            Halloween.BossDead = false
        else return end
        Halloween.BossWarpUntil = tick() + 2
        StopTween(); ReleaseHover()
    elseif command == "HellfireBossDeath" and Halloween.BossEntered then
        Halloween.BossDead = true
        StopTween(); ReleaseHover()
    elseif command == "HellfireBossExit" and Halloween.BossEntered and type(door) == "table" then
        local exitDoor = door.Door
        if typeof(exitDoor) ~= "Instance" or not exitDoor:IsA("Model") or type(door.Lifetime) ~= "number" then return end
        Halloween.ExitDoor, Halloween.ExitConfirmed = exitDoor, false
        Halloween.ExitReadyAt, Halloween.ExitUntil = tick() + 1.6, tick() + door.Lifetime
        Halloween.BossDead = true
        StopTween(); ReleaseHover()
    elseif command == "EventFinished" and not Halloween.BossEntered then
        if Halloween.BossDoorEntry and Halloween.BossDoorEntry.Door == door then Halloween.BossDoorEntry = nil end
        if Halloween.BossDoor == door then Halloween.BossDoor = nil end
    end
end

Halloween.BossConnection = HalloweenEventRemote.OnClientEvent:Connect(Halloween.OnBossEvent)

function Halloween.ExitBoss()
    local door = Halloween.ExitDoor
    if not Halloween.Auto() or not door or not door.Parent or tick() < (Halloween.ExitReadyAt or 0)
        or tick() < (Halloween.ExitRetryAt or 0) then return end
    if tick() >= (Halloween.ExitUntil or 0) then
        Halloween.BossState = "exit portal expired"
        return
    end
    local part = door:FindFirstChild("Part")
    if not part or not part:IsA("BasePart") then return end
    Halloween.ExitRetryAt, Halloween.ExitingDoor = tick() + 3, door
    Halloween.BossState = "leaving boss room"
    local origin = part.Position
    local ok, err = pcall(function()
        _tp(part.CFrame * CFrame.new(0, 0, -0.5), function()
            return not Halloween.Auto() or Halloween.ExitConfirmed or not door.Parent
        end)
        ReleaseHover()
        local deadline = math.min(tick() + 4, Halloween.ExitUntil)
        while Halloween.Auto() and tick() < deadline do
            local root = GetHRP()
            if root and (root.Position - origin).Magnitude > 100 then Halloween.ExitConfirmed = true end
            if Halloween.ExitConfirmed then break end
            task.wait(0.1)
        end
    end)
    Halloween.ExitingDoor = nil
    if not ok then error(err, 0) end
    if Halloween.ExitConfirmed then
        Halloween.BossEntered, Halloween.BossDead, Halloween.BossDoor = false, false, nil
        Halloween.ExitDoor, Halloween.PendingDoor, Halloween.BossDoorEntry = nil, nil, nil
        Halloween.BossWarpUntil, Halloween.BossState = tick() + 2, "returned"
    end
end

function Halloween.EnterBoss(entry)
    local door = entry.Door
    if not Halloween.Auto() or (not Halloween.IsBossDoor(door) and not Halloween.BossEntered) then return end
    local part = door and door:FindFirstChild("Part")
    if not Halloween.BossEntered and (not part or not part:IsA("BasePart")) then return end
    Halloween.PendingDoor, Halloween.BossDoorEntry = entry, entry
    if not (Halloween.BossEntered and Halloween.BossDoor == door) then
        if tick() < (entry.BossRetryAt or 0) then return end
        entry.BossRetryAt, Halloween.EnteringDoor = tick() + 5, door
        Halloween.BossEntered, Halloween.BossState = false, "approaching boss entrance"
        local ok, err = pcall(function()
            _tp(part.CFrame * CFrame.new(0, 0, -0.5), function()
                return not Halloween.Auto() or not Halloween.IsBossDoor(door) or Halloween.BossEntered
            end)
            ReleaseHover()
            local deadline = tick() + 4
            while Halloween.Auto() and Halloween.IsBossDoor(door) and not Halloween.BossEntered and tick() < deadline do task.wait(0.1) end
        end)
        Halloween.EnteringDoor = nil
        if not ok then error(err, 0) end
    end
    if not (Halloween.BossEntered and Halloween.BossDoor == door) then return end
    local char = LocalPlayer.Character
    Halloween.BossState = "boss room"
    while Halloween.Auto() and Halloween.BossEntered do
        local hum, root = GetHumanoid(), GetHRP()
        if LocalPlayer.Character ~= char or not hum or hum.Health <= 0 then
            Halloween.BossEntered, Halloween.BossDoor, Halloween.ExitDoor = false, nil, nil
            break
        end
        if Halloween.ExitDoor then Halloween.ExitBoss()
        elseif tick() >= (Halloween.BossWarpUntil or 0) and not Halloween.IsBossDoor(door)
            and root and (root.Position - entry.CFrame.Position).Magnitude < 100 then
            Halloween.BossEntered, Halloween.BossDoor = false, nil
        end
        task.wait(0.2)
    end
    if Halloween.Paused() and not Halloween.BossDead then Halloween.BossEntered, Halloween.BossDoor = false, nil end
    if not Halloween.BossEntered and not Halloween.IsBossDoor(door) then
        Halloween.PendingDoor, Halloween.BossDoorEntry, Halloween.BossDead = nil, nil, false
    end
end

