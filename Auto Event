function Halloween.FindTarget()
    if Halloween.Paused() or Halloween.BossDead or tick() < (Halloween.BossWarpUntil or 0) then return nil end
    local bossEntry = Halloween.BossEntry()
    local enemies = Workspace:FindFirstChild("Enemies")
