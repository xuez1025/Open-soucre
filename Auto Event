function Halloween.HandleDoorEvent(door, state)
    local proximity = door:FindFirstChild("Proximity")
    local enemies = Workspace:FindFirstChild("Enemies")
    if proximity and proximity:IsA("BasePart") and enemies and not Halloween.DialogueVisible()
        and os.clock() - (state.RecallAt or -math.huge) >= 3 and (state.RecallCount or 0) < 3 then
        for _, mob in ipairs(enemies:GetChildren()) do
            local root = mob:FindFirstChild("HumanoidRootPart")
            if root and mob:GetAttribute("LocalEnemy") == LocalPlayer.Name and Attack.Alive(mob)
                and (root.Position - proximity.Position).Magnitude <= Halloween.DoorRange
                and root.Position.Y < proximity.Position.Y - 12 then
                state.RecallAt, state.RecallCount = os.clock(), (state.RecallCount or 0) + 1
                HalloweenEventRemote:FireServer("RecallDoorMobs", door)
                break
            end
        end
    end
    local matching = Halloween.MatchingGame()
    if matching then
        Halloween.SolveMatching(matching)
        return
    end
    local folder = RS:FindFirstChild(tostring(door:GetAttribute("EventId")))
    local sweetRide = folder and folder:FindFirstChild("SweetRide")
    if sweetRide and sweetRide:IsA("RemoteEvent") then
        local now = os.clock()
        if not state.FixAt then
            state.FixAt = now
            pcall(sweetRide.FireServer, sweetRide, "Fix")
        elseif now - state.FixAt >= 2.5 and now - (state.ReturnAt or 0) >= 1 then
            state.ReturnAt = now
            pcall(sweetRide.FireServer, sweetRide, "Returned")
        end
    end
end

