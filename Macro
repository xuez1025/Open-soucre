-- ── 步驟列表重建 ─────────────────────────────────────────
local function RebuildStepsList()
    for _, ch in pairs(StepsScroll:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end
    local total = #EditSteps
    if total == 0 then
        local f=Instance.new("Frame"); f.Size=UDim2.new(1,0,0,38)
        f.BackgroundTransparency=1; f.Parent=StepsScroll
        MkLbl(f,{text="尚無步驟 — 點下方按鈕手動加入，或按「開始錄製」自動生成",
            color=C.sub, size=SZ.fsS, xalign=Enum.TextXAlignment.Center,
            sz=UDim2.new(1,0,1,0)})
        return
    end

    for idx, step in ipairs(EditSteps) do
        local row=Instance.new("Frame")
        row.Size=UDim2.new(1,0,0,SZ.stepH)
        row.BackgroundColor3=C.bg3
        row.LayoutOrder=idx
        row.Parent=StepsScroll
        MkCorner(row,5); MkPad(row,0,0,6,4)

        -- 序號
        MkLbl(row,{text=string.format("%02d",idx),color=C.sub,size=11,
            sz=UDim2.new(0,20,1,0), xalign=Enum.TextXAlignment.Center})

        -- 類型標籤
        local tStr,tCol
        if step.type=="skill"  then tStr,tCol="技能",C.yellow
        elseif step.type=="switch" then tStr,tCol="切換",C.accent
        else tStr,tCol="等待",C.green end
        MkLbl(row,{text=tStr,color=tCol,size=SZ.fsS,font=Enum.Font.SourceSansBold,
            sz=UDim2.new(0,28,1,0),pos=UDim2.new(0,20,0,0)})

        local fx = 50

        -- ── 技能 ──
        if step.type=="skill" then
            MkLbl(row,{text="鍵",color=C.sub,size=11,sz=UDim2.new(0,12,1,0),pos=UDim2.new(0,fx,0,0)})
            local kIn=MkInput(row,{text=step.key or "Z",bg=C.bg2,size=SZ.fsXS,
                sz=UDim2.new(0,54,0,SZ.stepH-6),pos=UDim2.new(0,fx+14,0,3)})
            kIn.FocusLost:Connect(function()
                local k=kIn.Text:upper()
                if NameToKeyCode(k) then EditSteps[idx].key=k
                else kIn.Text=EditSteps[idx].key or "Z" end
            end)
            MkLbl(row,{text="持按ms",color=C.sub,size=11,sz=UDim2.new(0,38,1,0),pos=UDim2.new(0,fx+72,0,0)})
            local dIn=MkInput(row,{text=tostring(step.duration or 100),bg=C.bg2,size=SZ.fsXS,
                sz=UDim2.new(0,54,0,SZ.stepH-6),pos=UDim2.new(0,fx+112,0,3)})
            dIn.FocusLost:Connect(function()
                EditSteps[idx].duration=math.max(tonumber(dIn.Text) or 100,10)
                dIn.Text=tostring(EditSteps[idx].duration)
            end)

        -- ── 切換武器 ──
        elseif step.type=="switch" then
            MkLbl(row,{text="武器",color=C.sub,size=11,sz=UDim2.new(0,28,1,0),pos=UDim2.new(0,fx,0,0)})
            local wIn=MkInput(row,{text=step.weapon or "",placeholder="武器名稱",bg=C.bg2,size=SZ.fsXS,
                sz=UDim2.new(0,148,0,SZ.stepH-6),pos=UDim2.new(0,fx+30,0,3)})
            wIn.FocusLost:Connect(function() EditSteps[idx].weapon=wIn.Text end)

            MkLbl(row,{text="後ms",color=C.sub,size=11,sz=UDim2.new(0,28,1,0),pos=UDim2.new(0,fx+182,0,0)})
            local waIn=MkInput(row,{text=tostring(step.waitAfter or 0),bg=C.bg2,size=SZ.fsXS,
                sz=UDim2.new(0,46,0,SZ.stepH-6),pos=UDim2.new(0,fx+212,0,3)})
            waIn.FocusLost:Connect(function()
                EditSteps[idx].waitAfter=math.max(tonumber(waIn.Text) or 0,0)
                waIn.Text=tostring(EditSteps[idx].waitAfter)
            end)

        -- ── 等待 ──
        elseif step.type=="wait" then
            MkLbl(row,{text="延遲",color=C.sub,size=11,sz=UDim2.new(0,28,1,0),pos=UDim2.new(0,fx,0,0)})
            local mIn=MkInput(row,{text=tostring(step.ms or 100),bg=C.bg2,size=SZ.fsXS,
                sz=UDim2.new(0,72,0,SZ.stepH-6),pos=UDim2.new(0,fx+30,0,3)})
            mIn.FocusLost:Connect(function()
                EditSteps[idx].ms=math.max(tonumber(mIn.Text) or 100,10)
                mIn.Text=tostring(EditSteps[idx].ms)
            end)
            MkLbl(row,{text="ms",color=C.sub,size=11,sz=UDim2.new(0,24,1,0),pos=UDim2.new(0,fx+106,0,0)})
        end

        -- 右側控制：↑ ↓ ✕（根據位置隱藏多餘箭頭）
        local cW=26
        local delB=MkBtn(row,{text="✕",bg=C.bg2,color=C.red,size=SZ.fsS,
            sz=UDim2.new(0,cW,0,SZ.stepH-6), pos=UDim2.new(1,-(cW+2),0,3)})
        local dnB=MkBtn(row,{text="↓",bg=C.bg2,color=C.sub,size=SZ.fsS,
            sz=UDim2.new(0,cW,0,SZ.stepH-6), pos=UDim2.new(1,-(cW*2+5),0,3)})
        local upB=MkBtn(row,{text="↑",bg=C.bg2,color=C.sub,size=SZ.fsS,
            sz=UDim2.new(0,cW,0,SZ.stepH-6), pos=UDim2.new(1,-(cW*3+8),0,3)})

        -- 第一行隱藏上箭頭，最後一行隱藏下箭頭
        if idx==1     then upB.Visible=false end
        if idx==total then dnB.Visible=false end

        local ci=idx
        delB.MouseButton1Click:Connect(function() table.remove(EditSteps,ci); RebuildStepsList() end)
        upB.MouseButton1Click:Connect(function()
            if ci>1 then
                EditSteps[ci],EditSteps[ci-1]=EditSteps[ci-1],EditSteps[ci]
                RebuildStepsList()
            end
        end)
        dnB.MouseButton1Click:Connect(function()
            if ci<#EditSteps then
                EditSteps[ci],EditSteps[ci+1]=EditSteps[ci+1],EditSteps[ci]
                RebuildStepsList()
            end
        end)
    end
end

-- ── 載入 Macro 到編輯器 ──────────────────────────────────
local function LoadMacroToEditor(idx)
    EditingIndex = idx
    local macro  = _G.Macros[idx]
    if not macro then return end

    RightHint.Visible        = false
    EditorContainer.Visible  = true

    NameInput.Text   = macro.name or ""
    EditSteps        = DeepCopy(macro.steps or {})
    EditHotkey       = macro.hotkey and DeepCopy(macro.hotkey) or nil
    CurrentTrigger   = macro.triggerMode or "toggle"

    for m, b in pairs(TrigBtns) do
        b.BackgroundColor3 = (m==CurrentTrigger) and C.purple or C.bg3
        b.TextColor3       = (m==CurrentTrigger) and Color3.new(1,1,1) or C.sub
    end

    if EditHotkey then
        local nm = (EditHotkey.keyCode and KeyCodeToName(EditHotkey.keyCode))
                or (EditHotkey.mouseButton and MouseBtnToName(EditHotkey.mouseButton))
                or "未設定"
        HotkeyDisplay.Text      = "📌 "..nm
        HotkeyDisplay.TextColor3= C.yellow
    else
        HotkeyDisplay.Text      = "點此設定"
        HotkeyDisplay.TextColor3= C.sub
    end

    EditTitle.Text = "✏️  ".. (macro.name~="" and macro.name or "未命名")
    RebuildStepsList()
end

-- ── 清空編輯器（新增模式） ───────────────────────────────
local function ClearEditor()
    EditingIndex = nil
    EditSteps    = {}
    EditHotkey   = nil
    NameInput.Text           = ""
    HotkeyDisplay.Text       = "點此設定"
    HotkeyDisplay.TextColor3 = C.sub
    CurrentTrigger           = "toggle"
    for m, b in pairs(TrigBtns) do
        b.BackgroundColor3 = (m=="toggle") and C.purple or C.bg3
        b.TextColor3       = (m=="toggle") and Color3.new(1,1,1) or C.sub
    end
    EditTitle.Text = "📝  新增連招"
    RightHint.Visible       = false
    EditorContainer.Visible = true
    RebuildStepsList()
end

-- ── 重建左側連招清單 ─────────────────────────────────────
-- 顯示：啟用開關 / 名稱 / 武器類型 / 快捷鍵+觸發 / 步驟數
local function RebuildMacroList()
    for _, ch in pairs(MacroScroll:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end

    if #_G.Macros==0 then
        local f=Instance.new("Frame"); f.Size=UDim2.new(1,0,0,54)
        f.BackgroundTransparency=1; f.Parent=MacroScroll
        MkLbl(f,{text="尚無連招\n點下方「新增連招」",color=C.sub,size=SZ.fsS,
            xalign=Enum.TextXAlignment.Center,wrap=true,sz=UDim2.new(1,0,1,0)})
        return
    end

    for i, macro in ipairs(_G.Macros) do
        local enabled = (macro.enabled ~= false)
        local isEditing = (EditingIndex==i)

        -- 高亮邊框
        local rowBg = isEditing and C.bg3 or C.bg2
        local row=Instance.new("Frame")
        row.Size=UDim2.new(1,0,0,58)
        row.BackgroundColor3=rowBg
        row.LayoutOrder=i; row.Parent=MacroScroll
        MkCorner(row,6); MkPad(row,0,0,8,4)
        if isEditing then MkStroke(row, C.accent, 1.5) end

        -- ── 啟用開關 ──
        local onOffBtn = MkBtn(row,{
            text = enabled and "ON" or "OFF",
            bg   = enabled and C.green or C.bg3,
            color= enabled and C.bg0   or C.sub,
            size = SZ.fsS, font=Enum.Font.SourceSansBold,
            sz=UDim2.new(0,36,0,20), pos=UDim2.new(0,0,0,4),
        })

        -- ── 武器類型標籤 ──
        local wType, wColorKey = nil, nil
        -- 嘗試從步驟中分析武器類型
        for _, st in ipairs(macro.steps or {}) do
            if st.type=="switch" and st.weapon then
                local wt, wck = DetectWeaponType(st.weapon)
                if wt then wType=wt; wColorKey=wck; break end
            end
        end
        -- 若沒有切換步驟，顯示預設（名稱偵測）
        if not wType then
            wType, wColorKey = DetectWeaponType(macro.name)
        end

        local wTypeColor = C.sub
        if wColorKey then wTypeColor = C[wColorKey] or C.sub end

        local wTypeLbl = MkLbl(row,{
            text = wType and ("[" .. wType .. "]") or "",
            color=wTypeColor, size=11, font=Enum.Font.SourceSansBold,
            sz=UDim2.new(0,64,0,18), pos=UDim2.new(0,40,0,4),
        })

        -- ── 連招名稱 ──
        local nameX = wType and 108 or 42
        MkLbl(row,{
            text=(macro.name~="" and macro.name) or "（未命名）",
            color = enabled and C.text or C.sub, size=SZ.fs,
            sz=UDim2.new(1,-100,0,22), pos=UDim2.new(0,nameX,0,4),
        })

        -- ── 快捷鍵 + 觸發模式 ──
        local hkText = macro.hotkey
            and ((macro.hotkey.keyCode and KeyCodeToName(macro.hotkey.keyCode))
              or (macro.hotkey.mouseButton and MouseBtnToName(macro.hotkey.mouseButton))
              or "未設定")
            or "無快捷鍵"
        local mLbl = TrigLabels[macro.triggerMode or "toggle"] or macro.triggerMode or ""
        MkLbl(row,{
            text=hkText.."　"..mLbl,
            color=C.yellow, size=11,
            sz=UDim2.new(1,-80,0,16), pos=UDim2.new(0,8,0,38),
        })

        -- ── 步驟數 + 編輯 / 刪除 ──
        MkLbl(row,{
            text=tostring(#(macro.steps or {})).." 步",
            color=C.sub, size=11, xalign=Enum.TextXAlignment.Right,
            sz=UDim2.new(0,30,0,16), pos=UDim2.new(1,-72,0,38),
        })
        local editB=MkBtn(row,{text="編輯",bg=C.bg3,color=C.accent,size=SZ.fsXS,
            sz=UDim2.new(0,36,0,22),pos=UDim2.new(1,-70,0,4)})
        local delB2=MkBtn(row,{text="刪除",bg=C.bg3,color=C.red,size=SZ.fsXS,
            sz=UDim2.new(0,36,0,22),pos=UDim2.new(1,-70,0,30)})

        -- ── 按鈕事件 ──
        local ci=i
        onOffBtn.MouseButton1Click:Connect(function()
            _G.Macros[ci].enabled = not (_G.Macros[ci].enabled ~= false)
            ConfigDirty=true
            RefreshHotkeyListeners()
            RebuildMacroList()
        end)
        editB.MouseButton1Click:Connect(function()
            LoadMacroToEditor(ci)
            RebuildMacroList()
        end)
        delB2.MouseButton1Click:Connect(function()
            StopMacro(ci)
            table.remove(_G.Macros, ci)
            ConfigDirty=true
            RefreshHotkeyListeners()
            RebuildMacroList()
            if EditingIndex==ci then
                EditingIndex=nil
                EditorContainer.Visible=false
                RightHint.Visible=true
            elseif EditingIndex and EditingIndex>ci then
                EditingIndex=EditingIndex-1
            end
        end)
    end
end

