    local macro={
        name        = name,
        hotkey      = EditHotkey and DeepCopy(EditHotkey) or nil,
        triggerMode = CurrentTrigger,
        steps       = DeepCopy(EditSteps),
        enabled     = true,
    }
    if EditingIndex then
        macro.enabled = (_G.Macros[EditingIndex].enabled ~= false)
        _G.Macros[EditingIndex] = macro
    else
