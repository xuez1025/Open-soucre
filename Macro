-- 快捷鍵捕捉（連招 & 隱藏）
-- ========================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    -- 設定隱藏快捷鍵
    if WaitingForHideKey then
        WaitingForHideKey = false
        if input.UserInputType == Enum.UserInputType.Keyboard then
            _G.HideHotkey = { keyCode=input.KeyCode, mouseButton=nil }
        else
            _G.HideHotkey = { keyCode=nil, mouseButton=input.UserInputType }
        end
        SetHideHotkeyUI(HideBtn)
        HideBtn.TextColor3 = C.sub
        ConfigDirty = true
        return
    end

    -- 設定連招快捷鍵
    if WaitingForHotkey then
        WaitingForHotkey = false
        if input.UserInputType == Enum.UserInputType.Keyboard then
            EditHotkey = { keyCode=input.KeyCode, mouseButton=nil }
            HotkeyDisplay.Text = "📌 "..KeyCodeToName(input.KeyCode)
        else
            EditHotkey = { keyCode=nil, mouseButton=input.UserInputType }
            HotkeyDisplay.Text = "📌 "..MouseBtnToName(input.UserInputType)
        end
        HotkeyDisplay.TextColor3 = C.yellow
        return
    end

    -- 隱藏/顯示視窗
    if not gpe then
        local hk = _G.HideHotkey
        local match = (hk.keyCode and input.KeyCode==hk.keyCode)
                   or (hk.mouseButton and input.UserInputType==hk.mouseButton)
        if match then
            isHidden = not isHidden
            MainFrame.Visible = not isHidden
            if isHidden then
                local nm = hk.keyCode and KeyCodeToName(hk.keyCode)
                        or (hk.mouseButton and MouseBtnToName(hk.mouseButton))
                        or "LeftShift"
                ShowToast("視窗已隱藏   按 ["..nm.."] 重新顯示", 10)
            end
        end
    end
end)

