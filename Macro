-- ========================================================
-- 工具函數
-- ========================================================
local function DeepCopy(v)
    if type(v) ~= "table" then return v end
    local c = {}
    for k, val in pairs(v) do c[k] = DeepCopy(val) end
    return c
end

local function KeyCodeToName(kc)
    if not kc then return "?" end
    return tostring(kc):gsub("Enum%.KeyCode%.", "")
end

local function MouseBtnToName(mb)
    if not mb then return "?" end
    return tostring(mb):gsub("Enum%.UserInputType%.", "")
end

local function NameToKeyCode(name)
    if not name then return nil end
    local ok, code = pcall(function() return Enum.KeyCode[name] end)
    return (ok and code) or nil
end

