-- 根據武器名稱判斷類別，回傳顯示標籤與對應顏色 key
local WeaponCategories = {
    -- Melee
    { label="Melee",      colorKey="orange", keywords={"Shark","Pole","Dragon Claw","Death Step","Superhuman","Dark Step","Water Kung Fu","Electric Claw","Godhuman","Sharkman","Sanguine Art","Combat","Kenbunshoku","Geppo"} },
    -- Blox Fruit
    { label="Blox Fruit", colorKey="purple", keywords={"Barrier","Magma","Light","Ice","Sand","Dark","Tremor","Rubber","Smoke","Snow","String","Flame","Paw","Gravity","Door","Void","Quake","Buddha","Shadow","Love","Phoenix","Rumble","Bomb","Spike","Falcon","Kilo","Leopard","Spider","Gas","Portal","Soul","Venom","Pain","Sound","Blizzard","Dough","Ope","Kage","T-Rex","Revive"} },
    -- Sword
    { label="Sword",      colorKey="yellow", keywords={"Sword","Katana","Cutlass","Dual","Blade","Saber","Scythe","Trident","Yama","Tushita","Shisui","Bisento","Midnight","Wando","Rengoku","Pole","Serpent","Shark","Dark","Gravity","True","Enma","Soul","Cursed","Spikey","Canvander","Dragon","Hallow","Black","Koko","Pole"} },
    -- Gun
    { label="Gun",        colorKey="teal",   keywords={"Pistol","Rifle","Shotgun","Cannon","Musket","Slingshot","Flintlock","Acidum","Kabucha","Serpent Bow","Dark Dagger","Huso","Wrist","Pipe"} },
}

local function DetectWeaponType(weaponName)
    if not weaponName or weaponName == "" then return nil, nil end
    local lower = weaponName:lower()
    for _, cat in ipairs(WeaponCategories) do
        for _, kw in ipairs(cat.keywords) do
            if lower:find(kw:lower(), 1, true) then
                return cat.label, cat.colorKey
            end
        end
    end
    return nil, nil
end

local function GetCurrentWeapon()
    if not Character then return nil end
    local tool = Character:FindFirstChildOfClass("Tool")
    return tool and tool.Name or nil
end

local function EquipWeapon(weaponName)
    local item = LocalPlayer.Backpack:FindFirstChild(weaponName)
    if item and Character and Character:FindFirstChild("Humanoid") then
        Character.Humanoid:EquipTool(item)
        return true
    end
    return false
end

-- ========================================================
-- 核心：按鍵發送
-- ========================================================
local function SendKey(keyCodeEnum, holdMs)
    if not keyCodeEnum then return end
    VirtualInputManager:SendKeyEvent(true,  keyCodeEnum, false, game)
    task.wait(math.max(holdMs or 100, 50) / 1000)
    VirtualInputManager:SendKeyEvent(false, keyCodeEnum, false, game)
end

-- ========================================================
-- Macro 播放
-- triggerMode:
--   "toggle"  — 按一次開始（執行一輪後停止，等下次按）
--               → 但搭配 loop 功能在外部處理
--   "hold"    — 按住期間執行一輪
--   "loop"    — 持續循環，按一次開始，再按一次停止
-- ========================================================
local MacroRunning  = {}   -- [idx] = true / nil
local MacroLoopStop = {}   -- [idx] = true（訊號停止循環）

local function ExecMacroSteps(macroIndex, steps)
    for _, step in ipairs(steps) do
        if MacroLoopStop[macroIndex] then return false end
        if step.type == "skill" then
            local kc = NameToKeyCode(step.key)
            SendKey(kc, step.duration or 100)
        elseif step.type == "switch" then
            EquipWeapon(step.weapon)
            if (step.waitAfter or 0) > 0 then
                task.wait(step.waitAfter / 1000)
            end
        elseif step.type == "wait" then
            task.wait((step.ms or 100) / 1000)
        end
    end
    return true
end

local function RunMacro(macroIndex)
    local macro = _G.Macros[macroIndex]
    if not macro or #(macro.steps or {}) == 0 then return end
    if not (macro.enabled ~= false) then return end  -- 已關閉的連招不執行

    if macro.triggerMode == "loop" then
        if MacroRunning[macroIndex] then
            -- 已在循環：發出停止訊號
            MacroLoopStop[macroIndex] = true
            MacroRunning[macroIndex]  = nil
            return
        end
        MacroRunning[macroIndex]  = true
        MacroLoopStop[macroIndex] = nil
        task.spawn(function()
            while MacroRunning[macroIndex] do
                local cont = ExecMacroSteps(macroIndex, macro.steps)
                if not cont then break end
                if MacroLoopStop[macroIndex] then break end
                task.wait(0.016)  -- 循環間隙
            end
            MacroRunning[macroIndex]  = nil
            MacroLoopStop[macroIndex] = nil
        end)
    else
        -- toggle / hold：執行一輪
        if MacroRunning[macroIndex] then return end
        MacroRunning[macroIndex]  = true
        MacroLoopStop[macroIndex] = nil
        task.spawn(function()
            ExecMacroSteps(macroIndex, macro.steps)
            MacroRunning[macroIndex]  = nil
            MacroLoopStop[macroIndex] = nil
        end)
    end
end

local function StopMacro(macroIndex)
    MacroLoopStop[macroIndex] = true
    MacroRunning[macroIndex]  = nil
end

-- ========================================================
-- 熱鍵監聽
-- ========================================================
local HotkeyConns = {}

local function RefreshHotkeyListeners()
    for _, c in pairs(HotkeyConns) do c:Disconnect() end
    HotkeyConns = {}

    for i, macro in ipairs(_G.Macros) do
        if macro.hotkey and (macro.enabled ~= false) then
            local idx = i
            local mode = macro.triggerMode or "toggle"

            local cBegan = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                local match = (macro.hotkey.keyCode and input.KeyCode == macro.hotkey.keyCode)
                           or (macro.hotkey.mouseButton and input.UserInputType == macro.hotkey.mouseButton)
                if not match then return end

                if mode == "toggle" then
                    if MacroRunning[idx] then StopMacro(idx) else RunMacro(idx) end
                elseif mode == "loop" then
                    RunMacro(idx)   -- RunMacro 內部處理開/停
                elseif mode == "hold" then
                    RunMacro(idx)
                end
            end)
            table.insert(HotkeyConns, cBegan)

            if mode == "hold" then
                local cEnded = UserInputService.InputEnded:Connect(function(input, gpe)
                    if gpe then return end
                    local match = (macro.hotkey.keyCode and input.KeyCode == macro.hotkey.keyCode)
                               or (macro.hotkey.mouseButton and input.UserInputType == macro.hotkey.mouseButton)
                    if not match then return end
                    StopMacro(idx)
                end)
                table.insert(HotkeyConns, cEnded)
            end
        end
    end
end

-- ========================================================
-- 錄製系統（全鍵盤）
-- ========================================================
local RecordConns = {}
local RecordState = { active=false, lastTime=0, steps={}, curWeapon=nil }
local OnRecordStep = nil

local ExcludeKeys = {
    [Enum.KeyCode.Escape]=true,
    [Enum.KeyCode.LeftAlt]=true,   [Enum.KeyCode.RightAlt]=true,
    [Enum.KeyCode.LeftControl]=true,[Enum.KeyCode.RightControl]=true,
    [Enum.KeyCode.LeftShift]=true,  [Enum.KeyCode.RightShift]=true,
    [Enum.KeyCode.Tab]=true,        [Enum.KeyCode.CapsLock]=true,
    [Enum.KeyCode.Delete]=true,     [Enum.KeyCode.Backspace]=true,
    [Enum.KeyCode.Return]=true,     [Enum.KeyCode.Insert]=true,
    [Enum.KeyCode.Home]=true,       [Enum.KeyCode.End]=true,
    [Enum.KeyCode.PageUp]=true,     [Enum.KeyCode.PageDown]=true,
    [Enum.KeyCode.F1]=true, [Enum.KeyCode.F2]=true, [Enum.KeyCode.F3]=true,
    [Enum.KeyCode.F4]=true, [Enum.KeyCode.F5]=true, [Enum.KeyCode.F6]=true,
    [Enum.KeyCode.F7]=true, [Enum.KeyCode.F8]=true, [Enum.KeyCode.F9]=true,
    [Enum.KeyCode.F10]=true,[Enum.KeyCode.F11]=true,[Enum.KeyCode.F12]=true,
}

local function StartRecording(stepsRef, onStep)
    RecordState.active    = true
    RecordState.lastTime  = tick()
    RecordState.steps     = stepsRef
    RecordState.curWeapon = GetCurrentWeapon()
    OnRecordStep          = onStep
    local pressAt = {}

    local c1 = UserInputService.InputBegan:Connect(function(input, _)
        if not RecordState.active then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if ExcludeKeys[input.KeyCode] then return end
        local nm = KeyCodeToName(input.KeyCode)
        if nm == "Unknown" then return end
        pressAt[nm] = tick()
    end)

    local c2 = UserInputService.InputEnded:Connect(function(input, _)
        if not RecordState.active then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if ExcludeKeys[input.KeyCode] then return end
        local nm = KeyCodeToName(input.KeyCode)
        if nm == "Unknown" then return end

        local now  = tick()
        local dur  = pressAt[nm] and math.max(math.floor((now - pressAt[nm])*1000), 50) or 100
        pressAt[nm] = nil
        local gap  = math.max(math.floor((now - RecordState.lastTime)*1000) - dur, 0)
        RecordState.lastTime = now

        -- 武器切換偵測
        local cw = GetCurrentWeapon()
        if cw and cw ~= RecordState.curWeapon then
            table.insert(RecordState.steps, { type="switch", weapon=cw, waitAfter=0 })
            RecordState.curWeapon = cw
            if OnRecordStep then OnRecordStep() end
        end
        -- 間隙 > 80ms 插入等待
        if gap > 80 then
            table.insert(RecordState.steps, { type="wait", ms=gap })
            if OnRecordStep then OnRecordStep() end
        end
        table.insert(RecordState.steps, { type="skill", key=nm, duration=dur })
        if OnRecordStep then OnRecordStep() end
    end)

    table.insert(RecordConns, c1)
    table.insert(RecordConns, c2)
end

local function StopRecording()
    RecordState.active = false
    for _, c in pairs(RecordConns) do c:Disconnect() end
    RecordConns = {}
    OnRecordStep = nil
end

-- ========================================================
-- 設定存取
-- ========================================================
local ConfigFolder = "XuHub_Config"
local ConfigFile   = ConfigFolder .. "/settings.json"
local ConfigDirty  = false
local ConfigReady  = false
local ConfigSaving = false

local function CollectConfig()
    return { Macros = DeepCopy(_G.Macros) }
end

local function ApplyConfig(data)
    if type(data) ~= "table" then return end
    if type(data.Macros) == "table" then _G.Macros = DeepCopy(data.Macros) end
end

local function SaveConfig()
    if ConfigSaving or not ConfigDirty or typeof(writefile) ~= "function" then return end
    ConfigSaving = true
    pcall(function()
        if typeof(isfolder)=="function" and typeof(makefolder)=="function" and not isfolder(ConfigFolder) then
            makefolder(ConfigFolder)
        end
        writefile(ConfigFile, HttpService:JSONEncode(CollectConfig()))
    end)
    ConfigSaving = false
    ConfigDirty  = false
end

local function LoadConfig()
    if typeof(readfile)~="function" or typeof(isfile)~="function" or not isfile(ConfigFile) then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(ConfigFile)) end)
    if ok and type(data)=="table" then ApplyConfig(data) end
end

LoadConfig()
ConfigReady = true

task.spawn(function()
    local last = nil
    while task.wait(1) do
        if ConfigReady then
            local ok, cur = pcall(function() return HttpService:JSONEncode(CollectConfig()) end)
            if ok and cur ~= last then last = cur; ConfigDirty = true end
            if ConfigDirty then SaveConfig() end
        end
    end
end)

