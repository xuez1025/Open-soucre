RunBtn.MouseButton1Click:Connect(function()
    if EditingIndex and _G.Macros[EditingIndex] then
        RunMacro(EditingIndex)
        RunBtn.Text="▶ 執行中..."
        task.delay(0.8, function() RunBtn.Text="▶ 立即執行" end)
    elseif #EditSteps>0 then
        -- 預覽（未儲存）
        local steps=DeepCopy(EditSteps)
        task.spawn(function()
            for _, step in ipairs(steps) do
                if step.type=="skill" then
                    SendKey(NameToKeyCode(step.key), step.duration or 100)
                elseif step.type=="switch" then
                    EquipWeapon(step.weapon)
                    if (step.waitAfter or 0)>0 then task.wait(step.waitAfter/1000) end
                elseif step.type=="wait" then
                    task.wait((step.ms or 100)/1000)
                end
            end
        end)
        RunBtn.Text="▶ 預覽中..."
        task.delay(0.8, function() RunBtn.Text="▶ 立即執行" end)
    end
end)

