    local function setCombat(enabled)
        if combatOn == enabled then return end
        combatOn = enabled
        _G.AutoBusoEnabled = enabled
        _G.FastAttack = enabled
        _G.FruitsM1Enable = enabled
        _G.DragonGunM1 = enabled
        _G.AttackMobs = enabled
        if not enabled and attacking then
            pcall(function() VirtualUser:Button1Up() end)
            attacking = false
        end
    end

    -- 接近工廠 100 studs 時開啟自動切換當前選擇的配置
    local function updateAutoEquip()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if char and hrp and (hrp.Position - FactoryPos.Position).Magnitude <= 100 then
            if not _G.AutoEquip_Enabled then
                _G.AutoEquip_Enabled = true
            end
            equipByType(_G.AutoEquip_SelectedType)
            return true
        end
        _G.AutoEquip_Enabled = false
        return false
    end

    local function enterFlyMode(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hum then hum.PlatformStand = true; hum:ChangeState(Enum.HumanoidStateType.Physics) end
        if hrp then SetNoCollide(char) end
    end

    local function stopFlight()
        if isMoving then
            StopFruitFlight()
            isMoving = false
        end
    end

    local function flyTo(pos)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not (char and hrp) then return end

        isMoving = true
        enterFlyMode(char)

        if (hrp.Position - pos).Magnitude > 8 then
            FlyToFruitLogic(pos)
        else
            if _G.Fruit_LinearVelocity then
                _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
            end
        end
    end

    while true do
        if not _G.AutoFactory then
            setCombat(false)
            _G.AutoEquip_Enabled = false
            _G.FactoryBusy = false
            stopFlight()
            task.wait()
        else
            -- 用 WaitForChild 等 Core 生成（生成前不飛行，原地等待，期間可撿果）
            local core = nil
            task.spawn(function()
                core = enemies:WaitForChild("Core", math.huge)
            end)

            while not core and _G.AutoFactory do
                _G.FactoryBusy = false
                updateAutoEquip()
                task.wait()
            end

            -- Core 已生成：飛到 Core 並攻擊直到死亡（工廠優先，暫停撿果）
            if core and _G.AutoFactory then
                local hum, targetPart
                pcall(function()
                    hum = core:WaitForChild("Humanoid", math.huge)
                    targetPart = core:WaitForChild("HumanoidRootPart", math.huge)
                end)

                _G.FactoryBusy = true

                while _G.AutoFactory and core.Parent and (not hum or hum.Health > 0) do
                    -- 接近工廠 100 studs：開啟自動切換配置 + 武裝色 + 攻擊邏輯
                    if updateAutoEquip() then
                        setCombat(true)
                        if AutoHaki then AutoHaki() end
                        pcall(function()
                            VirtualUser:CaptureController()
                            VirtualUser:Button1Down(Vector2.new(1280, 672))
                        end)
                        attacking = true
                    else
                        setCombat(false)
                    end

                    if targetPart then
                        flyTo(targetPart.Position)
                    end
                    task.wait()
                end
            end

            setCombat(false)
            _G.FactoryBusy = false
            stopFlight()
        end
    end
end)

