local function equipByType(toolType)
    _G.AutoEquip_SelectedType = toolType -- 更新當前選擇的配置類型
    if not _G.AutoEquip_Enabled then return end -- 若未開啟自動裝備則不執行

    local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")

    -- 遍歷背包中的所有物品
    for _, tool in ipairs(game.Players.LocalPlayer.Backpack:GetChildren()) do
        -- 比對 ToolTip 是否符合選擇的配置類型
        if tool:IsA("Tool") and tool.ToolTip == toolType then
            hum:EquipTool(tool) -- 讓角色裝備該武器
            break
        end
    end
end

