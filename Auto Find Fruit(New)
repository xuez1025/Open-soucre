task.spawn(function()
    while true do
        if _G.AutoStoreFruit then
            pcall(function()
                local character = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                
                for remoteName, toolName in pairs(FruitList) do
                    local fruitTool = nil
                    
                    if character then
                        fruitTool = character:FindFirstChild(toolName)
                    end
                    
                    if not fruitTool then
                        if backpack then
                            fruitTool = backpack:FindFirstChild(toolName)
                        end
                    end
                    
                    if fruitTool then
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StoreFruit", remoteName, fruitTool)
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

