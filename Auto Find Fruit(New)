local function ClearFruitFlightComponents()
    if _G.Fruit_LinearVelocity then _G.Fruit_LinearVelocity:Destroy(); _G.Fruit_LinearVelocity = nil end
    if _G.Fruit_AntiGravity then _G.Fruit_AntiGravity:Destroy(); _G.Fruit_AntiGravity = nil end
    if _G.Fruit_Attachment then _G.Fruit_Attachment:Destroy(); _G.Fruit_Attachment = nil end
end

local function SetupFruitFlightComponents(hrp)
    ClearFruitFlightComponents()

    local att = Instance.new("Attachment")
    att.Name = "XuHub_FruitFlightAtt"
    att.Parent = hrp
    _G.Fruit_Attachment = att

    local lv = Instance.new("LinearVelocity")
    lv.Name = "XuHub_FruitFlightVel"
    lv.MaxForce = math.huge
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = Vector3.new(0, 0, 0)
    lv.Attachment0 = att
    lv.Parent = hrp
    _G.Fruit_LinearVelocity = lv

    local totalMass = 0
    local char = hrp.Parent
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part.Massless then
                totalMass = totalMass + part:GetMass()
            end
        end
    end

    local vf = Instance.new("VectorForce")
    vf.Name = "XuHub_FruitAntiGrav"
    vf.ApplyAtCenterOfMass = true
    vf.Attachment0 = att
    vf.Force = Vector3.new(0, totalMass * workspace.Gravity, 0)
    vf.Parent = hrp
    _G.Fruit_AntiGravity = vf
end

