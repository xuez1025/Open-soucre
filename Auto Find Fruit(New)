        end)

        if success and result and result.data then
            return result
        end
        return nil
    end

    local function FindInPage(data, strict)
        if not data then return nil end
        for _, server in ipairs(data) do
            if type(server) == "table" and server.id and server.playing and server.maxPlayers then
                local id = tostring(server.id)
                local playing = tonumber(server.playing) or 0
                local maxPlayers = tonumber(server.maxPlayers) or 12
                if id ~= tostring(JobId) and not VisitedServers[id] and playing < maxPlayers then
                    if strict then
                        if playing >= 2 and playing <= 10 then
                            return id
                        end
                    else
                        if playing >= 1 then
                            return id
                        end
                    end
                end
            end
        end
        return nil
    end

    _G.ServerHopConn = task.spawn(function()
        while _G.ServerHopping do
            if game.JobId ~= startJobId then
                _G.ServerHopping = false
                break
            end

            local success, err = pcall(function()
                local serverData = GetServers()
                local targetServerId = nil

                if serverData then
                    targetServerId = FindInPage(serverData.data, true)

                    if not targetServerId and serverData.nextPageCursor then
                        local nextPageData = GetServers(serverData.nextPageCursor)
                        if nextPageData then
                            targetServerId = FindInPage(nextPageData.data, true)
                        end
                    end

                    if not targetServerId then
                        targetServerId = FindInPage(serverData.data, false)
                    end
                end

                if targetServerId then
                    VisitedServers[targetServerId] = true

                    pcall(function()
                        if ServerBrowserRemote then
                            ServerBrowserRemote:InvokeServer("teleport", targetServerId)
                        else
                            TeleportService:TeleportToPlaceInstance(PlaceId, targetServerId, LocalPlayer)
                        end
                    end)

                    local hopDeadline = os.clock() + HOP_TIMEOUT
                    while _G.ServerHopping and game.JobId == startJobId and os.clock() < hopDeadline do
                        task.wait(0.1)
                    end

                    if game.JobId ~= startJobId then
                        _G.ServerHopping = false
                        return
                    end
                else
                    VisitedServers = { [JobId] = true }
                end
            end)

            if not success then
                warn("跳服搜尋出錯: " .. tostring(err))
            end

            if not _G.ServerHopping then
                break
            end

            task.wait(HOP_FAIL_WAIT)
        end
    end)
end

local function StartServerHopSequence()
    if _G.ServerHopping then return end
    _G.ServerHopping = true

    task.spawn(function()
        for i = _G.HopDelayTime, 1, -1 do
            if not _G.Tweenfruit then 
                _G.ServerHopping = false 
                return 
            end
            if GetActiveFruitCount() > 0 then
                _G.ServerHopping = false
                return
            end
            if WindUI then
                WindUI:Notify({ Title = "提示", Content = tostring(i) .. " 秒之後自動換服...", Duration = 1 })
            end
            task.wait(1)
        end

        if _G.Tweenfruit and GetActiveFruitCount() == 0 then
            ServerCore:FindAndHop("random")
        else
            _G.ServerHopping = false
        end
    end)
end

local function getClosestFruit()
    local char = LocalPlayer.Character
    local pHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not pHRP then return nil end

    local closestFruit = nil
    local shortestDistance = math.huge

    for _, v in ipairs(workspace:GetChildren()) do
        if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then
            local dist = (v.Handle.Position - pHRP.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                closestFruit = v.Handle
            end
        end
    end
    return closestFruit
end

-- 移動與飛果線程
task.spawn(function()
    local jumpTimer = 0

    local function enterFlyMode(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hum then hum.PlatformStand = true; hum:ChangeState(Enum.HumanoidStateType.Physics) end
        if hrp then SetNoCollide(char) end
    end

    RunService.RenderStepped:Connect(function()
        if not _G.Tweenfruit then
            if _G.IsMovingToFruit then
                StopFruitFlight()
                _G.IsMovingToFruit = false
            end
            return
        end

        local char = LocalPlayer.Character
        if not char then return end

        ForceStandUp()

        local fruitHandle = getClosestFruit()

        if fruitHandle then
            _G.LastFruitTime = tick()
            _G.ForceHopTriggered = false
            _G.IsMovingToFruit = true

            enterFlyMode(char)

            local hrp = char:FindFirstChild("HumanoidRootPart")
            local dist = hrp and (hrp.Position - fruitHandle.Position).Magnitude or math.huge

            if dist <= 8 then
                if hrp then
                    hrp.CFrame = fruitHandle.CFrame + Vector3.new(0, 3, 0)
                end
                if _G.Fruit_LinearVelocity then
                    _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                end
                doJump()
            else
                FlyToFruitLogic(fruitHandle.Position)

                jumpTimer = jumpTimer + 1 / 60
                if jumpTimer >= 0.3 then
                    jumpTimer = 0
                    doJump()
                end
            end
        else
            if _G.IsMovingToFruit then
                StopFruitFlight()
                _G.IsMovingToFruit = false
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.PlatformStand = false
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
                SetCollide(char)
            end

            if not _G.ServerHopping then
                StartServerHopSequence()
            end
        end
    end)
end)

-- 5分鐘無果防卡保護線程
task.spawn(function()
    while true do
        task.wait(10)
        if _G.Tweenfruit and not _G.ServerHopping then
            local fruitHandle = getClosestFruit()
            if fruitHandle then
                _G.LastFruitTime = tick()
                _G.ForceHopTriggered = false
            else
                if not _G.ForceHopTriggered and (tick() - _G.LastFruitTime) > 300 then
                    _G.ForceHopTriggered = true
                    StartServerHopSequence()
                end
            end
        else
            _G.LastFruitTime = tick()
            _G.ForceHopTriggered = false
        end
    end
end)

