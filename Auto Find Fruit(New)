local function FlyToFruitLogic(targetPos)
    local char = LocalPlayer.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    if os.clock() < _G.Fruit_TeleportPauseUntil then
        if _G.Fruit_LinearVelocity then
            _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
        end
        myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        return
    end

    local now = os.clock()
    if not Fruit_OrbitOffset or now >= Fruit_NextOrbitTime then
        local maxRadius = 20
        local dist = math.random(1, maxRadius)
        local d = Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
        if d.Magnitude > 0 then d = d.Unit end
        Fruit_OrbitOffset = d * dist
        Fruit_NextOrbitTime = now + 0.05
    end
    local finalTarget = targetPos + Fruit_OrbitOffset

    local dir = finalTarget - myHRP.Position
    local distToFruit = (targetPos - myHRP.Position).Magnitude

    local directFlightTime = distToFruit / _G.FruitFlySpeed
    local bestEntrance = nil
    local bestTotalTime = directFlightTime
    local teleportPenalty = 1.5
    local pool = GetCurrentWorldEntrances()

    if distToFruit < 300 then pool = {} end

    for _, e in ipairs(pool) do
        if _G.Fruit_BlockedEntrances[e.Arg] then continue end

        local destDistToFruit = (e.Dest - targetPos).Magnitude
        local totalTimeViaPortal = (destDistToFruit / _G.FruitFlySpeed) + teleportPenalty

        if totalTimeViaPortal < bestTotalTime then
            if (distToFruit - destDistToFruit) > 150 then
                bestTotalTime = totalTimeViaPortal
                bestEntrance = e
            end
        end
    end

    if bestEntrance then
        local lastTime = _G.Fruit_LastTeleportTicks[bestEntrance.Arg] or 0
        if os.clock() - lastTime > 4 then
            _G.Fruit_LastTeleportTicks[bestEntrance.Arg] = os.clock()
            _G.Fruit_TeleportPauseUntil = os.clock() + 1.2

            local preDist = (myHRP.Position - bestEntrance.Dest).Magnitude

            if _G.Fruit_LinearVelocity then
                _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
            end
            myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

            task.spawn(function()
                pcall(function()
                    local commF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
                    commF:InvokeServer("requestEntrance", bestEntrance.Arg)
                end)
            end)

            task.spawn(function()
                task.wait(1.5)
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local postDist = (hrp.Position - bestEntrance.Dest).Magnitude
                    if postDist > 150 and postDist >= preDist * 0.5 then
                        local fails = (_G.Fruit_TeleportFails[bestEntrance.Arg] or 0) + 1
                        _G.Fruit_TeleportFails[bestEntrance.Arg] = fails
                        if fails >= 3 then
                            _G.Fruit_BlockedEntrances[bestEntrance.Arg] = true
                        end
                    end
                end
            end)
            return
        end
    end

    local needSetup = not _G.Fruit_LinearVelocity or _G.Fruit_LinearVelocity.Parent ~= myHRP
    if needSetup then SetupFruitFlightComponents(myHRP) end

    if dir.Magnitude > 0.1 then
        _G.Fruit_LinearVelocity.VectorVelocity = dir.Unit * _G.FruitFlySpeed
    else
        _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
    end

    local lookAt = Vector3.new(targetPos.X, myHRP.Position.Y, targetPos.Z)
    if (lookAt - myHRP.Position).Magnitude > 0.1 then
        myHRP.CFrame = CFrame.new(myHRP.Position, lookAt)
    end
end

local function StopFruitFlight()
    if _G.Fruit_LinearVelocity then
        _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
    end
    ClearFruitFlightComponents()
    Fruit_OrbitOffset = nil
    Fruit_NextOrbitTime = 0

    local char = LocalPlayer.Character
    if char then
        SetCollide(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

