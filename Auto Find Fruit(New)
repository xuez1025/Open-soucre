local function GetWorldTransitPoints()
    local pid = game.PlaceId
    if pid == 2753915549 or pid == 85211729168715 then
        return TransitPoints.World1
    elseif pid == 4442272183 or pid == 79091703265657 then
        return TransitPoints.World2
    elseif pid == 7449423635 or pid == 100117331123089 then
        return TransitPoints.World3
    end
    return {}
end

local function PlanTransitRoute(fromPos, targetPos)
    local portals = GetWorldTransitPoints()
    if #portals == 0 then return {} end

    local bestCost = (targetPos - fromPos).Magnitude   -- 直飛作為基準
    local bestIndices = {}

    for i, p in ipairs(portals) do
        local cost = (p.point - fromPos).Magnitude + (p.dest - targetPos).Magnitude
        if cost < bestCost then
            bestCost = cost
            bestIndices = { i }
        end
    end

    for i, p in ipairs(portals) do
        for j, q in ipairs(portals) do
            if i ~= j then
                local cost = (p.point - fromPos).Magnitude
                           + (p.dest - q.point).Magnitude
                           + (q.dest - targetPos).Magnitude
                if cost < bestCost then
                    bestCost = cost
                    bestIndices = { i, j }
                end
            end
        end
    end

    local waypoints = {}
    for _, idx in ipairs(bestIndices) do
        table.insert(waypoints, portals[idx].point)
    end
    return waypoints
end

