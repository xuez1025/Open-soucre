local Fruit_OrbitOffset = nil
local Fruit_NextOrbitTime = 0

local function FlyToFruitLogic(targetPos)
    local char = LocalPlayer.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    if not _G.FTP2_Transit or not _G.FTP2_TransitTarget or (_G.FTP2_TransitTarget - targetPos).Magnitude > 20 then
        _G.FTP2_TransitTarget = targetPos
        local waypoints = PlanTransitRoute(myHRP.Position, targetPos)
        _G.FTP2_Transit = {
            waypoints = waypoints,
            index = 1,
            waiting = false,
            waitUntil = 0
        }
    end

    local flyTarget = targetPos

    if _G.FTP2_Transit and _G.FTP2_Transit.index <= #_G.FTP2_Transit.waypoints then
        local currentWP = _G.FTP2_Transit.waypoints[_G.FTP2_Transit.index]

        local portals = GetWorldTransitPoints()
        local currentPortal = nil
        for _, p in ipairs(portals) do
            if p.point == currentWP then
                currentPortal = p
                break
            end
        end

        local hasTeleported = false
        if currentPortal then
            local distToDest = (myHRP.Position - currentPortal.dest).Magnitude
            local distToTargetFromHere = (myHRP.Position - targetPos).Magnitude
            local distToTargetFromWP = (currentWP - targetPos).Magnitude

            if distToDest <= 200 or (distToTargetFromWP - distToTargetFromHere) > 500 then
                hasTeleported = true
            end
        end

        if hasTeleported then
            _G.FTP2_Transit.waiting = false
            _G.FTP2_Transit.index = _G.FTP2_Transit.index + 1
            if _G.FTP2_Transit.index <= #_G.FTP2_Transit.waypoints then
                flyTarget = _G.FTP2_Transit.waypoints[_G.FTP2_Transit.index]
            else
                flyTarget = targetPos
            end
        elseif _G.FTP2_Transit.waiting then
            if os.clock() >= _G.FTP2_Transit.waitUntil then
                _G.FTP2_Transit.waiting = false
                _G.FTP2_Transit.index = _G.FTP2_Transit.index + 1
            else
                if _G.Fruit_LinearVelocity then
                    _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                end
                myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                return
            end
        else
            local distToWP = (currentWP - myHRP.Position).Magnitude
            if distToWP <= TRANSIT_ARRIVE_DIST then
                _G.FTP2_Transit.waiting = true
                _G.FTP2_Transit.waitUntil = os.clock() + TRANSIT_WAIT_TIME
                if _G.Fruit_LinearVelocity then
                    _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                end
                myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                return
            else
                flyTarget = currentWP
            end
        end
    end

    local moveTarget = flyTarget
    if flyTarget == targetPos then
        local now = os.clock()
        if not Fruit_OrbitOffset or now >= Fruit_NextOrbitTime then
            local maxRadius = 20
            local dist = math.random(1, maxRadius)
            local d = Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
            if d.Magnitude > 0 then d = d.Unit end
            Fruit_OrbitOffset = d * dist
            Fruit_NextOrbitTime = now + 0.05
        end
        moveTarget = targetPos + Fruit_OrbitOffset
    end

    -- 4. 執行物理飛行
    local needSetup = not _G.Fruit_LinearVelocity or _G.Fruit_LinearVelocity.Parent ~= myHRP
    if needSetup then SetupFruitFlightComponents(myHRP) end

    local dir = moveTarget - myHRP.Position
    if dir.Magnitude > 0.1 then
        _G.Fruit_LinearVelocity.VectorVelocity = dir.Unit * (_G.FruitFlySpeed or 350)
    else
        _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
    end

    local lookAt = Vector3.new(moveTarget.X, myHRP.Position.Y, moveTarget.Z)
    if (lookAt - myHRP.Position).Magnitude > 0.1 then
        myHRP.CFrame = CFrame.new(myHRP.Position, lookAt)
    end
end

local function StopFruitFlight()
    if _G.Fruit_LinearVelocity then
        _G.Fruit_LinearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
    end
    ClearFruitFlightComponents()
    Fruit_OrbitOffset = nil
    Fruit_NextOrbitTime = 0
    _G.FTP2_Transit = nil
    _G.FTP2_TransitTarget = nil

    local char = LocalPlayer.Character
    if char then
        SetCollide(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

