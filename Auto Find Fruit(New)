local function WaitForAllFruitsPicked(timeout)
    local startTime = tick()
    while GetActiveFruitCount() > 0 do
        if not _G.Tweenfruit then return false end
        if tick() - startTime >= timeout then return false end
        task.wait(1)
    end
    return true
end

local ServerCore = {}

function ServerCore:TeleportToServer(jobId)
    if not jobId or jobId == "" then
        _G.ServerHopping = false
        return
    end

    local now = tick()
    if (now - _G.LastTeleportTime) < _G.TELEPORT_COOLDOWN then
        task.wait(_G.TELEPORT_COOLDOWN - (now - _G.LastTeleportTime))
    end
    _G.LastTeleportTime = tick()
    _G.HopTargetJobId = jobId

    task.spawn(function()
        if ServerBrowserRemote then
            local success = pcall(function()
                ServerBrowserRemote:InvokeServer("teleport", jobId)
            end)
            if success then return end
        end

        local teleportOptions = Instance.new("TeleportOptions")
        teleportOptions.ServerInstanceId = jobId

        local ok = pcall(function()
            TeleportService:TeleportAsync(PlaceId, { LocalPlayer }, teleportOptions)
        end)
        if not ok then
            ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, jobId, LocalPlayer)
            end)
        end
        if not ok then
            task.wait(5)
            _G.ServerHopping = false
            _G.HopTargetJobId = nil
        end
    end)

    if _G.HopConfirmConn then _G.HopConfirmConn:Disconnect(); _G.HopConfirmConn = nil end

    local hopStartTime = tick()
    local retryCount = 0
    local MAX_RETRIES = 5

    _G.HopConfirmConn = RunService.Heartbeat:Connect(function()
        if game.JobId ~= JobId then
            _G.HopConfirmConn:Disconnect(); _G.HopConfirmConn = nil
            _G.HopTargetJobId = nil
            return
        end
        if tick() - hopStartTime > 10 then
            retryCount = retryCount + 1
            if retryCount >= MAX_RETRIES then
                _G.HopConfirmConn:Disconnect(); _G.HopConfirmConn = nil
                _G.HopTargetJobId = nil
                _G.ServerHopping = false
                return
            end
            hopStartTime = tick()

            if GetActiveFruitCount() > 0 then
                _G.HopTargetJobId = nil
                _G.ServerHopping = false
                return
            end

            ServerCore:FindAndHop("random")
        end
    end)
end

function ServerCore:FindAndHop(mode)
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not (success and response and response.data) then _G.ServerHopping = false; return end

    local validServers = {}
    for _, server in ipairs(response.data) do
        if server.id ~= JobId and server.id ~= _G.HopTargetJobId
            and server.playing and server.maxPlayers
            and server.playing < server.maxPlayers then
            table.insert(validServers, { id = server.id, count = server.playing })
        end
    end
    if #validServers == 0 then _G.ServerHopping = false; return end

    local targetJobId
    if mode == "small" then
        table.sort(validServers, function(a, b) return a.count < b.count end)
        targetJobId = validServers[1].id
    else
        targetJobId = validServers[math.random(1, #validServers)].id
    end
    self:TeleportToServer(targetJobId)
end

local function StartServerHopSequence()
    if _G.ServerHopping then return end
    _G.ServerHopping = true
    task.spawn(function()
        for i = _G.HopDelayTime, 1, -1 do
            if not _G.Tweenfruit then _G.ServerHopping = false; return end
            if GetActiveFruitCount() > 0 then
                _G.ServerHopping = false
                return
            end
            if WindUI then
                WindUI:Notify({ Title = "提示", Content = tostring(i) .. " 秒之後自動換服...", Duration = 1 })
            end
            task.wait(1)
        end
        if _G.Tweenfruit and GetActiveFruitCount() == 0 then
            ServerCore:FindAndHop("random")
        else
            _G.ServerHopping = false
        end
    end)
end

local function getClosestFruit()
    local char = LocalPlayer.Character
    local pHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not pHRP then return nil end

    local closestFruit = nil
    local shortestDistance = math.huge

    for _, v in ipairs(workspace:GetChildren()) do
        if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then
            local dist = (v.Handle.Position - pHRP.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                closestFruit = v.Handle
            end
        end
    end
    return closestFruit
end

