task.spawn(function()
    local schedule = {
        { wait = 600, label = "10 分鐘定時換服", mode = "hop" },
        { wait = 300, label = "15 分鐘定時換服", mode = "hop" },
        { wait = 300, label = "20 分鐘定時換服", mode = "hop" },
        { wait = 600, label = "30 分鐘定時重連", mode = "rejoin" },
    }
    while true do
        for _, entry in ipairs(schedule) do
            task.wait(entry.wait)
            if entry.mode == "hop" then
                if GetActiveFruitCount() > 0 then
                    WaitForAllFruitsPicked(300)
                end
                _G.ServerHopping = false
                StopFruitFlight()
                ServerCore:FindAndHop("random")
            elseif entry.mode == "rejoin" then
                if GetActiveFruitCount() > 0 then
                    WaitForAllFruitsPicked(300)
                end
                task.wait(4)
                _G.ServerHopping = false
                StopFruitFlight()
                ServerCore:TeleportToServer(JobId)
            end
        end
    end
end)

