                end

                if not Mon then return end
                local targetPos = Mon.PrimaryPart and Mon.PrimaryPart.Position
                if not targetPos then return end

                local function Network(part)
                    if isnetworkowner then
                        return isnetworkowner(part)
                    end
                    return part.ReceiveAge == 0 and not part.Anchored and part.Velocity.Magnitude > 0
                end

                for _, v in ipairs(workspace.Enemies:GetChildren()) do
                    if v ~= Mon then
                        local hum = v:FindFirstChildOfClass("Humanoid")
                        local root = v:FindFirstChild("HumanoidRootPart")

                        if hum and root and hum.Health > 0 and v.Name == Mon.Name then
                            local distance = (root.Position - targetPos).Magnitude
                            if distance <= math.huge then
                                local bv = root:FindFirstChild("BodyVelocity")
                                if not bv then
                                    bv = Instance.new("BodyVelocity")
                                    bv.Name = "BodyVelocity"
                                    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                                    bv.Velocity = Vector3.zero
                                    bv.Parent = root
                                end

                                if distance > 10 and Network(root) then
                                    root.CFrame = CFrame.new(targetPos)
                                end

                                root.CanCollide = false
                                hum.WalkSpeed = 0
                                hum.JumpPower = 0
                                if hum:GetState() ~= Enum.HumanoidStateType.Seated then
                                    hum:ChangeState(11)
                                end
                            end
                        end
                    end
                end

                if Mon:FindFirstChild("HumanoidRootPart") and Mon:FindFirstChild("Humanoid") then
                    Mon.HumanoidRootPart.CanCollide = false
                    Mon.Humanoid.WalkSpeed = 0
                    Mon.Humanoid.JumpPower = 0
                end
            end)
        end
    end
end)

local lastTweenTargetPos = nil

RunService.Heartbeat:Connect(function()
    if _G.AutoTrackNPC then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local closest, dist = nil, math.huge
        local enemiesFolder = workspace:FindFirstChild("Enemies")
        if not enemiesFolder then return end

        for _, npc in pairs(enemiesFolder:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 and npc.PrimaryPart and not string.find(npc.Name, "Boss") and npc.Name ~= "Tyrant of the Skies" then
                local p = npc.PrimaryPart.Position
                local d = (p - hrp.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = npc
                end
            end
        end
        targetNPC = closest

        if targetNPC and targetNPC.PrimaryPart then
            local tpos = Vector3.new(
                targetNPC.PrimaryPart.Position.X,
                targetNPC.PrimaryPart.Position.Y + _G.HoverHeight,
                targetNPC.PrimaryPart.Position.Z
            )
            local targetCFrame = CFrame.new(tpos)

            if not _G.isMovementActive or not lastTweenTargetPos or (lastTweenTargetPos - tpos).Magnitude > 2 then
                lastTweenTargetPos = tpos
                globalTweenTo(targetCFrame)
            end
        else
            if _G.isMovementActive then
                globalStopTween()
                lastTweenTargetPos = nil
            end
        end
    end
end)

