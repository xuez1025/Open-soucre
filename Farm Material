local function GetMaterialFarmConfig(name)
    local list = MaterialFarm[CurrentWorld]
    if not name or not list then return nil end
    for _, mat in ipairs(list) do
        -- 支援「中文(English)」顯示名稱 或 純中文名稱
        if mat.Name == name or (mat.Name .. "(" .. mat.En .. ")") == name then
            return mat
        end
    end
    return nil
end

