local lastTransformAttempt = 0

local function isBuddhaTransformed()
	local character = LocalPlayer.Character
	if not character then return false end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	
	if humanoid.HipHeight > 5 then
		return true
	end
	
	if character:GetScale() > 1.5 then
		return true
	end
	
	return false
end

local function triggerBuddhaTransform()
	local character = LocalPlayer.Character
	if not character then return end
	
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local buddhaTool = (backpack and backpack:FindFirstChild("Buddha-Buddha")) or character:FindFirstChild("Buddha-Buddha")
	
	if not buddhaTool then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and buddhaTool.Parent ~= character then
		humanoid:EquipTool(buddhaTool)
		task.wait(0.15)
	end
	
	local remoteEvent = buddhaTool:FindFirstChild("RemoteEvent")
	local pos1 = Vector3.new(-339.2312316894531, 198.39112854003906, 20.792236328125)
	local pos2 = Vector3.new(-338.5541076660156, 198.39112854003906, 18.80804443359375)
	
	pcall(function()
		if remoteEvent then
			remoteEvent:FireServer(true)
			remoteEvent:FireServer(pos1)
			remoteEvent:FireServer(pos1)
		end
		
		if humanoid then
			for _, child in ipairs(humanoid:GetChildren()) do
				if child:IsA("RemoteFunction") then
					child:InvokeServer("Z")
				elseif child:IsA("RemoteEvent") then
					child:FireServer("Z")
				end
			end
		end
		
		if remoteEvent then
			remoteEvent:FireServer(pos2)
			remoteEvent:FireServer(false)
		end
	end)
end

local function IsAtFarmLocation()
    local matConfig = GetMaterialFarmConfig(_G.SelectedMaterial)
    if not matConfig then return false end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local myPos = hrp.Position

    for _, pos in ipairs(matConfig.Positions) do
        local dx = myPos.X - pos.X
        local dz = myPos.Z - pos.Z
        if (dx * dx + dz * dz) <= 15 * 15 then
            return true
        end
    end

    if targetNPC and targetNPC.PrimaryPart then
        for _, en in ipairs(matConfig.Enemies) do
            if targetNPC.Name == en then
                local d = (targetNPC.PrimaryPart.Position - myPos).Magnitude
                if d <= 40 then return true end
            end
        end
    end

    return false
end

