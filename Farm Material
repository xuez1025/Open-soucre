local function GetBestEntrance(myPos, targetPos)
    local distToFruit = (targetPos - myPos).Magnitude
    
    if distToFruit < 300 then return nil end

    local directFlightTime = distToFruit / _G.FruitFlySpeed
    local bestEntrance = nil
    local bestTotalTime = directFlightTime
    local teleportPenalty = 1.5 -- 傳送讀條/載入的時間懲罰（秒）
    local pool = GetCurrentWorldEntrances()

    for _, e in ipairs(pool) do
        if _G.Fruit_BlockedEntrances[e.Arg] then continue end

        local destDistToFruit = (e.Dest - targetPos).Magnitude
        local totalTimeViaPortal = (destDistToFruit / _G.FruitFlySpeed) + teleportPenalty

        if totalTimeViaPortal < bestTotalTime then
            if (distToFruit - destDistToFruit) > 150 then
                bestTotalTime = totalTimeViaPortal
                bestEntrance = e
            end
        end
    end

    return bestEntrance
end

local function TryTeleportEntrance(bestEntrance, myHRP)
    local lastTime = _G.Fruit_LastTeleportTicks[bestEntrance.Arg] or 0
    
    if os.clock() - lastTime > 4 then
        _G.Fruit_LastTeleportTicks[bestEntrance.Arg] = os.clock()
        _G.Fruit_TeleportPauseUntil = os.clock() + 1.2 -- 暫停飛行移動 1.2 秒

        if _G.Fruit_LinearVelocity then
            _G.Fruit_LinearVelocity.VectorVelocity = Vector3.zero
        end
        myHRP.AssemblyLinearVelocity = Vector3.zero

        local preDist = (myHRP.Position - bestEntrance.Dest).Magnitude

        task.spawn(function()
            pcall(function()
                local commF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
                commF:InvokeServer("requestEntrance", bestEntrance.Arg)
            end)
        end)

        task.spawn(function()
            task.wait(1.5)
            local c = LocalPlayer.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if hrp then
                local postDist = (hrp.Position - bestEntrance.Dest).Magnitude
                -- 若傳送後位置沒有明顯靠近目的地
                if postDist > 150 and postDist >= preDist * 0.5 then
                    local fails = (_G.Fruit_TeleportFails[bestEntrance.Arg] or 0) + 1
                    _G.Fruit_TeleportFails[bestEntrance.Arg] = fails
                    -- 失敗達到 3 次則加入黑名單，不再使用該入口
                    if fails >= 3 then
                        _G.Fruit_BlockedEntrances[bestEntrance.Arg] = true
                    end
                end
            end
        end)
        return true
    end
    return false
end

local lastTweenTargetPos = nil

RunService.Heartbeat:Connect(function()
    if _G.AutoTrackNPC then
        local matConfig = GetMaterialFarmConfig(_G.SelectedMaterial)
        if not matConfig then
            if _G.isMovementActive then
                globalStopTween()
                lastTweenTargetPos = nil
            end
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local closest, dist = nil, math.huge
        local enemiesFolder = workspace:FindFirstChild("Enemies")
        if not enemiesFolder then return end

        for _, npc in pairs(enemiesFolder:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 and npc.PrimaryPart and not string.find(npc.Name, "Boss") and npc.Name ~= "Tyrant of the Skies" then
                local matched = false
                for _, en in ipairs(matConfig.Enemies) do
                    if npc.Name == en then matched = true break end
                end
                if not matched then continue end
                local p = npc.PrimaryPart.Position
                local d = (p - hrp.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = npc
                end
            end
        end
        targetNPC = closest

        local tpos = nil
        if targetNPC and targetNPC.PrimaryPart then
            tpos = Vector3.new(
                targetNPC.PrimaryPart.Position.X,
                targetNPC.PrimaryPart.Position.Y + _G.HoverHeight,
                targetNPC.PrimaryPart.Position.Z
            )
        elseif #matConfig.Positions > 0 then
            local curIndex = matConfig.CoordIndex or 1
            local pos = matConfig.Positions[curIndex]

            if os.clock() < _G.Fruit_TeleportPauseUntil then
                if _G.isMovementActive then
                    globalStopTween()
                    lastTweenTargetPos = nil
                end
                return
            end
            local bestEntrance = GetBestEntrance(hrp.Position, pos)
            if bestEntrance and TryTeleportEntrance(bestEntrance, hrp) then
                if _G.isMovementActive then
                    globalStopTween()
                    lastTweenTargetPos = nil
                end
                return
            end

            tpos = Vector3.new(pos.X, pos.Y + _G.HoverHeight, pos.Z)

            if (hrp.Position - tpos).Magnitude <= 5 then
                if not matConfig.Waiting then
                    matConfig.Waiting = true
                    matConfig.WaitStart = tick()
                elseif tick() - matConfig.WaitStart >= 2 then
                    matConfig.Waiting = false
                    local nextIndex = curIndex % #matConfig.Positions + 1
                    matConfig.CoordIndex = nextIndex
                    local npos = matConfig.Positions[nextIndex]
                    tpos = Vector3.new(npos.X, npos.Y + _G.HoverHeight, npos.Z)
                end
            else
                matConfig.Waiting = false
            end
        end

        if tpos then
            local targetCFrame = CFrame.new(tpos)

            if not _G.isMovementActive or not lastTweenTargetPos or (lastTweenTargetPos - tpos).Magnitude > 2 then
                lastTweenTargetPos = tpos
                globalTweenTo(targetCFrame)
            end
        else
            if _G.isMovementActive then
                globalStopTween()
                lastTweenTargetPos = nil
            end
        end
    end
end)

