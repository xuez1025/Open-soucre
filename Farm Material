        }
        local function checkChild(child)
            if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                State.FoundRemoteId = child:GetAttribute("Id")
                State.FoundRemote   = child
            end
        end
        for _, folder in ipairs(folders) do
