-- 存活敵人追蹤器: 事件更新 + 定期校正 取代每秒全量掃描
-- Count: 存活敵人數量 (過關判斷) / List: 存活敵人模型快取 (移動目標)
local EnemyTracker = { Count = 0, List = {} }

local function addToEnemyList(model)
    for _, m in ipairs(EnemyTracker.List) do
        if m == model then return end
    end
    EnemyTracker.List[#EnemyTracker.List + 1] = model
end

local function removeFromEnemyList(model)
    for i = #EnemyTracker.List, 1, -1 do
        if EnemyTracker.List[i] == model then
            table.remove(EnemyTracker.List, i)
            return
        end
    end
end

local function resyncEnemyTracker()
    local list = {}
    local total = 0
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, npc in ipairs(enemies:GetChildren()) do
            if isFriendlyMob(npc) then continue end
            local hum = npc:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                total = total + 1
                list[#list + 1] = npc
            end
        end
    end
    EnemyTracker.Count = total
    EnemyTracker.List = list
end

local function bindEnemyWatcher(folder)
    if not folder then return end
    folder.DescendantAdded:Connect(function(desc)
        if not desc:IsA("Humanoid") then return end
        local npc = desc.Parent
        if isFriendlyMob(npc) then return end
        if desc.Health > 0 then
            EnemyTracker.Count = EnemyTracker.Count + 1
            addToEnemyList(npc)
        end
        desc.Died:Connect(function()
            if EnemyTracker.Count > 0 then EnemyTracker.Count = EnemyTracker.Count - 1 end
            removeFromEnemyList(npc)
        end)
    end)
    folder.DescendantRemoving:Connect(function(desc)
        if desc:IsA("Humanoid") and desc.Health > 0 and EnemyTracker.Count > 0 then
            EnemyTracker.Count = EnemyTracker.Count - 1
            removeFromEnemyList(desc.Parent)
        end
    end)
end

local enemiesFolder = workspace:FindFirstChild("Enemies")
resyncEnemyTracker()
bindEnemyWatcher(enemiesFolder)

