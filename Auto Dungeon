local function equipByType(toolType)
    if not _G.FlyEnabled then return end -- 總開關未開啟不執行
    _G.AutoEquip_SelectedType = toolType -- 更新當前選擇的配置類型

    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return end

    -- 遍歷背包中的所有物品
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        -- 比對 ToolTip 是否符合選擇的配置類型
        if tool:IsA("Tool") and tool.ToolTip == toolType then
            hum:EquipTool(tool) -- 讓角色裝備該武器
            break
        end
    end
end

local function monitorCurrentTool()
    task.spawn(function()
        while true do
            task.wait(0.1) -- 每 0.1 秒檢查一次
            -- 只有總開關開啟才自動切換配置
            if not _G.FlyEnabled then continue end
            -- 大佛模式需先完成變身才能切換
