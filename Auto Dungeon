local function enemiesAlive()
    return EnemyCache.Count > 0
end

local function bossAlive()
    local boss = workspace:FindFirstChild("Boss")
    if not boss then return false end

    local hum = boss:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then return true end

    for _, child in ipairs(boss:GetChildren()) do
        local h = child:FindFirstChildOfClass("Humanoid")
        if h and h.Health > 0 then return true end
    end
    return false
end

local function canTeleport()
    return not enemiesAlive() and not bossAlive()
end

local function getClosestExit()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    local dungeon = map:FindFirstChild("Dungeon")
    if not dungeon then return nil end

    local closest, minDist = nil, math.huge
    for _, f in ipairs(dungeon:GetChildren()) do
        if tonumber(f.Name) then
            local tp = f:FindFirstChild("ExitTeleporter")
            if tp and tp:FindFirstChild("Root") and hrp then
                local d = (tp.Root.Position - hrp.Position).Magnitude
                if d < minDist then
                    minDist = d
                    closest = tp.Root
                end
            end
        end
    end
    return closest
end

local isAutoTeleporting = false
local flyCooldownUntil  = 0

local function teleportToExit(exitRoot)
    if isAutoTeleporting then return end
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then return end

    isAutoTeleporting = true
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    root.CFrame = exitRoot.CFrame
    flyCooldownUntil = os.clock() + 2
    task.wait(0.2)
    if hum and hum.Health > 0 then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end
    isAutoTeleporting = false
end

