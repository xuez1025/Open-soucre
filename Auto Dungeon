local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    _G.FlyEnabled = false
    globalStopTween()
    lastTweenTargetPos = nil
end

local function startFly()
    if flyConn then return end
    flyConn = RunService.Heartbeat:Connect(function()
        local char = player.Character
        local curHRP = char and char:FindFirstChild("HumanoidRootPart")
        local hum    = char and char:FindFirstChildOfClass("Humanoid")

        if not curHRP or not hum or hum.Health <= 0 then
            if _G.isMovementActive then globalStopTween() end
            lastTweenTargetPos = nil
            return
        end

        if os.clock() < flyCooldownUntil then
            if _G.isMovementActive then globalStopTween() end
            lastTweenTargetPos = nil
            return
        end

        -- 使用事件維護的快取清單 不必每幀重掃 Enemies 資料夾
        if os.clock() < nextTargetScan then return end
        nextTargetScan = os.clock() + TargetScanInterval

        local closest, dist = nil, math.huge
        local bossClosest, bossDist = nil, math.huge

        for _, npc in ipairs(EnemyTracker.List) do
            local primary = npc.PrimaryPart
            if not primary then continue end
            local d = (primary.Position - curHRP.Position).Magnitude
            if isLastKillBoss(npc) then
                -- Boss 最後打: 單獨比較 沒有其他小怪時才飛向 Boss
                if d < bossDist then bossDist = d; bossClosest = npc end
            elseif d < dist then
                dist = d; closest = npc
            end
        end

        -- 場上還有其他小怪就以最近小怪為目標 沒有才以 Boss 為目標
        if not closest then closest = bossClosest end

        if closest and closest.PrimaryPart then
            local tpos = Vector3.new(
                closest.PrimaryPart.Position.X,
                closest.PrimaryPart.Position.Y + _G.HoverHeight,
                closest.PrimaryPart.Position.Z
            )

            if _G.MoveMode == "TP" then
                if _G.isMovementActive then globalStopTween() end
                curHRP.CFrame = CFrame.new(tpos)
            elseif _G.MoveMode == "Tween" then
                local targetCFrame = CFrame.new(tpos)
                if not _G.isMovementActive or not lastTweenTargetPos or (lastTweenTargetPos - tpos).Magnitude > 2 then
                    lastTweenTargetPos = tpos
                    globalTweenTo(targetCFrame)
                end
            end
        else
            if _G.MoveMode == "Tween" and _G.isMovementActive then
                globalStopTween()
                lastTweenTargetPos = nil
            end
        end
    end)
end

--大佛
local lastTransformAttempt = 0

local function isBuddhaTransformed()
	local character = LocalPlayer.Character
	if not character then return false end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	
	if humanoid.HipHeight > 5 then
		return true
	end
	
	if character:GetScale() > 1.5 then
		return true
	end
	
	return false
end

local function triggerBuddhaTransform()
	local character = LocalPlayer.Character
	if not character then return end
	
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local buddhaTool = (backpack and backpack:FindFirstChild("Buddha-Buddha")) or character:FindFirstChild("Buddha-Buddha")
	
	if not buddhaTool then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and buddhaTool.Parent ~= character then
		humanoid:EquipTool(buddhaTool)
		task.wait(0.15)
	end
	
	local remoteEvent = buddhaTool:FindFirstChild("RemoteEvent")
	local pos1 = Vector3.new(-339.2312316894531, 198.39112854003906, 20.792236328125)
	local pos2 = Vector3.new(-338.5541076660156, 198.39112854003906, 18.80804443359375)
	
	pcall(function()
		if remoteEvent then
			remoteEvent:FireServer(true)
			remoteEvent:FireServer(pos1)
			remoteEvent:FireServer(pos1)
		end
		
		if humanoid then
			for _, child in ipairs(humanoid:GetChildren()) do
				if child:IsA("RemoteFunction") then
					child:InvokeServer("Z")
				elseif child:IsA("RemoteEvent") then
					child:FireServer("Z")
				end
			end
		end
		
		if remoteEvent then
			remoteEvent:FireServer(pos2)
			remoteEvent:FireServer(false)
		end
	end)
end

task.spawn(function()
	while task.wait(0.3) do
		if not LocalPlayer or not LocalPlayer.Character then continue end
		
		local transformed = isBuddhaTransformed()
		
		if not transformed then
			if _G.BuddhaMode == "大佛模式" and (tick() - lastTransformAttempt > 3) then
				lastTransformAttempt = tick()
				task.spawn(triggerBuddhaTransform)
			end
		end
	end
end)

