local FriendlyMobPrefixes = { "Blank Buddy" }

local function isFriendlyMob(npc)
    if not npc then return true end
    local name = tostring(npc.Name)
    for i = 1, #FriendlyMobPrefixes do
        local prefix = FriendlyMobPrefixes[i]
        if #name >= #prefix and string.sub(name, 1, #prefix) == prefix then
            return true
        end
    end
    local getAttr = npc.GetAttribute
    if type(getAttr) == "function" then
        local ok, val = pcall(getAttr, npc, "Friendly")
        if ok and val == true then return true end
    end
    return false
end

local LastKillBosses = {
    ["Ancient Beast"]  = true,
    ["Kitsune Lord"]   = true,
    ["Gas Knight"]     = true,
    ["Zero"]           = true,
}

local function isLastKillBoss(npc)
    return npc and LastKillBosses[npc.Name] == true
end

local EnemyCache = {
    Count = 0,
    List  = {},
    Boss  = nil,
    NormalCount = 0,
}

local function rebuildEnemyCache()
    local list = {}
    local normalCount = 0
    local bossModel = nil
    local count = 0

    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, npc in ipairs(enemies:GetChildren()) do
            if isFriendlyMob(npc) then continue end
            if npc.Name == "Player" then continue end
            local hum = npc:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                count = count + 1
                list[#list + 1] = npc
                if isLastKillBoss(npc) then
                    if not bossModel then bossModel = npc end
                else
                    normalCount = normalCount + 1
                end
            end
        end
    end

    EnemyCache.Count       = count
    EnemyCache.List        = list
    EnemyCache.NormalCount = normalCount
    EnemyCache.Boss        = bossModel
end

