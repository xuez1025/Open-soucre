-- ═══════════════════════════════════════════
local function FTP_Enable()
    if FTP.Enabled then return end
    FTP.Enabled = true; setPlatformStand(true)
    FTP.Conn = RunService.RenderStepped:Connect(function()
        if not FTP.Enabled or not TargetPlayer or not TargetPlayer.Character then return end
        local pHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local tHRP = TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not pHRP or not tHRP then return end
        local dir = tHRP.Position - pHRP.Position
        if dir.Magnitude > 0 then pHRP.Velocity = dir.Unit * FTP.Speed end
    end)
    FTP.NoclipConn = RunService.Stepped:Connect(function()
        if not FTP.Enabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

local function FTP_Disable()
    FTP.Enabled = false
    if FTP.Conn      then FTP.Conn:Disconnect();      FTP.Conn      = nil end
    if FTP.NoclipConn then FTP.NoclipConn:Disconnect(); FTP.NoclipConn = nil end
    setPlatformStand(false); resetCharPhysics()
end

