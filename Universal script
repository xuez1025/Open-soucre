Tabs.Teleport:Button({
    Title = "儲存目前座標",
    Desc = "將目前位置儲存到選單中並顯示座標",
    Callback = function()
        local player = game.Players.LocalPlayer
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            -- 取得當前位置與座標值
            local currentCFrame = player.Character.HumanoidRootPart.CFrame
            local pos = currentCFrame.Position
            
            -- 取整數或四捨五入（格式化為保留小數點後 1 位）
            local posX = string.format("%.1f", pos.X)
            local posY = string.format("%.1f", pos.Y)
            local posZ = string.format("%.1f", pos.Z)

            -- 【防重複檢測】檢查是否已有極度接近或相同的座標
            for name, savedCFrame in pairs(SavedLocations) do
                -- 距離小於 0.5 單位則判定為同一地點
                if (savedCFrame.Position - pos).Magnitude < 0.5 then
                    WindUI:Notify({
                        Title = "無法儲存",
                        Content = string.format("此位置已存在於【%s】\n座標: (%s, %s, %s)", name, posX, posY, posZ),
                        Duration = 3
                    })
                    return -- 中斷執行，不新增重複座標
                end
            end

            LocationCount = LocationCount + 1
            local locName = "座標" .. LocationCount
            
            -- 存入 Table
            SavedLocations[locName] = currentCFrame
            
            -- 更新 Dropdown 列表
            local dropdownList = {}
            for name, _ in pairs(SavedLocations) do
                table.insert(dropdownList, name)
            end
            
            table.sort(dropdownList, function(a, b)
                local numA = tonumber(a:match("%d+")) or 0
                local numB = tonumber(b:match("%d+")) or 0
                return numA < numB
            end)
            
            -- 刷新 Dropdown
            LocationDropdown:Refresh(dropdownList)
            
            -- 跳出包含 (X, Y, Z) 座標的通知
            WindUI:Notify({
                Title = "儲存成功",
                Content = string.format("%s\n座標: (%s, %s, %s)", locName, posX, posY, posZ),
                Duration = 4
            })
        end
    end
})
