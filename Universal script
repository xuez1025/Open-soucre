})
Tabs.Player:Toggle({
    Title="步行跟隨 (WalkTo)", Desc="跟隨目標玩家移動", Value=false,
    Callback=function(state)
        if not state then walkto = false; return end
        if not TargetPlayer then notify("WalkTo","請先選擇玩家",3); return end
        walkto = true
        task.spawn(function()
            local char = LocalPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            while walkto do
                if TargetPlayer and TargetPlayer.Character and hum then
                    local tc = getRoot(TargetPlayer.Character)
                    if tc then hum:MoveTo(tc.Position) end
                end
                task.wait()
            end
        end)
    end
})
Tabs.Player:Toggle({
    Title="路徑跟隨 (PathfindFollow)", Desc="使用路徑尋找跟隨玩家", Value=false,
    Callback=function(state)
        if not state then walkto = false; return end
        if not TargetPlayer then notify("PathfindFollow","請先選擇玩家",3); return end
        walkto = true
        task.spawn(function()
            local char = LocalPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local path = PathfindingService:CreatePath()
            while walkto do
                if TargetPlayer and TargetPlayer.Character and hum then
                    local tc = getRoot(TargetPlayer.Character)
                    if tc then
                        local ok = pcall(function()
                            path:ComputeAsync(getRoot(char).Position, tc.Position)
                            for _, wp in ipairs(path:GetWaypoints()) do
                                hum:MoveTo(wp.Position)
                                hum.MoveToFinished:Wait()
                            end
                        end)
                        if not ok then hum:MoveTo(tc.Position) end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
})
Tabs.Player:Toggle({
    Title="循環帶走 (LoopBring)", Desc="持續將目標玩家帶到自己身邊", Value=false,
    Callback=function(state)
        if not state then loopbringTargets = {}; return end
        if not TargetPlayer then notify("LoopBring","請先選擇玩家",3); return end
        local pn = TargetPlayer.Name
        if not table.find(loopbringTargets, pn) then table.insert(loopbringTargets, pn) end
        task.spawn(function()
            while table.find(loopbringTargets, pn) do
                local lc = LocalPlayer.Character and getRoot(LocalPlayer.Character)
                local tp = Players:FindFirstChild(pn)
                local tc = tp and tp.Character and getRoot(tp.Character)
                if lc and tc then tc.CFrame = lc.CFrame end
                task.wait(_G.loopbringDelay or 0)
            end
        end)
    end
})
Tabs.Player:Toggle({
    Title="繞行玩家 (Orbit)", Desc="讓角色繞著玩家旋轉", Value=false,
    Callback=function(state)
        if orbitLoop1 then orbitLoop1:Disconnect(); orbitLoop1 = nil end
        if orbitLoop2 then orbitLoop2:Disconnect(); orbitLoop2 = nil end
        if not state then return end
        if not TargetPlayer then notify("Orbit","請先選擇玩家",3); return end
        local rotation = 0
        orbitLoop1 = RunService.Heartbeat:Connect(function()
            pcall(function()
                local spd  = _G.orbitSpeed or 0.5
                local dist = _G.orbitDist  or 6
                rotation = rotation + spd
                local rt = LocalPlayer.Character and getRoot(LocalPlayer.Character)
                local tc = TargetPlayer.Character and getRoot(TargetPlayer.Character)
                if rt and tc then
                    rt.CFrame = CFrame.new(tc.Position) * CFrame.Angles(0, math.rad(rotation), 0) * CFrame.new(dist, 0, 0)
                end
            end)
        end)
        orbitLoop2 = RunService.RenderStepped:Connect(function()
            pcall(function()
                local rt = LocalPlayer.Character and getRoot(LocalPlayer.Character)
                local tc = TargetPlayer.Character and getRoot(TargetPlayer.Character)
                if rt and tc then rt.CFrame = CFrame.new(rt.Position, tc.Position) end
            end)
        end)
    end
})
