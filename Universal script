-- 部件傳送輔助函式
local function findTargetInstance(inputStr)
    if inputStr == "" then return nil end
    if inputStr:lower():match("^game") or inputStr:lower():match("^workspace") then
        local cleanStr = inputStr:gsub('^game:GetService%("([^"]+)"%)', "%1")
        cleanStr = cleanStr:gsub('^game%.', ""):gsub('^workspace', "Workspace")
        local current = game
        for segment in cleanStr:gmatch('[%w_]+') do
            if segment ~= "game" and current then
                current = current:FindFirstChild(segment)
                    or (current == game and pcall(function() return game:GetService(segment) end) and game:GetService(segment))
            end
        end
        if current and current ~= game and current:IsA("BasePart") then return current end
    end
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower() == inputStr:lower() then return v end
    end
    return nil
end

