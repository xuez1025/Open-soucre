Tabs.Teleport:Toggle({
    Title="部件路徑 (PartName)", Desc="點擊部件查看並自動複製完整路徑", Value=false,
    Callback=function(state)
        if partNameConn then partNameConn:Disconnect(); partNameConn = nil end
        if not state then return end
        local function getHierarchy(obj)
            local ancestors, current = {}, obj
            while current and current ~= game do
                table.insert(ancestors, 1, current); current = current.Parent
            end
            if #ancestors == 0 then return obj:GetFullName() end
            local path = 'game:GetService("'..ancestors[1].ClassName..'")'
            for i = 2, #ancestors do
                local name = ancestors[i].Name
                path = path .. (name:match("^[%a_][%w_]*$") and "."..name or '["'..name..'"]')
            end
            return path
        end
        partNameConn = mouse.Button1Down:Connect(function()
            local target = mouse.Target
            if target then
                local ok, path = pcall(getHierarchy, target)
                if not ok then path = target:GetFullName() end
                notify("部件路徑已複製", path, 8)
                if setclipboard then setclipboard(path) end
            end
        end)
    end
})
