        if tHRP then Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHRP.Position) end
    end
    -- ESP 更新
    if ESP_SETTINGS.Master then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hum2  = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp2  = p.Character:FindFirstChild("HumanoidRootPart")
                local head2 = p.Character:FindFirstChild("Head")
                if hum2 and hrp2 and head2 then
                    local bill = head2:FindFirstChild("ESP_Billboard")
                    if bill then
                        local info  = bill:FindFirstChild("Info")
                        local barBG = bill:FindFirstChild("HP_Background")
                        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local display = ""
                        if ESP_SETTINGS.ShowName     then display = p.Name.."\n" end
                        if ESP_SETTINGS.ShowHealth   then display = display.."HP:"..math.floor(hum2.Health).." " end
                        if ESP_SETTINGS.ShowDistance and myHRP then
                            display = display..math.floor((myHRP.Position - hrp2.Position).Magnitude).."m"
                        end
                        if info  then info.Text = display end
                        if barBG then
                            barBG.Visible = ESP_SETTINGS.ShowHealth
                            local fill = barBG:FindFirstChild("HP_Fill")
                            if fill then
                                local ratio = math.clamp(hum2.Health / hum2.MaxHealth, 0, 1)
                                fill.Size = UDim2.new(ratio, 0, 1, 0)
                                fill.BackgroundColor3 = ratio > 0.6 and Color3.fromRGB(0,255,0)
                                    or ratio > 0.3 and Color3.fromRGB(255,255,0)
                                    or Color3.fromRGB(255,0,0)
                            end
                        end
                        if ESP_SETTINGS.TeamColor then
                            local hl = p.Character:FindFirstChild("ESP_Highlight")
                            if hl then
                                hl.OutlineColor = p.TeamColor.Color
                                hl.FillColor    = p.TeamColor.Color
                            end
                        end
                    else
                        createESP(p)
                    end
                    updateTracer(p, hrp2)
                end
            end
        end
    end
end)

