local ServerCore = {}
function ServerCore:TeleportToServer(jobId)
    if not jobId or jobId == "" then return end
    task.spawn(function()
        pcall(function() TeleportService:TeleportToPlaceInstance(PlaceId, jobId, LocalPlayer) end)
    end)
end

function ServerCore:FindAndHop(mode)
    task.spawn(function()
        local url  = "https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
        local ok, resp = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
        if not (ok and resp and resp.data) then notify("伺服器跳轉","找不到其他伺服器",3); return end
        local valid = {}
        for _, s in ipairs(resp.data) do
            if s.id ~= JobId and s.playing < s.maxPlayers then
                table.insert(valid, {id=s.id, count=s.playing})
            end
        end
        if #valid == 0 then notify("伺服器跳轉","沒有可用的伺服器",3); return end
        local targetId
        if mode == "small" then
            table.sort(valid, function(a,b) return a.count < b.count end)
            targetId = valid[1].id
        else
            targetId = valid[math.random(1,#valid)].id
        end
        self:TeleportToServer(targetId)
    end)
end

