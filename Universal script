Tabs.Player:Button({
    Title="脈衝傳送 (PulseTP)", Desc="短暫傳送到玩家旁後返回",
    Callback=function()
        if not TargetPlayer then notify("PulseTP","請先選擇玩家",3); return end
        task.spawn(function()
            local lc = LocalPlayer.Character and getRoot(LocalPlayer.Character)
            local tc = TargetPlayer.Character and getRoot(TargetPlayer.Character)
            if not lc or not tc then return end
            local oldPos = lc.CFrame
            lc.CFrame = tc.CFrame + Vector3.new(3,1,0)
            task.wait(_G.pulseTPSecs or 2)
            lc.CFrame = oldPos
        end)
    end
})
Tabs.Player:Slider({
