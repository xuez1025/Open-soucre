Tabs.Player:Toggle({
    Title="循環加刪朋友 (Loop Friend/Unfriend)", Desc="持續向選定玩家發送並刪除好友請求", Default=false,
    Callback=function(Value)
        loopFriendship = Value
        if not loopFriendship then notify("朋友","已停止循環操作",3); return end
        task.spawn(function()
            while loopFriendship do
                if TargetPlayer then
                    LocalPlayer:RequestFriendship(TargetPlayer)
                    notify("朋友","已發送好友請求",1)
                    task.wait(0.5)
                    if not loopFriendship then break end
                    LocalPlayer:RevokeFriendship(TargetPlayer)
                    notify("朋友","已刪除好友關係",1)
                    task.wait(0.5)
                else
                    task.wait(1)
                end
            end
        end)
    end
})
