local function SaveOriginalAppearance()
    local char = LocalPlayer.Character
    if not char or #OriginalCharacterParts > 0 then return end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants")
        or v:IsA("ShirtGraphic") or v:IsA("BodyColors") then
            table.insert(OriginalCharacterParts, v:Clone())
        end
    end
    local face = char:FindFirstChild("Head") and char.Head:FindFirstChild("face")
    if face and face:IsA("Decal") then
        table.insert(OriginalCharacterParts, face:Clone())
    end
end

local function ClearCurrentAppearance(char)
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants")
        or v:IsA("ShirtGraphic") or v:IsA("BodyColors") then v:Destroy() end
    end
    local face = char:FindFirstChild("Head") and char.Head:FindFirstChild("face")
    if face then face:Destroy() end
end

local function ApplyAppearance()
    if not TargetPlayer then notify("變身","請先選擇玩家",3); return end
    local char  = LocalPlayer.Character
    local tchar = TargetPlayer.Character
    if not char or not tchar then notify("變身","目標角色不存在",3); return end
    SaveOriginalAppearance()
    ClearCurrentAppearance(char)
    for _, v in ipairs(tchar:GetChildren()) do
        if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
            v:Clone().Parent = char
        end
    end
    local tbc = tchar:FindFirstChildWhichIsA("BodyColors")
    if tbc then
        local bc = Instance.new("BodyColors")
        bc.HeadColor3      = tbc.HeadColor3
        bc.LeftArmColor3   = tbc.LeftArmColor3
        bc.LeftLegColor3   = tbc.LeftLegColor3
        bc.RightArmColor3  = tbc.RightArmColor3
        bc.RightLegColor3  = tbc.RightLegColor3
        bc.TorsoColor3     = tbc.TorsoColor3
        bc.Parent          = char
    end
    local thead = tchar:FindFirstChild("Head")
    if thead then
        local tf   = thead:FindFirstChild("face")
        local head = char:FindFirstChild("Head")
        if tf and head then tf:Clone().Parent = head end
    end
    notify("變身","已套用 " .. TargetPlayer.Name .. " 的外觀", 3)
end

local function RestoreOriginalAppearance()
    local char = LocalPlayer.Character
    if not char or #OriginalCharacterParts == 0 then
        notify("恢復外觀","沒有儲存的外觀資料",3); return
    end
    ClearCurrentAppearance(char)
    for _, item in ipairs(OriginalCharacterParts) do
        local newItem = item:Clone()
        if newItem:IsA("BodyColors") or newItem:IsA("Accessory")
        or newItem:IsA("Shirt") or newItem:IsA("Pants") or newItem:IsA("ShirtGraphic") then
            newItem.Parent = char
        elseif newItem:IsA("Decal") and newItem.Name == "face" then
            local head = char:FindFirstChild("Head")
            if head then newItem.Parent = head end
        end
    end
    notify("恢復外觀","已恢復原本外觀",3)
end

