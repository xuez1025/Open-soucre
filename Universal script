Tabs.Combat:Section({ Title="防虛空" })
Tabs.Combat:Toggle({
    Title="防虛空 (AntiVoid)", Desc="落入虛空時安全傳回上方並重置速度", Value=false,
    Callback=function(state)
        if antivoidloop then antivoidloop:Disconnect(); antivoidloop = nil end
        if not state then return end
        antivoidloop = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Position.Y <= (OrgDestroyHeight + 50) then
                hrp.Velocity        = Vector3.zero
                hrp.RotVelocity     = Vector3.zero
                hrp.CFrame          = hrp.CFrame + Vector3.new(0, 100, 0)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
            end
        end)
    end
})
Tabs.Combat:Button({
    Title="假墜落 (Fakeout)", Desc="短暫傳送到虛空再返回",
    Callback=function()
        local char = LocalPlayer.Character
        local rt   = char and getRoot(char)
        if not rt then return end
        local oldpos = rt.CFrame
        local wasAV  = antivoidloop ~= nil
        if antivoidloop then antivoidloop:Disconnect(); antivoidloop = nil end
        Workspace.FallenPartsDestroyHeight = 0/1/0
        rt.CFrame = CFrame.new(Vector3.new(0, OrgDestroyHeight - 25, 0))
        task.wait(1)
        rt.CFrame = oldpos
        Workspace.FallenPartsDestroyHeight = OrgDestroyHeight
        if wasAV then
            antivoidloop = RunService.Stepped:Connect(function()
                local c = LocalPlayer.Character
                local h = c and c:FindFirstChild("HumanoidRootPart")
                if h and h.Position.Y <= OrgDestroyHeight + 25 then
                    h.Velocity = h.Velocity + Vector3.new(0, 250, 0)
                end
            end)
        end
        notify("Fakeout","已完成",2)
    end
})
Tabs.Combat:Section({ Title="甩飛" })
Tabs.Combat:Toggle({
    Title="甩飛 (Fling)", Desc="對碰到的玩家施加旋轉力", Value=false,
    Callback=function(state)
        if state then
            if flinging then return end
            local char = LocalPlayer.Character
            if not char or not getRoot(char) then return end
            flinging = true
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5) end
            end
            setNoclipState(true); task.wait(0.1)
            local bambam = Instance.new("BodyAngularVelocity")
            bambam.Name            = "IY_Fling"
            bambam.AngularVelocity = Vector3.new(0, 99999, 0)
            bambam.MaxTorque       = Vector3.new(0, math.huge, 0)
            bambam.P               = math.huge
            bambam.Parent          = getRoot(char)
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false; v.Massless = true; v.Velocity = Vector3.zero
                end
            end
            local hum2 = char:FindFirstChildOfClass("Humanoid")
            if hum2 then
                flingDied = hum2.Died:Connect(function()
                    flinging = false; setNoclipState(false)
                    if flingDied then flingDied:Disconnect(); flingDied = nil end
                end)
            end
            flingLoop = task.spawn(function()
                while flinging and char and getRoot(char) do
                    bambam.AngularVelocity = Vector3.new(0, 99999, 0)
                    task.wait(0.2)
                    bambam.AngularVelocity = Vector3.zero
                    task.wait(0.1)
                end
            end)
        else
            flinging = false; setNoclipState(false)
            if flingDied then flingDied:Disconnect(); flingDied = nil end
            local char = LocalPlayer.Character
            if not char then return end
            local rt = getRoot(char)
            if rt then
                for _, v in ipairs(rt:GetChildren()) do
                    if v.Name == "IY_Fling" then v:Destroy() end
                end
            end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
                    p.CanCollide = true; p.Massless = false
                end
            end
        end
    end
})
Tabs.Combat:Toggle({
    Title="步行甩飛 (WalkFling)", Desc="行走時甩飛其他玩家", Value=false,
    Callback=function(state)
        if state then
            if walkflinging then return end
            walkflinging = true; setNoclipState(true)
            task.spawn(function()
                while walkflinging do
                    local char = LocalPlayer.Character
                    local rt   = char and getRoot(char)
                    if rt then
                        local vel = rt.Velocity
                        rt.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                        RunService.RenderStepped:Wait()
                        if rt.Parent then rt.Velocity = vel end
                        RunService.Stepped:Wait()
                        if rt.Parent then rt.Velocity = vel + Vector3.new(0, 0.1, 0) end
                    end
                    RunService.Heartbeat:Wait()
                end
            end)
        else
            walkflinging = false; setNoclipState(false)
        end
    end
})
Tabs.Combat:Button({
    Title="隱形甩飛 (InvisFling)", Desc="啟用隱形甩飛",
    Callback=function()
        local char = LocalPlayer.Character
        char:FindFirstChildOfClass("Humanoid"):SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        local prt = Instance.new("Model"); prt.Parent = char
        local z1  = Instance.new("Part"); z1.Name = "Torso"; z1.CanCollide = false; z1.Anchored = true
        local z2  = Instance.new("Part"); z2.Name = "Head";  z2.Parent = prt; z2.Anchored = true; z2.CanCollide = false
        local z3  = Instance.new("Humanoid"); z3.Name = "Humanoid"; z3.Parent = prt
        z1.Position = Vector3.new(0, 9999, 0)
        LocalPlayer.Character = prt
        task.wait(3)
        LocalPlayer.Character = char
