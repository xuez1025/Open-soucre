Tabs.Settings:Toggle({
    Title="客戶端防踢 (AntiKick)", Desc="防止LocalScript踢出玩家", Value=false,
    Callback=function(state)
        if not state then return end
        if not hookmetamethod then notify("AntiKick","不支援(缺少hookmetamethod)",3); return end
        if hookfunction then hookfunction(LocalPlayer.Kick, function() end) end
        local old; old = hookmetamethod(game, "__namecall", function(self, ...)
            if self == LocalPlayer and getnamecallmethod and getnamecallmethod():lower() == "kick" then return end
            return old(self, ...)
        end)
        notify("AntiKick","客戶端防踢已啟用",3)
    end
})
