    r.CanCollide = false
    if isHitboxEnabled then
        r.Size        = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
        r.Transparency = _G.hitboxTrans
    else
        r.Size        = Vector3.new(2, 2, 1)
        r.Transparency = 1
    end
end

