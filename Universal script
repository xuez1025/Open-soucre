Tabs.Player:Toggle({
    Title="傳送到玩家 (TP)", Desc="持續傳送到目標玩家", Value=false,
    Callback=function(state)
        if TPConnection then TPConnection:Disconnect(); TPConnection = nil end
        if not state then return end
