Tabs.Player:Toggle({
    Title="坐在玩家頭上 (HeadSit)", Default=false,
    Callback=function(Value)
        if Value then
            if not TargetPlayer or not TargetPlayer.Character then
                notify("HeadSit","請先選擇有效的玩家",3); return
            end
            if headSitLoop then headSitLoop:Disconnect(); headSitLoop = nil end
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Sit = true end
            headSitLoop = RunService.Heartbeat:Connect(function()
                pcall(function()
                    if not TargetPlayer or not TargetPlayer.Character then
                        if headSitLoop then headSitLoop:Disconnect(); headSitLoop = nil end; return
                    end
                    local tc = getRoot(TargetPlayer.Character)
                    local lc = LocalPlayer.Character and getRoot(LocalPlayer.Character)
                    if tc and lc then
                        lc.CFrame = tc.CFrame * CFrame.new(0, 1.6, 0.4)
                    end
                end)
            end)
        else
            if headSitLoop then headSitLoop:Disconnect(); headSitLoop = nil end
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Sit = false end
        end
    end
})
Tabs.Player:Button({
    Title="恐嚇玩家 (Scare)", Desc="短暫出現在玩家面前並持續鎖定",
    Callback=function()
        if not TargetPlayer then notify("Scare","請先選擇玩家",3); return end
        task.spawn(function()
            local lc = LocalPlayer.Character and getRoot(LocalPlayer.Character)
            local tc = TargetPlayer.Character and getRoot(TargetPlayer.Character)
            if not lc or not tc then return end
            local old       = lc.CFrame
            local duration  = 0.5
            local startTime = os.clock()
            local connection
            connection = RunService.Heartbeat:Connect(function()
                if lc and tc and lc.Parent and tc.Parent and (os.clock() - startTime) < duration then
                    lc.CFrame = CFrame.new((tc.CFrame + tc.CFrame.LookVector * 2).Position, tc.Position)
                else
                    connection:Disconnect()
                end
            end)
            task.wait(duration)
            if connection.Connected then connection:Disconnect() end
            if lc and lc.Parent then lc.CFrame = old end
        end)
    end
})
