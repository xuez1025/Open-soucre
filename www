local function sfxClear()
	for _,p in ipairs(screenFxState.particles) do if p.object then p.object:Destroy() end end
	screenFxState.particles={}
	if screenFxState.overlay then screenFxState.overlay:Destroy(); screenFxState.overlay=nil end
end
local function sfxSet(mode)
	if screenFxState.mode==mode then return end
	sfxClear(); screenFxState.mode=mode or 'none'
	if screenFxState.mode=='none' then return end
	local overlay=ins('Frame'); overlay.Name='SFXOverlay'; overlay.Parent=screenFxGui
	overlay.Size=UDim2.new(1,0,1,0); overlay.BackgroundTransparency=1
	overlay.BorderSizePixel=0; overlay.ClipsDescendants=true; overlay.ZIndex=0
	screenFxState.overlay=overlay
	local amount=(mode=='rain' and 70) or (mode=='snow' and 36) or (mode=='winter' and 42) or (mode=='autumn' and 30) or (mode=='spring' and 34) or 0
	for _ = 1,amount do
		local p={x=mrandom(),y=-mrandom(),speed=0.15+mrandom()*0.3,drift=0.04+mrandom()*0.10,phase=mrandom()*6.28,rotation=mrandom(0,360)}
		local o=ins('Frame'); o.BackgroundTransparency=0.15; o.BorderSizePixel=0
		o.AnchorPoint=Vector2.new(0.5,0.5); o.ZIndex=1
		if mode=='rain' then
			o.Size=UDim2.new(0,mrandom(1,2),0,mrandom(14,28)); o.BackgroundColor3=Color3.fromRGB(170,215,255)
			o.BackgroundTransparency=0.35; p.speed=0.9+mrandom()*0.7; p.drift=0; p.rotation=0
		elseif mode=='snow' or mode=='winter' then
			local s=mrandom(3,8); o.Size=UDim2.new(0,s,0,s); o.BackgroundColor3=Color3.fromRGB(235,248,255)
			local c=ins('UICorner'); c.CornerRadius=UDim.new(1,0); c.Parent=o
			p.speed=0.08+mrandom()*0.16; p.drift=0.08+mrandom()*0.16
		elseif mode=='autumn' then
			o.Size=UDim2.new(0,mrandom(6,11),0,mrandom(10,17))
			o.BackgroundColor3=({Color3.fromRGB(185,55,25),Color3.fromRGB(230,105,25),Color3.fromRGB(245,170,45)})[mrandom(1,3)]
			o.Rotation=mrandom(0,360); p.speed=0.10+mrandom()*0.22; p.drift=0.12+mrandom()*0.22
		elseif mode=='spring' then
			o.Size=UDim2.new(0,mrandom(5,10),0,mrandom(4,8))
			o.BackgroundColor3=({Color3.fromRGB(255,170,205),Color3.fromRGB(255,235,245),Color3.fromRGB(155,220,125)})[mrandom(1,3)]
			local c=ins('UICorner'); c.CornerRadius=UDim.new(1,0); c.Parent=o
			o.Rotation=mrandom(0,360); p.speed=0.09+mrandom()*0.20; p.drift=0.10+mrandom()*0.20
		end
		o.Parent=overlay; p.object=o
		table.insert(screenFxState.particles,p)
	end
end

rs.RenderStepped:Connect(function(dt)
	if not screenFxState.overlay or not screenFxState.overlay.Parent then return end
	for _,p in ipairs(screenFxState.particles) do
		p.y+=p.speed*dt
		if screenFxState.mode~='rain' then p.x+=math.sin(tick()+p.phase)*p.drift*dt end
		p.rotation+=(screenFxState.mode=='rain' and 0 or 45*dt)
		if p.y>1.12 then p.y=-0.12; p.x=mrandom() end
		if p.x>1.12 then p.x=-0.12 elseif p.x<-0.12 then p.x=1.12 end
		p.object.Position=UDim2.new(p.x,0,p.y,0); p.object.Rotation=p.rotation
	end
end)

