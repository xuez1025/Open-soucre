local queue_func = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)

local function EnableAutoExecute()
    if not queue_func then
        return false
    end
    if getgenv().UniversalHubAutoExecute then
        return true
    end
    getgenv().UniversalHubAutoExecute = true
    if typeof(writefile) == "function" then
        writefile("UniversalHub.file", "true")
    end
    queue_func(ScriptLoadstring)
    return true
end

local function DisableAutoExecute()
    getgenv().UniversalHubAutoExecute = nil
    if typeof(isfile) == "function" and typeof(delfile) == "function" and isfile("UniversalHub.file") then
        delfile("UniversalHub.file")
    end
end

if _G.AutoExecute then
    EnableAutoExecute()
end

