local function getButtonLabel(element)
	if not element or not element.ElementFrame then return nil end
	for _, descendant in ipairs(element.ElementFrame:GetDescendants()) do
		if descendant:IsA("TextButton") and descendant.Name == "Button" then
			return descendant:FindFirstChildWhichIsA("TextLabel")
		end
	end
	return nil
end

local SHADER_ON_COLOR = Color3.fromRGB(80, 255, 120)

local function refreshShaderState()
	for _, btn in ipairs(shaderButtons) do
		local element = btn.Element
		if element then
			if element._SetActive then
				element._SetActive(_G[btn.Flag], true)
			end
			local label = getButtonLabel(element)
			if label then
				if btn.OriginalColor == nil then
					btn.OriginalColor = label.TextColor3
				end
				if _G[btn.Flag] then
					label.Text = "已開啟"
					label.TextColor3 = SHADER_ON_COLOR
				else
					label.Text = "切換"
					label.TextColor3 = btn.OriginalColor
				end
			end
		end
	end
end

local function applyShader(key, effect, flag)
	for _, btn in ipairs(shaderButtons) do
		if btn.Flag ~= flag then
			_G[btn.Flag] = false
		end
	end
	_G[flag] = true
	activeShaderKey = key or "game"
	activeEffect = effect or "none"
	local settings = weatherSettings[activeShaderKey] or weatherSettings.game
	_G.PShadeColorCorrectionEnabled = settings.cor
	_G.PShadeBloomEnabled = settings.bl
	_G.PShadeSunRaysEnabled = settings.rays
	_G.PShadeLensFlareEnabled = settings.flare
	wl.cor, wl.bl, wl.rays, wl.sflare = settings.cor, settings.bl, settings.rays, settings.flare
	local skyKeys = { ["預設"]="default", ["清晨"]="morning", ["正午"]="midday", ["下午"]="afternoon", ["傍晚"]="evening", ["雨天"]="rain", ["多雲"]="cloudy" }
	_G.PShadeSkybox = settings.sky
	if skybox[skyKeys[settings.sky]] then cussky = skybox[skyKeys[settings.sky]] end
	if key == "game" then
		light = default_light
	else
		light = shader[key] or default_light
	end
	sfxSet(activeEffect)
	refreshShaderState()
end

