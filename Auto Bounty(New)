function StartServerHop()
    if getgenv().IsServerHopping == true then
        return
    end

    getgenv().IsServerHopping = true
    getgenv().ShuttingDown = true

    if ServerHopConn then
        task.cancel(ServerHopConn)
        ServerHopConn = nil
    end

    PlaceId = game.PlaceId
    JobId = game.JobId

    -- 取得伺服器列表（排除已滿伺服器）
    local function GetServers(cursor)
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
        if cursor then
            url = url .. "&cursor=" .. cursor
        end

        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            return result
        end
        return nil
    end

    local function FindInPage(data, strict)
        if not data then return nil end
        for _, server in ipairs(data) do
            if type(server) == "table" and server.id and server.playing and server.maxPlayers then
                local id = tostring(server.id)
                local playing = tonumber(server.playing) or 0
                local maxPlayers = tonumber(server.maxPlayers) or 12
                if id ~= tostring(JobId) and not table.find(_G.JumpHistory, id) and playing < maxPlayers then
                    if strict then
                        if playing >= 7 and playing <= 10 then
                            return id
                        end
                    else
                        if playing >= 2 then
                            return id
                        end
                    end
                end
            end
        end
        return nil
    end

    startJobId = game.JobId

    HOP_TIMEOUT = 1
    HOP_FAIL_WAIT = 0.5

    ServerHopConn = task.spawn(function()
        while getgenv().IsServerHopping do
            if game.JobId ~= startJobId then
                getgenv().IsServerHopping = false
                break
            end

            local success, err = pcall(function()
                local serverData = GetServers()
                local targetServerId = nil

                if serverData then
                    targetServerId = FindInPage(serverData.data, true)

                    if not targetServerId and serverData.nextPageCursor then
                        local nextPageData = GetServers(serverData.nextPageCursor)
                        if nextPageData then
                            targetServerId = FindInPage(nextPageData.data, true)
                        end
                    end

                    if not targetServerId then
                        targetServerId = FindInPage(serverData.data, false)
                    end
                end

                if targetServerId then

                    local confirmResult = WaitHopAllowed()
                    if confirmResult ~= "ok" then
                        if confirmResult == "danger" then
                            getgenv().IsServerHopping = false
                            getgenv().HopInterruptedByDanger = true
                        end
                        return
                    end

                    table.insert(_G.JumpHistory, targetServerId)
                    if #_G.JumpHistory > 100 then
                        table.remove(_G.JumpHistory, 1)
                    end

                    pcall(function()
                        local ServerBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
                        if ServerBrowser then
                            ServerBrowser:InvokeServer("teleport", targetServerId)
                        else
                            TeleportService:TeleportToPlaceInstance(PlaceId, targetServerId, LocalPlayer)
                        end
                    end)

                    local hopDeadline = os.clock() + HOP_TIMEOUT
                    while getgenv().IsServerHopping and game.JobId == startJobId and os.clock() < hopDeadline do
                        task.wait(0.1)
                    end

                    if game.JobId ~= startJobId then
                        getgenv().IsServerHopping = false
                        return
                    end
                else
                    _G.JumpHistory = {}
                end
            end)

            if not success then
                warn(L("跳服搜尋出錯: ") .. tostring(err))
            end

            if not getgenv().IsServerHopping then
                break
            end

            task.wait(HOP_FAIL_WAIT)
        end
    end)
end

