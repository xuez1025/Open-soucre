HOP_CONFIRM_DELAY = 5
function ConfirmHopSafe()
    local deadline = os.clock() + HOP_CONFIRM_DELAY
    while os.clock() < deadline do
        if not getgenv().IsServerHopping then
            return "stopped"
        end
        if GetCombatStatus() == "BountyAtRisk" then
            return "danger"
        end
        if HasQualifyingPlayer() then
            return "player"
        end
        task.wait(0.2)
    end
    return "ok"
end

function WaitHopAllowed()
    if not WaitNoQualifyingPlayers() then
        return "stopped"
    end
    return ConfirmHopSafe()
end

