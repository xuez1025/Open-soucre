function GetPredictedPosition2(plr)
    if not plr or not plr.Character then return nil, Vector3.zero end

    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, Vector3.zero end

    local targetPos = hrp.Position
    local now = tick()
    local vel = Vector3.zero

    local sample = _G.FTP2_RJR_Sample[plr]
    if sample then
        local dt = now - sample.t
        if dt > 0 and dt < 1 and (targetPos - sample.pos).Magnitude <= RJR_MAX_SAMPLE_JUMP then
            vel = (targetPos - sample.pos) / dt
        end
    end

    if not sample or now - sample.t >= RJR_SAMPLE_INTERVAL then
        _G.FTP2_RJR_Sample[plr] = { pos = targetPos, t = now }
    end

    return targetPos + vel * RJR_PREDICT_LEAD, vel
end

function GetNearestPlayer()
    local nearestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if not myHRP then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
