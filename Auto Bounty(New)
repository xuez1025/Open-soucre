                    local okPick, dest = pcall(PortalTravel.Pick, targetGoal)
                    if okPick and dest then
                        _G.FTP2_Transit = nil
                        _G.FTP2_TransitTarget = portalTarget
                        -- 使用 Portal 期間鎖定移動，傳送完成後才恢復
                        _G.FTP2_PortalLock = true
                        local portalOk = PortalTravel.Try(targetGoal, function()
                            return not _G.FTP2_Enabled or _G.FTP2_CurrentTarget ~= portalTarget or _G.FTP2_TargetLostSince ~= nil
                        end)
                        _G.FTP2_PortalLock = false
                        portalUsed = true
                        -- 傳送失敗：暫緩再試，先讓一般飛行/中轉接手
                        if not portalOk then
                            _G.FTP2_NextPortalAt = now + 5
                        end
                    end
                end
            end

            if not portalUsed and _G.FTP2_CurrentTarget ~= _G.FTP2_TransitTarget then
                _G.FTP2_TransitTarget = _G.FTP2_CurrentTarget
                _G.FTP2_Transit = nil
                local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local tgH = _G.FTP2_CurrentTarget.Character and _G.FTP2_CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                if myH and tgH then
                    local waypoints = PlanTransitRoute(myH.Position, tgH.Position)
                    if #waypoints > 0 then
                        _G.FTP2_Transit = { waypoints = waypoints, index = 1, waiting = false, waitUntil = 0 }
                    end
                end
            end
        else
            _G.FTP2_Transit = nil
            _G.FTP2_TransitTarget = nil
        end

        local lockNow = os.clock()
        if _G.FTP2_CurrentTarget then
            if _G.FTP2_CurrentTarget ~= oldTarget then
                _G.FTP2_TargetLockTime = 0
                _G.FTP2_TargetLockTick = lockNow
            end

            local dt = lockNow - (_G.FTP2_TargetLockTick or lockNow)
            _G.FTP2_TargetLockTick = lockNow
            if not lowHpLock and IsLockCountingActive(_G.FTP2_CurrentTarget) then
                _G.FTP2_TargetLockTime = _G.FTP2_TargetLockTime + dt
            end

            if not lowHpLock and _G.FTP2_TargetLockTime >= _G.FTP2_TimeoutLimit then
                local cooldown = _G.FTP2_TempSkipCooldown or 120
                _G.FTP2_TempSkip[_G.FTP2_CurrentTarget] = os.clock() + cooldown
                if WindUI then
                    WindUI:Notify({ Title = L("自動列賞"), Content = L("鎖定時間超過 ") .. tostring(_G.FTP2_TimeoutLimit) .. L("秒，暫時跳過玩家 ") .. tostring(cooldown) .. L("秒: ") .. _G.FTP2_CurrentTarget.Name, duration = 3 })
                end
                _G.FTP2_CurrentTarget = nil
                _G.FTP2_TargetLockTime = 0
                _G.FTP2_TargetLockTick = lockNow
            end
        else
            _G.FTP2_TargetLockTime = 0
            _G.FTP2_TargetLockTick = lockNow
        end

        if _G.FTP2_CurrentTarget then
            if _G.FTP2_PortalLock then
                -- 使用 Portal 期間暫停移動，直到傳送完成
                StopMove()
            elseif _G.FTP2_TargetLostSince then
                FleeUpLogic()
            elseif _G.FTP2_Transit then
                RunTransit()
            else
                FlyToTargetLogic2(_G.FTP2_CurrentTarget)
            end
        elseif _G.FTP2_PortalLock then
            StopMove()
        else
            FleeUpLogic()

            if os.clock() - _G.FTP2_StartTime >= 5 then
                CheckAndNotifyCombatStatus()
            end
        end
    end)
end

