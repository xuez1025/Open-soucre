-- 中轉路線規劃：以 Dijkstra 最短路徑自動判斷任意段數（不限兩段）
-- 節點為每個傳送門，權重為實際飛行距離；起點為 fromPos，終點為 targetPos
function PlanTransitRoute(fromPos, targetPos)
    local portals = GetWorldTransitPoints()
    if #portals == 0 then return {} end

    -- 直接飛往目標（不使用任何傳送門）的基準成本
    local bestCost = (targetPos - fromPos).Magnitude

    local n = #portals
    -- dist[i]：從 fromPos 走到「第 i 個傳送門出口(dest)」的最短飛行距離
    local dist = {}
    local prev = {}
    local visited = {}

    for i = 1, n do
        dist[i] = (portals[i].point - fromPos).Magnitude
    end

    for _ = 1, n do
        -- 取出尚未拜訪、距離最小的節點
        local u, uCost = nil, math.huge
        for i = 1, n do
            if not visited[i] and dist[i] < uCost then
                u, uCost = i, dist[i]
            end
        end
        if not u then break end
        visited[u] = true

        -- 放鬆相鄰節點：由 u 出口飛往其他傳送門入口
        for v = 1, n do
            if not visited[v] and v ~= u then
                local nd = uCost + (portals[u].dest - portals[v].point).Magnitude
                if nd < dist[v] then
                    dist[v] = nd
                    prev[v] = u
                end
            end
        end
    end

    -- 找出「經由某個傳送門出口後直飛目標」成本最低的路徑
    local bestLast = nil
    for i = 1, n do
        local total = dist[i] + (portals[i].dest - targetPos).Magnitude
        if total < bestCost then
            bestCost = total
            bestLast = i
        end
    end

    if not bestLast then
        return {}
    end

    -- 回溯重建路徑（段數由資料自動決定，可為任意段）
    local chain = {}
    local cur = bestLast
    while cur do
        table.insert(chain, 1, cur)
        cur = prev[cur]
    end

    local waypoints = {}
    for _, idx in ipairs(chain) do
        table.insert(waypoints, portals[idx].point)
    end
    return waypoints
end

