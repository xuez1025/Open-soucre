function GetFastTargets()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    local targets = {}
    local myPos   = root.Position

    local sourceFolders = {
        Workspace:FindFirstChild("Enemies"),
        Workspace:FindFirstChild("NPCs"),
        Workspace:FindFirstChild("Characters")
    }

    local function checkModel(model)
        if not model or model == char then return end
        local tRoot = model:FindFirstChild("HumanoidRootPart")
        local tHum  = model:FindFirstChild("Humanoid")
        if tRoot and tHum and tHum.Health > 0 then
            local dist = (tRoot.Position - myPos).Magnitude
            if dist <= _G.AttackDistance then
                table.insert(targets, {
                    Model = model,
                    Root  = tRoot,
                    Head  = model:FindFirstChild("Head") or tRoot
                })
            end
        end
    end

    for _, folder in ipairs(sourceFolders) do
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                if #targets >= FastSettings.MaxTargets then break end
                checkModel(model)
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if #targets >= FastSettings.MaxTargets then break end
        -- 黑名單／V4 狀態的玩家不攻擊
        if p ~= LocalPlayer and p.Character then
            local tempBlackUntil = _G.FTP2_TempBlacklist[p]
            local isBlacklisted = _G.FTP2_SkipList[p] or _G.FTP2_PermanentSkip[p]
                or (tempBlackUntil and os.clock() < tempBlackUntil) or IsPlayerV4(p)
            if not isBlacklisted then
                checkModel(p.Character)
            end
        end
    end

    return targets
end

function PerformAttack(forceTargets)
    local char = LocalPlayer.Character
    if not char then return end
    local hasTool = char:FindFirstChildOfClass("Tool") or char:FindFirstChild("EquippedWeapon")
    if not hasTool then return end

    -- 攻擊延遲：未達間隔時間則不攻擊
    if not CanAttackNow() then return end

    local targets = forceTargets or GetFastTargets()
    if #targets == 0 then return end

    FastState.LastAttackTime = tick()

    local mainTarget = targets[1]
    local hitList    = {}
    for i, target in ipairs(targets) do
        table.insert(hitList, {target.Model, target.Root})
    end

    local fakeHash = tostring(LocalPlayer.UserId):sub(2,4) .. tostring(math.random(10000, 99999))

