    FoundRemote = nil,
    FoundRemoteId = nil,
    LastAttackTime = 0
}

-- 攻擊延遲：元件必須遵守 AttackInterval，避免手動與自動攻擊同時觸發
function GetAttackInterval()
    return math.max(tonumber(_G.FastAttackSpeed) or FastSettings.AttackInterval or 0.01, 0.01)
end

function CanAttackNow()
    return (tick() - (FastState.LastAttackTime or 0)) >= GetAttackInterval()
end

if FastSettings.AutoScanRemotes then
    task.spawn(function()
        local folders = {
            ReplicatedStorage:FindFirstChild("Util"),
            ReplicatedStorage:FindFirstChild("Common"),
            ReplicatedStorage:FindFirstChild("Remotes"),
            ReplicatedStorage:FindFirstChild("Assets"),
            ReplicatedStorage:FindFirstChild("FX")
        }
        local function checkChild(child)
            if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                FastState.FoundRemoteId = child:GetAttribute("Id")
                FastState.FoundRemote = child
            end
        end
        for _, folder in ipairs(folders) do
            if folder then
                for _, child in ipairs(folder:GetChildren()) do checkChild(child) end
                folder.ChildAdded:Connect(checkChild)
            end
