function GuitarShoot(pos, guitar)
    if not pos then return false end
    if _G.GuitarM1Bypass then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            -- 優先找名稱為空白的 RemoteFunction（模糊匹配）
            local blanks, all = {}, {}
            for _, v in ipairs(hum:GetChildren()) do
                if v:IsA("RemoteFunction") then
                    all[#all + 1] = v
                    if v.Name:match("^%s*$") then blanks[#blanks + 1] = v end
                end
            end
            local list = #blanks > 0 and blanks or all
            if #list > 0 then
                for _, rf in ipairs(list) do
                    if not GuitarBypassBusy[rf] then
                        GuitarBypassBusy[rf] = true
                        task.spawn(function()
                            pcall(function() rf:InvokeServer("TAP", pos) end)
                            GuitarBypassBusy[rf] = nil
                        end)
                    end
                end
                return true
            end
        end
        -- fallback：吉他工具（背包內即可，不需裝備）上的 RemoteEvent
        guitar = guitar or FindSoulGuitarTool()
        local remote = guitar and guitar:FindFirstChild("RemoteEvent")
        if remote and remote:IsA("RemoteEvent") then
            local ok = pcall(function() remote:FireServer("TAP", pos) end)
            if ok then return true end
        end
    end
    -- 再 fallback：BindableFunction
    local events = ReplicatedStorage:FindFirstChild("Events")
    local shoot = events and events:FindFirstChild("ShootSoulGuitar")
    if shoot and shoot:IsA("BindableFunction") then
        local ok = pcall(function() shoot:Invoke(pos) end)
        if ok then return true end
    end
    return false
end

