function UpdateDescentState(hrp, descending)
    local state = FTP2_DescendState
    local now = os.clock()

    if not hrp then
        ResetDescentState()
        return 1
    end

    if state.hrp ~= hrp then
        state.hrp = hrp
        state.time = 0
        state.lastY = nil
        state.lastClock = nil
        return 1
    end

    local lastY = state.lastY
    local lastClock = state.lastClock
    state.lastY = hrp.Position.Y
    state.lastClock = now

    if not lastY or not lastClock then return 1 end

    local dt = now - lastClock
    if dt <= 0 then return 1 end

    local dropRate = (lastY - hrp.Position.Y) / dt

    if descending and dropRate >= FTP2_DESCENT_MIN_RATE then
        state.time = math.min(state.time + dt, FTP2_DESCENT_ACCEL_TIME)
    else
        state.time = 0
    end

    local progress = state.time / FTP2_DESCENT_ACCEL_TIME
    return 1 + (FTP2_DESCENT_MAX_MULT - 1) * (progress * progress)
end

function MoveTo(pos)
    if not pos then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    SetupFTPFlightComponents(hrp)

    local dir = pos - hrp.Position
    if dir.Magnitude > 0.1 then
        local mult = UpdateDescentState(hrp, dir.Y < 0)
        _G.FTP_FlightVelocity.VectorVelocity = dir.Unit * (_G.FTP2_FlySpeed or 170) * mult
    else
        _G.FTP_FlightVelocity.VectorVelocity = Vector3.zero
        ResetDescentState()
    end
end

function StopMove()
    ResetDescentState()
    if _G.FTP_FlightVelocity then
        _G.FTP_FlightVelocity.VectorVelocity = Vector3.zero
    end
end

function RunTransit()
    local transit = _G.FTP2_Transit
    if not transit then return end

    local char = LocalPlayer.Character
    local myHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    if transit.waiting then
        StopMove()
        if os.clock() >= transit.waitUntil then
            transit.waiting = false
            transit.index = transit.index + 1
            if transit.index > #transit.waypoints then
                _G.FTP2_Transit = nil
            end
        end
        return
    end

    local wp = transit.waypoints[transit.index]
    if not wp then
        _G.FTP2_Transit = nil
        return
    end

    MoveTo(wp)
    if (wp - myHRP.Position).Magnitude <= TRANSIT_ARRIVE_DIST then
        transit.waiting = true
        transit.waitUntil = os.clock() + TRANSIT_WAIT_TIME
        StopMove()
    end
end

