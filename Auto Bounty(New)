function SetupFTPFlightComponents(hrp)
    if _G.FTP_FlightVelocity and _G.FTP_FlightVelocity.Parent == hrp
       and _G.FTP_FlightAttachment and _G.FTP_FlightAttachment.Parent == hrp then
        return
    end

    ClearFTPFlightComponents()

    local att = Instance.new("Attachment")
    att.Name = "FruitM1_FlightAttachment"
    att.Parent = hrp
    _G.FTP_FlightAttachment = att

    local lv = Instance.new("LinearVelocity")
    lv.Name = "FruitM1_FlightVelocity"
    lv.MaxForce = math.huge
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = Vector3.zero
    lv.Attachment0 = att
    lv.Parent = hrp
    _G.FTP_FlightVelocity = lv

    local totalMass = 0
    local char = hrp.Parent
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part.Massless then
                totalMass = totalMass + part:GetMass()
            end
        end
    end

    local vf = Instance.new("VectorForce")
    vf.Name = "FruitM1_AntiGravity"
    vf.ApplyAtCenterOfMass = true
    vf.Attachment0 = att
    vf.Force = Vector3.new(0, totalMass * Workspace.Gravity, 0)
    vf.Parent = hrp
    _G.FTP_FlightForce = vf
end

