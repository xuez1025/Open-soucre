L = function(text)
    if type(text) ~= "string" or _G.Language ~= "English" then return text end
    local state = TranslationState
    if not state.Index then
        state.Index = {}
        for zh, en in pairs(state.Translations.English) do state.Index[#state.Index + 1] = { zh = zh, en = en } end
        table.sort(state.Index, function(x, y) return #x.zh > #y.zh end)
        state.Cache = {}
    end
    local cached = state.Cache[text]
    if cached ~= nil then return cached end
    local exact = state.Translations.English[text]
    local result = exact or text
    if not exact then
        for _, entry in ipairs(state.Index) do
            if entry.zh ~= "" and string.find(result, entry.zh, 1, true) then
                local escaped = entry.zh:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")
                result = string.gsub(result, escaped, function() return entry.en end)
            end
        end
    end
    state.Cache[text] = result
    return result
end

TranslationState.RefreshVisibleLanguage = function()
    local reverse = TranslationState.ReverseIndex
    if not reverse then
        reverse = {}
        for zh, en in pairs(TranslationState.Translations.English) do
            if type(en) == "string" and en ~= "" then reverse[#reverse + 1] = { en = en, zh = zh } end
        end
        table.sort(reverse, function(a, b) return #a.en > #b.en end)
        TranslationState.ReverseIndex = reverse
    end
    local function convert(text)
        if type(text) ~= "string" then return text end
        if _G.Language == "English" then return L(text) end
        local result = text
        for _, entry in ipairs(reverse) do
            if string.find(result, entry.en, 1, true) then
                local escaped = entry.en:gsub("([^%w])", "%%%1")
                result = string.gsub(result, escaped, function() return entry.zh end)
            end
        end
        return result
    end
    local roots = {}
    pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
    pcall(function() roots[#roots + 1] = LocalPlayer:FindFirstChildOfClass("PlayerGui") end)
    for _, root in ipairs(roots) do
        if root then
            for _, gui in ipairs(root:GetDescendants()) do
                if gui:IsA("ScreenGui") then
                    local name = string.lower(gui.Name)
                    if string.find(name, "wind", 1, true) or string.find(name, "xu", 1, true) then
                        for _, item in ipairs(gui:GetDescendants()) do
                            if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
                                pcall(function() item.Text = convert(item.Text) end)
                                if item:IsA("TextBox") then pcall(function() item.PlaceholderText = convert(item.PlaceholderText) end) end
                            end
                        end
                    end
                end
            end
        end
    end
end

