function PortalTravel.Pick(goal)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil, "no character/root" end
	if (goal.Position - hrp.Position).Magnitude <= 1500 then return nil, "trip shorter than 1500" end
	local tool = FruitM1.GetFruit()
	if not tool or (tool.Name ~= "Portal" and tool.Name ~= "Portal-Portal") then return nil, "Portal tool not found" end
	local level = tool:FindFirstChild("Level")
	if not level or level.Value < 200 then return nil, "Portal mastery below 200" end
	local seaIndex = PortalTravel.GetSeaIndex()
	if not seaIndex then return nil, "unknown sea" end
	local points = PortalTravel.Points[seaIndex]
	local destination, distance = nil, math.huge
	for _, point in ipairs(points or {}) do
		local remaining = (goal.Position - point[2]).Magnitude
		if remaining < 3000 and remaining + 500 < (goal.Position - hrp.Position).Magnitude and remaining < distance then
			destination, distance = point, remaining
		end
	end
	if not destination then return nil, "no useful Gateway destination" end
	return destination, tool, char
end

function PortalTravel.Try(goal, cancelled)
	if PortalTravel.Busy then return false end
	PortalTravel.Goal = goal.Position
	if not PortalTravel.Allowed(goal) then return PortalTravel.Status("blocked: toggle or seated") end
	if tick() - PortalTravel.At < 5 then return false end
	local destination, tool, char = PortalTravel.Pick(goal)
	if not destination then return PortalTravel.Status(tool) end
	PortalTravel.Busy, PortalTravel.At, PortalTravel.Destination = true, tick(), destination[1]
	PortalTravel.Status("equipping Portal: " .. destination[1])
	local previous = char:FindFirstChildOfClass("Tool")

	local function active()
		return LocalPlayer.Character == char and PortalTravel.Allowed(goal) and not (cancelled and cancelled())
	end

	local ok, result = pcall(function()
		if not active() then return false end
		StopMove()
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return PortalTravel.Status("no humanoid") end
		if tool.Parent ~= char then hum:EquipTool(tool) end
		local equipDeadline = tick() + 0.6
		while char:FindFirstChildOfClass("Tool") ~= tool and tick() < equipDeadline do
			if not active() then return PortalTravel.Status("equip failed or cancelled") end
			task.wait(0.05)
		end
		if char:FindFirstChildOfClass("Tool") ~= tool then return PortalTravel.Status("equip failed") end
		local gui = LocalPlayer:FindFirstChild("PlayerGui")
		local main = gui and gui:FindFirstChild("Main")
		if not main then return PortalTravel.Status("Main GUI missing") end
		local button, deadline = nil, tick() + 1.5
		repeat
			if not active() then return PortalTravel.Status("cancelled while loading skill UI") end
			local skills = main:FindFirstChild("Skills")
			local panel = skills and (skills:FindFirstChild(tool.Name) or skills:FindFirstChild("Portal-Portal"))
			button = panel and panel:FindFirstChild("C")
			if not button then task.wait(0.1) end
		until button or tick() >= deadline
		if not button then return PortalTravel.Status("Portal C skill UI missing") end
		-- 技能就緒判斷（Cooldown 已跑完且等級足夠）
		local cdFrame = button:FindFirstChild("Cooldown", true)
		if cdFrame and cdFrame.Size.X.Scale > 0 then return PortalTravel.Status("Portal C cooldown/locked") end
		local startHrp = char:FindFirstChild("HumanoidRootPart")
		local start = startHrp and startHrp.Position
		if not start then return false end
		PortalTravel.Status("opening Gateway")
		SkillPressKey(Enum.KeyCode.C, 0.05)
		local gateway, gwDeadline = nil, tick() + 2
		repeat
			if not active() then return false end
			for _, name in ipairs({ "Gateway", "Gateway3", "Gateway2" }) do
				local frame = main:FindFirstChild(name)
				if frame and frame:IsA("GuiObject") and frame.Visible then gateway = frame; break end
			end
			if not gateway then task.wait(0.1) end
		until gateway or tick() >= gwDeadline
		if not gateway then return PortalTravel.Status("Gateway did not open") end
		local content = gateway:FindFirstChild("MainContent")
		local scrolling = content and content:FindFirstChild("ScrollingFrame")
		local entry = scrolling and scrolling:FindFirstChild(destination[1])
		if not entry or not entry:IsA("GuiButton") or not entry.Visible then return PortalTravel.Status("Gateway entry missing/hidden: " .. destination[1]) end
		local fired = false
		if type(firesignal) == "function" then fired = pcall(firesignal, entry.MouseButton1Click)
		elseif type(getconnections) == "function" then
			for _, connection in ipairs(getconnections(entry.MouseButton1Click)) do
				if type(connection.Function) == "function" then local good = pcall(connection.Function); fired = fired or good end
			end
		end
		if not fired then return PortalTravel.Status("Gateway click unavailable") end
		deadline = tick() + 3
		repeat
			if not active() then return false end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return false end
			if (root.Position - start).Magnitude > 500 and (root.Position - destination[2]).Magnitude <= 700 then PortalTravel.Status("arrived: " .. destination[1]); return true end
			task.wait(0.1)
		until tick() >= deadline
		return PortalTravel.Status("Gateway clicked but no movement")
	end)
	if not ok then PortalTravel.Status("error: " .. tostring(result)) end
	pcall(function()
		if previous and previous.Parent and LocalPlayer.Character == char and active() then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum:EquipTool(previous) end
		end
	end)
	PortalTravel.Busy = false
	return ok and result == true
end

