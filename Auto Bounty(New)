function FlyToTargetLogic2(plr)
    if not plr or not plr.Character then return end

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tgHRP = plr.Character:FindFirstChild("HumanoidRootPart")
    if not (myHRP and tgHRP) then return end

    local off = Vector3.new(_G.G_TeleportOffsetX, _G.G_TeleportOffsetY, _G.G_TeleportOffsetZ)
    local dist = (myHRP.Position - tgHRP.Position).Magnitude

    if dist <= RJR_SNAP_DIST then
        StopMove()
        myHRP.AssemblyLinearVelocity = Vector3.zero
        local now = tick()
        if now - FTP2_LastSnapTime >= RJR_SNAP_INTERVAL then
            FTP2_LastSnapTime = now
            local _, vel = GetPredictedPosition2(plr)
            pcall(function()
                myHRP.CFrame = tgHRP.CFrame + vel * RJR_PREDICT_LEAD + off
            end)
        end
        return
    end

    MoveTo(tgHRP.Position + off)

    local lookAt = Vector3.new(tgHRP.Position.X, myHRP.Position.Y, tgHRP.Position.Z)
    if (lookAt - myHRP.Position).Magnitude > 0.1 then
        myHRP.CFrame = CFrame.new(myHRP.Position, lookAt)
    end
