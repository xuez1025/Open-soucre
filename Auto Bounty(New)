function EvaluateTarget(plr)
    if not plr or plr == LocalPlayer then
        return false, "self"                    -- 自己
    end

    if _G.FTP2_SkipList[plr] then
        return false, "manual_skip"             -- 永久跳過
    end

    if _G.FTP2_PermanentSkip[plr] then
        return false, "permanent_blacklist"     -- 永久黑名單：互相擊殺達 3/3
    end

    local tempBlackUntil = _G.FTP2_TempBlacklist[plr]
    if tempBlackUntil then
        if os.clock() < tempBlackUntil then
            return false, "temp_blacklist"      -- 暫時黑名單中（V4 狀態），尚未到期
        end
        _G.FTP2_TempBlacklist[plr] = nil        -- 已到期：恢復為可選目標
    end

    local tempUntil = _G.FTP2_TempSkip[plr]
    if tempUntil then
        if os.clock() < tempUntil then
            return false, "temp_skip"           -- 暫時跳過中（鎖定逾時），尚未到期
        end
        _G.FTP2_TempSkip[plr] = nil             -- 已到期：恢復為可選目標
    end

    local char = plr.Character
    if not char then
        return false, "no_character"            -- 角色尚未載入
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        return false, "no_hrp_humanoid"         -- 缺少 HumanoidRootPart／Humanoid
    end

    if hum.Health <= 0 then
        return false, "dead"                    -- 已死亡
    end

    if hrp.Position.Y < -500 then
        return false, "underwater"              -- 掉入深海（浮出後即可再次成為目標）
    end

    if plr:GetAttribute("IslandRaiding") == true then
        return false, "island_raiding"          -- 正在打島
    end

    if plr:GetAttribute("InSafeZone") == true then
        return false, "safe_zone_attr"          -- 玩家屬性標記在安全區
    end

    if IsPlayerV4(plr) then
        AddBlacklist(plr, true, _G.FTP2_V4BlacklistCooldown)
        return false, "v4_state"                -- V4 狀態中
    end

    if char:FindFirstChildOfClass("ForceField") then
        return false, "forcefield"              -- 無敵保護罩
    end

    local combatLockTarget = (plr == _G.FTP2_CurrentTarget) and IsInCombatState()
    if not combatLockTarget then
        if IsInSafeZone(plr) then
            return false, "safe_zone_pos"       -- 位置落在安全區範圍
        end
    end

    if plr:GetAttribute("PvpDisabled") == true then
        return false, "pvp_disabled"            -- PVP 已關閉
    end

    local myTeam = LocalPlayer.Team
    local tgTeam = plr.Team
    if myTeam and tgTeam and myTeam.Name == "Marines" and tgTeam.Name == "Marines" then
        return false, "same_team"               -- 同隊（同為海軍）
    end

    if IsPlayerAlly(plr) then
        return false, "ally"                    -- 盟友
    end

    local myLv = GetLevel(LocalPlayer)
    local tgLv = GetLevel(plr)
    if not myLv or not tgLv then
        return false, "level_unknown"           -- 等級無法取得
    end
    if math.abs(myLv - tgLv) > 550 then
        return false, "level_gap"               -- 等級差超過 550
    end

    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myHRP and (myHRP.Position - hrp.Position).Magnitude > (_G.FTP2_MaxLockDistance or 20000) then
        return false, "too_far"
    end

    return true, nil
end

