-- ==================== 核心判定與超高精度牆壁檢測邏輯 ====================
local function GetCharacterTargetPart(character, partName)
  if not character then return nil end
  if partName == "Head" then
    return character:FindFirstChild("Head")
  else
    return character:FindFirstChild("HumanoidRootPart") 
      or character:FindFirstChild("UpperTorso") 
      or character:FindFirstChild("Torso")
  end
end

-- 超高精度單一部位可見度檢測 (結合 5 點多重多角度採樣演算法，已優化效能)
local function IsPartVisible(targetPart)
  if not targetPart or not targetPart.Parent then return false end

  local rayOrigin = Camera.CFrame.Position
  local targetPos = targetPart.Position
  local partSize = targetPart.Size * 0.4 -- 取部位的邊緣安全範圍

  local sampleOffsets = {
    Vector3.zero,
    Vector3.new(0, partSize.Y, 0),
    Vector3.new(0, -partSize.Y, 0),
    Vector3.new(partSize.X, 0, 0),
    Vector3.new(-partSize.X, 0, 0)
  }

  local ignoreList = {Camera}
  if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end

  for _, offset in ipairs(sampleOffsets) do
    local currentTargetPos = targetPos + offset
    local rayDirection = currentTargetPos - rayOrigin

    SharedRaycastParams.FilterDescendantsInstances = ignoreList

    local result = Workspace:Raycast(rayOrigin, rayDirection, SharedRaycastParams)

    local isPointVisible = false
    while result do
      if result.Instance and targetPart.Parent and result.Instance:IsDescendantOf(targetPart.Parent) then
        isPointVisible = true
        break
      end
      
      if result.Instance and (result.Instance.Transparency >= 0.25 or not result.Instance.CanCollide or result.Instance:IsA("Accessory") or result.Instance:IsA("Clothing")) then
        table.insert(ignoreList, result.Instance)
        SharedRaycastParams.FilterDescendantsInstances = ignoreList
        result = Workspace:Raycast(rayOrigin, rayDirection, SharedRaycastParams)
      else
        break
      end
    end

    if isPointVisible then
      return true
    end
  end

  return false
end

-- 超高精度：檢測目標角色的「任意部位」（全骨架感應）是否露出一絲一毫
local function IsAnyPartVisible(character)
  if not character then return false end
  
  local partsToCheck = {
    "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso",
    "LeftHand", "RightHand", "LeftArm", "RightArm", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
    "LeftFoot", "RightFoot", "LeftLeg", "RightLeg", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"
  }

  for _, partName in ipairs(partsToCheck) do
    local part = character:FindFirstChild(partName)
    if part and IsPartVisible(part) then
      return true
    end
  end

  return false
end

local function IsValidTarget(player, part)
  if not player or not player.Character then return false end
  local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
  if not humanoid or humanoid.Health <= 0 then return false end

  -- 隊伍檢測
  if TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
    return false
  end

  -- 牆壁遮擋檢測 (自瞄使用)
  if WallCheck and not IsPartVisible(part) then
    return false
  end

  return true
end

local function GetPredictedPosition(part)
  if Prediction and part then
    local velocity = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    return part.Position + (velocity * PredictionAmount)
  end
  return part.Position
end

-- 取得所有可瞄準的有效玩家列表
local function GetValidPlayersList()
  local list = {}
  for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer and player.Character then
      local targetPart = GetCharacterTargetPart(player.Character, AimPart)
      if targetPart and IsValidTarget(player, targetPart) then
        table.insert(list, player)
      end
    end
  end
  return list
end

-- 尋找目標（優先使用手動指定的 LockedPlayer，若無則鎖定最近者）
local function GetClosestTarget()
  local mousePos = UserInputService:GetMouseLocation()
  
  if LockedPlayer and LockedPlayer.Character then
    local targetPart = GetCharacterTargetPart(LockedPlayer.Character, AimPart)
    if targetPart and IsValidTarget(LockedPlayer, targetPart) then
      local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
      if onScreen then
        local distance = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
        return targetPart, distance
      end
    else
      LockedPlayer = nil
    end
  end

  local closestTarget = nil
  local shortestDistance = math.huge

  if CurrentTargetPart and CurrentTargetPart.Parent then
    local player = Players:GetPlayerFromCharacter(CurrentTargetPart.Parent)
    if player and IsValidTarget(player, CurrentTargetPart) then
      local pos, onScreen = Camera:WorldToViewportPoint(CurrentTargetPart.Position)
      if onScreen then
        local distance = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
        return CurrentTargetPart, distance
      end
    end
  end

  for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer and player.Character then
      local targetPart = GetCharacterTargetPart(player.Character, AimPart)
      if targetPart and IsValidTarget(player, targetPart) then
        local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
          local screenPos = Vector2.new(pos.X, pos.Y)
          local distance = (screenPos - mousePos).Magnitude
          if distance < shortestDistance then
            shortestDistance = distance
            closestTarget = targetPart
          end
        end
      end
    end
  end
  return closestTarget, shortestDistance
end

-- 切換目標按鍵邏輯 (E 鍵下一個 / Q 鍵上一個 / R 鍵取消手動鎖定)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
  if gameProcessed then return end
  
  if input.KeyCode == Enum.KeyCode.E then
    local validPlayers = GetValidPlayersList()
    if #validPlayers > 0 then
      local currentIndex = 0
      for i, p in ipairs(validPlayers) do
        if p == LockedPlayer then currentIndex = i break end
      end
      local nextIndex = (currentIndex % #validPlayers) + 1
      LockedPlayer = validPlayers[nextIndex]
    end
  elseif input.KeyCode == Enum.KeyCode.Q then
    local validPlayers = GetValidPlayersList()
    if #validPlayers > 0 then
      local currentIndex = 1
      for i, p in ipairs(validPlayers) do
        if p == LockedPlayer then currentIndex = i break end
      end
      local prevIndex = currentIndex - 1
      if prevIndex < 1 then prevIndex = #validPlayers end
      LockedPlayer = validPlayers[prevIndex]
    end
  elseif input.KeyCode == Enum.KeyCode.R then
    LockedPlayer = nil
  end
end)

local function IsAimingKeyPressed()
  if not HoldToAim then return true end
  if AimKey.EnumType == Enum.UserInputType then
    return UserInputService:IsMouseButtonPressed(AimKey)
  elseif AimKey.EnumType == Enum.KeyCode then
    return UserInputService:IsKeyDown(AimKey)
  end
  return false
end

-- ==================== 主循環 (RenderStepped) ====================
RunService.RenderStepped:Connect(function(dt)
  local origin = UserInputService:GetMouseLocation()
  local clockTime = os.clock()

  -- 尋找最近目標
  local targetPart, targetDistance = GetClosestTarget()
  CurrentTargetPart = targetPart

  if targetPart and targetPart.Parent then
    _G.TargetPlayer = Players:GetPlayerFromCharacter(targetPart.Parent)
  else
    _G.TargetPlayer = nil
  end

  -- Camlock 視角鎖定邏輯
  if _G.CamlockEnabled and _G.TargetPlayer and _G.TargetPlayer.Character and LocalPlayer.Character and IsAimingKeyPressed() then
    local camera = Workspace.CurrentCamera
    local targetHRP = GetCharacterTargetPart(_G.TargetPlayer.Character, AimPart)

    if targetHRP and IsValidTarget(_G.TargetPlayer, targetHRP) then
      local lockPosition = GetPredictedPosition(targetHRP)
      camera.CFrame = CFrame.new(camera.CFrame.Position, lockPosition)
    else
      _G.TargetPlayer = nil
      CurrentTargetPart = nil
    end
  end

  -- ==================== ESP 繪製 (修復定位與視角計算) ====================
  for player, esp in pairs(ESPDrawings) do
    local showESP = false

    if ESPEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
      local char = player.Character
      local hrp = char.HumanoidRootPart
      local hum = char:FindFirstChildOfClass("Humanoid")

      if hum.Health > 0 then
        local isTeam = (player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team)
        
        if not (TeamCheck and isTeam) then
          local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

          if onScreen then
            -- 計算角色頭頂與腳底的世界與螢幕座標
            local head = char:FindFirstChild("Head")
            local headCFrame = head and head.CFrame or hrp.CFrame * CFrame.new(0, 1.5, 0)
            local headPos, headOnScreen = Camera:WorldToViewportPoint(headCFrame.Position + Vector3.new(0, 0.7, 0))
            local legPos, legOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))

            if headOnScreen or legOnScreen then
              showESP = true
              
              -- 全部位詳細可見度檢測（頭、手臂、腳等露出即判定可見）
              local isAnyVisible = IsAnyPartVisible(char)

              -- 顏色判定：隊友藍色 / 可見綠色 / 完全遮擋紅色
              local espColor
              if isTeam then
                espColor = Color3.fromRGB(0, 200, 255)
              elseif isAnyVisible then
                espColor = Color3.fromRGB(50, 255, 50)
              else
                espColor = Color3.fromRGB(255, 50, 50)
              end

              -- 精確高度與寬度計算
              local height = math.abs(headPos.Y - legPos.Y)
              local width = height * 0.65

              -- 修復：將方框頂部直接對齊頭部座標 headPos.Y，精確包裹角色
              esp.Box.Size = Vector2.new(width, height)
              esp.Box.Position = Vector2.new(hrpPos.X - width / 2, headPos.Y)
              esp.Box.Color = espColor
              esp.Box.Visible = true

              -- 修復：將資訊文字固定於頭頂上方，保持整潔排版
              local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
              esp.Text.Text = string.format("%s\n[%d HP] [%dm]", player.Name, math.floor(hum.Health), dist)
              esp.Text.Position = Vector2.new(hrpPos.X, headPos.Y - 30)
              esp.Text.Color = espColor
              esp.Text.Visible = true
            end
          end
        end
      end
    end

    if not showESP then
      esp.Box.Visible = false
      esp.Text.Visible = false
    end
  end

  -- ==================== 射線與特效繪製 ====================
  if ShowLine and targetPart then
    local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
    if onScreen then
      local targetScreenPos = Vector2.new(pos.X, pos.Y)
      local lineVector = targetScreenPos - origin
      local clampedDist = math.clamp(targetDistance, 10, 300)
      local distFactor = (clampedDist - 10) / (300 - 10)

      local distanceBaseRadius = math.clamp(38 * (1 - distFactor * 0.5), 14, 45)
      local glowThicknessScale = 1 + (distFactor * 0.5)
      local particleSpeedMultiplier = 1.2 + ((1 - distFactor) * 1.8)

      local baseHue = (clockTime * LaserPulseSpeed * 0.06) % 1
      local pulseWave = math.sin(clockTime * LaserPulseSpeed)
      local cosPulse = math.cos(clockTime * LaserPulseSpeed * 1.4)
      local alphaPulse = 0.85 + (pulseWave * 0.15)

      local coreColor, glowColorBase
      if RainbowSnapLine then
        coreColor = Color3.fromRGB(255, 255, 255)
        glowColorBase = Color3.fromHSV(baseHue, 0.85, 1)
      else
        local lerpFactor = (pulseWave + 1) / 2
        glowColorBase = BaseLaserColor:Lerp(Color3.fromRGB(180, 240, 255), lerpFactor * 0.4)
        coreColor = Color3.fromRGB(245, 255, 255)
      end

      local glowMultipliers = {14.0, 9.0, 5.5, 3.2, 2.0, 1.3, 0.8}
      local alphaMultipliers = {0.03, 0.06, 0.12, 0.22, 0.38, 0.60, 0.85}

      for i, glow in ipairs(LaserGlowLayers) do
        glow.Visible = true; glow.From = origin; glow.To = targetScreenPos
        glow.Thickness = SnapLineThickness * glowMultipliers[i] * glowThicknessScale
        glow.Color = RainbowSnapLine and Color3.fromHSV((baseHue + (i * 0.02)) % 1, 0.8, 1) or glowColorBase
        glow.Transparency = alphaMultipliers[i] * alphaPulse
      end

      SnapLineCore.Visible = true; SnapLineCore.From = origin; SnapLineCore.To = targetScreenPos
      SnapLineCore.Color = coreColor; SnapLineCore.Thickness = SnapLineThickness * 0.8; SnapLineCore.Transparency = 1.0

      for i, bead in ipairs(LaserBeads) do
        local speed = (0.4 + (i * 0.1)) * particleSpeedMultiplier
        local offset = (i - 1) * (1 / #LaserBeads)
        local progress = (clockTime * speed + offset) % 1
        bead.Visible = true; bead.Position = origin + (lineVector * progress)
        local beadPulse = math.sin(clockTime * 20 + i) * 0.5 + 1
        bead.Radius = SnapLineThickness * (1.1 + beadPulse * 0.6)
        bead.Color = RainbowSnapLine and Color3.fromHSV((baseHue + progress * 0.3) % 1, 0.5, 1) or Color3.fromRGB(255, 255, 255)
        bead.Transparency = 0.95 * math.sin(progress * math.pi)
      end

      local currentRadius = distanceBaseRadius + (pulseWave * 2.5)

      TargetLockRings[1].Visible = true; TargetLockRings[1].Position = targetScreenPos; TargetLockRings[1].Radius = currentRadius
      TargetLockRings[1].Color = glowColorBase; TargetLockRings[1].Transparency = 0.9

      TargetLockRings[2].Visible = true; TargetLockRings[2].Position = targetScreenPos; TargetLockRings[2].Radius = currentRadius * 1.55 + (cosPulse * 4)
      TargetLockRings[2].Color = RainbowSnapLine and Color3.fromHSV((baseHue + 0.12) % 1, 0.85, 1) or glowColorBase
      TargetLockRings[2].Transparency = 0.4 * alphaPulse

      TargetLockRings[3].Visible = true; TargetLockRings[3].Position = targetScreenPos; TargetLockRings[3].Radius = math.max(3, currentRadius * 0.4 - (pulseWave * 1.5))
      TargetLockRings[3].Color = Color3.fromRGB(255, 255, 255); TargetLockRings[3].Transparency = 0.95

      TargetLockRings[4].Visible = true; TargetLockRings[4].Position = targetScreenPos; TargetLockRings[4].Radius = currentRadius * 2.2
      TargetLockRings[4].Color = glowColorBase; TargetLockRings[4].Transparency = 0.15

      TargetLockCenterDot.Visible = true; TargetLockCenterDot.Position = targetScreenPos; TargetLockCenterDot.Radius = math.clamp(distanceBaseRadius * 0.12, 1.8, 3.5)
      TargetLockCenterDot.Color = RainbowSnapLine and Color3.fromHSV(baseHue, 1, 1) or Color3.fromRGB(255, 255, 255)
      TargetLockCenterDot.Transparency = 1.0

      local boxSize = currentRadius * 1.3
      local bracketLen = boxSize * 0.45
      local rotation = clockTime * (1.5 + (1 - distFactor))
      local corners = { Vector2.new(-boxSize, -boxSize), Vector2.new(boxSize, -boxSize), Vector2.new(boxSize, boxSize), Vector2.new(-boxSize, boxSize) }

      for i = 1, 4 do
        local offset = corners[i]
        local cosR, sinR = math.cos(rotation), math.sin(rotation)
        local rotX = offset.X * cosR - offset.Y * sinR
        local rotY = offset.X * sinR + offset.Y * cosR
        local cornerPos = targetScreenPos + Vector2.new(rotX, rotY)
        local dirX = (i == 1 or i == 4) and 1 or -1
        local dirY = (i == 1 or i == 2) and 1 or -1

        local lineH = TargetCornerBrackets[(i - 1) * 2 + 1]
        lineH.Visible = true; lineH.From = cornerPos; lineH.To = cornerPos + Vector2.new(dirX * bracketLen * cosR, dirX * bracketLen * sinR)
        lineH.Color = glowColorBase; lineH.Transparency = 0.85

        local lineV = TargetCornerBrackets[(i - 1) * 2 + 2]
        lineV.Visible = true; lineV.From = cornerPos; lineV.To = cornerPos + Vector2.new(-dirY * bracketLen * sinR, dirY * bracketLen * cosR)
        lineV.Color = glowColorBase; lineV.Transparency = 0.85
      end
    else
      HideAllLaserDrawings()
    end
  else
    HideAllLaserDrawings()
  end
end)
