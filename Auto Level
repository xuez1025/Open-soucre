local CachedBossLevel = nil
local CachedBossEntry = nil

local function GetCurrentBossEntry()
    local data = LocalPlayer:FindFirstChild("Data")
    local levelStat = data and data:FindFirstChild("Level")
    if not levelStat then return nil end

    local level = levelStat.Value
    if CachedBossEntry and level == CachedBossLevel then
        return CachedBossEntry
    end

    local list = LevelBosses[CurrentWorld]
    local best = nil
    if list then
        for _, entry in ipairs(list) do
            if level >= entry.MinLevel then
                best = entry
            else
                break
            end
        end
    end

    if best then
        local mobEntry = GetCurrentLevelEntry()
        if not mobEntry or best.MinLevel < mobEntry.MinLevel then
            best = nil
        end
    end

    CachedBossLevel = level
    CachedBossEntry = best
    return best
end

local function MatchBossScore(enemyName, bossNames)
    local score = 0
    for _, bossName in ipairs(bossNames) do
        if enemyName == bossName then
            return 3
        elseif string.sub(enemyName, 1, #bossName) == bossName then
            score = math.max(score, 2)
        elseif string.find(enemyName, bossName, 1, true) then
            score = math.max(score, 1)
        end
    end
    return score
end

local function FindBossEnemy(bossEntry)
    if not bossEntry then return nil end
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    local best, bestScore = nil, 0
    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            local score = MatchBossScore(enemy.Name, bossEntry.Enemies)
            if score > bestScore then
                best = enemy
                bestScore = score
            end
        end
    end
    return best
end

local function GetActiveQuestEntry()
    local bossEntry = GetCurrentBossEntry()
    if bossEntry and FindBossEnemy(bossEntry) then
        return bossEntry
    end
    return GetCurrentLevelEntry()
end

local function HasActiveQuest()
    local main = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("Main")
    local questFrame = main and main:FindFirstChild("Quest")
    return questFrame ~= nil and questFrame.Visible == true
end

local LastAcceptedQuest = nil
local LastQuestAccept = 0

local function AcceptQuest(entry, force)
    if not entry or not entry.Quest then return end
    if os.clock() - LastQuestAccept < 1 then return end
    if not force and HasActiveQuest() then return end
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(entry.Quest))
        LastAcceptedQuest = tostring(entry.Quest[2]) .. "|" .. tostring(entry.Quest[3])
        LastQuestAccept = os.clock()
    end)
end

local function MaintainQuest(entry)
    if not entry or not entry.Quest then return end
    local questKey = tostring(entry.Quest[2]) .. "|" .. tostring(entry.Quest[3])
    if LastAcceptedQuest ~= questKey or not HasActiveQuest() then
        AcceptQuest(entry, true)
    end
end

