                        local nextIndex = curIndex % #entry.Positions + 1
                        entry.CoordIndex = nextIndex
                        local npos = entry.Positions[nextIndex]
                        tpos = Vector3.new(npos.X, npos.Y + _G.HoverHeight, npos.Z)
                    end
                else
                    entry.Waiting = false
                end
            end
        end

        if tpos then
