local function SaberGoto(targetCFrame, timeout)
    local deadline = tick() + (timeout or 180)

    while tick() < deadline do
        if not SaberShouldRun() then return false end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            globalStopTween()
            lastTweenTargetPos = nil
            task.wait(0.5)
            continue
        end

        local dist = (targetCFrame.Position - hrp.Position).Magnitude
        if dist < 6 then
            return true
        end

        if os.clock() < _G.Fruit_TeleportPauseUntil then
            task.wait(0.1)
            continue
        end

        local entrance = dist > 300 and GetBestEntrance(hrp.Position, targetCFrame.Position) or nil
        if entrance and TryTeleportEntrance(entrance, hrp) then
            task.wait(2) -- 等待傳送門完成
            continue
        end

        local headingToTarget = _G.isMovementActive and _G.ActiveTween ~= nil
            and lastTweenTargetPos ~= nil
            and (lastTweenTargetPos - targetCFrame.Position).Magnitude < 5

        if not headingToTarget then
            lastTweenTargetPos = targetCFrame.Position
            globalTweenTo(CFrame.new(targetCFrame.Position))
        end

        task.wait(0.2)
    end

    return false
end

