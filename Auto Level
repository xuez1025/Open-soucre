--自動前往二海 (Sea 2 Travel)
local function Sea2Goto(targetCFrame, timeout)
    local deadline = tick() + (timeout or 180)

    while tick() < deadline do
        if not Sea2ShouldRun() then return false end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            globalStopTween()
            lastTweenTargetPos = nil
            task.wait(0.5)
            continue
        end

        local dist = (targetCFrame.Position - hrp.Position).Magnitude
        if dist < 6 then
            return true
        end

        if os.clock() < _G.Fruit_TeleportPauseUntil then
            task.wait(0.1)
            continue
        end

        local entrance = dist > 300 and GetBestEntrance(hrp.Position, targetCFrame.Position) or nil
        if entrance and TryTeleportEntrance(entrance, hrp) then
            task.wait(2) -- 等待傳送門完成
            continue
        end

        local headingToTarget = _G.isMovementActive and _G.ActiveTween ~= nil
            and lastTweenTargetPos ~= nil
            and (lastTweenTargetPos - targetCFrame.Position).Magnitude < 5

        if not headingToTarget then
            lastTweenTargetPos = targetCFrame.Position
            globalTweenTo(CFrame.new(targetCFrame.Position))
        end

        task.wait(0.2)
    end

    return false
end

local function Sea2KillMob(mob, timeout)
    local deadline = tick() + (timeout or 180)
    local lastTarget = nil

    while tick() < deadline do
        if not Sea2ShouldRun() then return false end
        if not SaberAlive(mob) then return true end

        SaberEquipCombatWeapon()

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local root = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
        if not hrp or not root then
            globalStopTween()
            lastTweenTargetPos = nil
            task.wait(0.5)
            continue
        end

        local hoverPos = Vector3.new(root.Position.X, root.Position.Y + (_G.HoverHeight or 15), root.Position.Z)

        if not _G.isMovementActive or not lastTarget or (lastTarget - hoverPos).Magnitude > 10 then
            lastTarget = hoverPos
            lastTweenTargetPos = hoverPos
            globalTweenTo(CFrame.new(hoverPos))
        end

        task.wait(0.2)
    end

    return false
end

local function Sea2RunFlow()
    local plr = LocalPlayer
    if not Sea2ShouldRun() then return end

    local CommF = SaberGetCommF()
    if not CommF then return end

    -- 傳送冷卻 避免重複呼叫
    if os.clock() - (_G.Sea2LastTravel or 0) < 8 then return end

    -- 700等流程已完成 (Ice Admiral 已擊殺) 直接傳送二海
    local Sea2QuestDone = false
    pcall(function()
        Sea2QuestDone = CommF:InvokeServer("DressrosaQuestProgress") == 1
    end)

    if Sea2QuestDone then
        _G.Sea2LastTravel = os.clock()
        CommF:InvokeServer("TravelDressrosa")
        return
    end

    local StatusLabel = { Text = "閒置" } -- 預留狀態顯示 與原流程寫法相容

    local iceMap = workspace.Map:FindFirstChild("Ice")
    local iceDoor = iceMap and iceMap:FindFirstChild("Door")
    if not iceDoor then return end

    if plr.Data.Level.Value >= 700 then

        -- 門尚未開啟 找偵探拿鑰匙
        if iceDoor.CanCollide == true and iceDoor.Transparency == 0 then
            StatusLabel.Text = "狀態: 取得鑰匙開啟冰門..."
            CommF:InvokeServer("DressrosaQuestProgress", "Detective")
            task.wait(0.5)
            SaberEquipTool("Key")
            if not Sea2Goto(CFrame.new(1347.7124, 37.3751602, -1325.6488), 180) then return end
        elseif iceDoor.CanCollide == false and iceDoor.Transparency == 1 then
            -- 門已開啟 擊殺 Ice Admiral
            local admiral = workspace.Enemies:FindFirstChild("Ice Admiral")
            if admiral and SaberAlive(admiral) then
                StatusLabel.Text = "狀態: 擊殺 Ice Admiral..."
                if not Sea2KillMob(admiral, 300) then return end
                _G.Sea2LastTravel = os.clock()
                CommF:InvokeServer("TravelDressrosa")
            else
                -- Ice Admiral 尚未生成 前往生成點等待
                StatusLabel.Text = "狀態: 等待 Ice Admiral 生成..."
                if not Sea2Goto(CFrame.new(1347.7124, 37.3751602, -1325.6488), 180) then return end

                admiral = workspace.Enemies:FindFirstChild("Ice Admiral")
                if not (admiral and SaberAlive(admiral)) then
                    -- 等待後仍未生成 視為流程已完成 直接傳送二海
                    StatusLabel.Text = "狀態: 傳送至二海..."
                    _G.Sea2LastTravel = os.clock()
                    CommF:InvokeServer("TravelDressrosa")
                end
            end
        else
            -- 門狀態未知 直接嘗試傳送二海
            StatusLabel.Text = "狀態: 傳送至二海..."
            _G.Sea2LastTravel = os.clock()
            CommF:InvokeServer("TravelDressrosa")
        end

    end
end

