do
    local HistoryDropdown
    local historyEntries = {}
    local historyByKey = {}
    local historyByLabel = {}
    local historySelected = nil
    local historyRunId = 0
    local historyActiveTween = nil
    local historyActiveState = nil
    local historyScanQueued = false

    local function getHistoryCFrame(target)
        if not target then return nil end

        local ok, cframe = pcall(function()
            if target:IsA("Model") then
                return target:GetPivot()
            elseif target:IsA("BasePart") then
                return target.CFrame
            end
            return nil
        end)

        if ok and typeof(cframe) == "CFrame" then
            return cframe
        end
        return nil
    end

    local function getHistoryValues()
        local values = {}
        for _, entry in ipairs(historyEntries) do
            table.insert(values, entry.Label)
        end
        return values
    end

    local function refreshHistoryDropdown()
        if not HistoryDropdown or not HistoryDropdown.Refresh then return end

        if historySelected and not historyByLabel[historySelected] then
            historySelected = nil
        end

        local selected = {}
        if historySelected then
            table.insert(selected, historySelected)
        end

        pcall(function()
            HistoryDropdown:Refresh(getHistoryValues(), selected)
        end)
    end

    local function recordHistoryLocation(category, target)
        local cframe = getHistoryCFrame(target)
        if not cframe then return end

        local key = category .. "|" .. target:GetFullName()
        local existing = historyByKey[key]
        if existing then
            existing.CFrame = cframe
            return
        end

        local label = category .. " / " .. target.Name
        if historyByLabel[label] then
            local suffix = 2
            local baseLabel = label
            repeat
                label = baseLabel .. " (" .. tostring(suffix) .. ")"
                suffix = suffix + 1
            until not historyByLabel[label]
        end

        local entry = {
            Key = key,
            Label = label,
            CFrame = cframe,
        }
        historyByKey[key] = entry
        historyByLabel[label] = entry
        table.insert(historyEntries, entry)
        refreshHistoryDropdown()
    end

    local function scanHistoryFolders()
        local towns = workspace:FindFirstChild("Towns")
        if towns then
            for _, location in ipairs(towns:GetChildren()) do
                if string.match(location.Name, "^town_%d+$") then
                    recordHistoryLocation("小鎮", location)
                end
            end
        end

        local safeZones = workspace:FindFirstChild("SafeZones")
        if safeZones then
            for _, location in ipairs(safeZones:GetChildren()) do
                if string.match(location.Name, "^safezone_%d+$") then
                    recordHistoryLocation("安全區", location)
                end
            end
        end

        local randomBuildings = workspace:FindFirstChild("RandomBuildings")
        if randomBuildings then
            for _, location in ipairs(randomBuildings:GetChildren()) do
                if hasNamePart(location, "OutlawCamp") then
                    recordHistoryLocation("法外營地", location)
                elseif hasNamePart(location, "Farm") then
                    recordHistoryLocation("農場", location)
                elseif hasNamePart(location, "EvilChurch") then
                    recordHistoryLocation("教堂", location)
                end
            end
        end
    end

    local historyFixedLocations = {
        { "監獄", { "StillwaterPrison" } },
        { "Sterling", { "Sterling", "Town" } },
        { "礦井", { "Sterling", "Mountain", "TabletPodium" } },
        { "古堡", { "VampireCastle" } },
        { "健身館", { "BoxingGym" } },
        { "實驗室", { "TeslaLab" } },
        { "煉油廠", { "OilRefinery" } },
    }

    local function scanHistoryFixedLocations()
        for _, definition in ipairs(historyFixedLocations) do
            local target = workspace
            for _, name in ipairs(definition[2]) do
                target = target:FindFirstChild(name)
                if not target then break end
            end
            if target then
                recordHistoryLocation(definition[1], target)
            end
        end
    end

    local function scanHistoryLocations()
        scanHistoryFolders()
        scanHistoryFixedLocations()
    end

    local function inspectHistoryAddedInstance(instance)
        if not instance then return end

        local current = instance
        while current and current ~= workspace do
            local parent = current.Parent
            if not parent then break end

            if parent.Name == "Towns"
                and string.match(current.Name, "^town_%d+$") then
                recordHistoryLocation("小鎮", current)
            elseif parent.Name == "SafeZones"
                and string.match(current.Name, "^safezone_%d+$") then
                recordHistoryLocation("安全區", current)
            elseif parent.Name == "RandomBuildings" then
                if hasNamePart(current, "OutlawCamp") then
                    recordHistoryLocation("法外營地", current)
                elseif hasNamePart(current, "Farm") then
                    recordHistoryLocation("農場", current)
                elseif hasNamePart(current, "EvilChurch") then
                    recordHistoryLocation("教堂", current)
                end
            end

            current = parent
        end

        current = instance
        while current and current ~= workspace do
            if current.Name == "StillwaterPrison"
                or current.Name == "Sterling"
                or current.Name == "Town"
                or current.Name == "Mountain"
                or current.Name == "VampireCastle"
                or current.Name == "BoxingGym"
                or current.Name == "TeslaLab"
                or current.Name == "OilRefinery" then
                scanHistoryFixedLocations()
                break
            end
            current = current.Parent
        end
    end

    local function queueHistoryScan()
        if historyScanQueued then return end
        historyScanQueued = true
        task.defer(function()
            historyScanQueued = false
            scanHistoryLocations()
        end)
    end

    local function stopHistoryTeleport()
        historyRunId = historyRunId + 1

        if historyActiveTween then
            pcall(function()
                if historyActiveTween.PlaybackState == Enum.PlaybackState.Playing then
                    historyActiveTween:Cancel()
                end
            end)
            historyActiveTween = nil
        end

        if historyActiveState then
            restoreCharacterState(historyActiveState)
            historyActiveState = nil
        end
    end

    local function startHistoryTeleport(entry)
        if not entry or typeof(entry.CFrame) ~= "CFrame" then
            WindUI:Notify({
                Title = "歷史紀錄",
                Content = "請先選擇有效的地點",
                Duration = 2,
            })
            return
        end

        stopHistoryTeleport()
        historyRunId = historyRunId + 1
        local runId = historyRunId

        task.spawn(function()
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart")
            local humanoid = character:WaitForChild("Humanoid")
            if not hrp or not humanoid then return end

            local savedState = saveCharacterState(hrp, humanoid)
            historyActiveState = savedState
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            humanoid.JumpHeight = 0
            humanoid.AutoRotate = false
            hrp.Anchored = true

            moveWithLiveTweenSpeed(
                hrp,
                entry.CFrame * CFrame.new(0, 5, 0),
                function()
                    return runId == historyRunId
                end,
                function(tween)
                    if runId == historyRunId then
                        historyActiveTween = tween
                    end
                end
            )

            if runId == historyRunId then
                historyActiveTween = nil
                restoreCharacterState(savedState)
                if historyActiveState == savedState then
                    historyActiveState = nil
                end
            end
        end)

        WindUI:Notify({
            Title = "歷史紀錄",
            Content = "前往 " .. entry.Label,
            Duration = 2,
        })
    end

    scanHistoryLocations()
    workspace.DescendantAdded:Connect(function(instance)
        inspectHistoryAddedInstance(instance)
        queueHistoryScan()
    end)
    task.spawn(function()
        while task.wait(1) do
            scanHistoryLocations()
        end
    end)

    Tabs.History:Section({ Title = "歷史" })

    HistoryDropdown = Tabs.History:Dropdown({
        Title = "地點",
        Desc = "自動記錄遊戲中遇到的地點",
        Values = getHistoryValues(),
        Value = historySelected,
        AllowNone = true,
        SearchBarEnabled = true,
        Callback = function(value)
            if type(value) == "table" then
                value = value[1]
            end
            local selected = value and tostring(value) or nil
            historySelected = selected ~= "" and selected or nil
        end,
    })

    Tabs.History:Button({
        Title = "前往選取地點",
        Callback = function()
            local entry = historySelected and historyByLabel[historySelected]
            startHistoryTeleport(entry)
        end,
    })
end

