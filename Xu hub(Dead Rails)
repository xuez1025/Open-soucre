-- 升級版：支援大小寫不敏感與模糊匹配的顏色獲取函式
local function getItemColor(name, model)
    local searchNames = {}
    if name then table.insert(searchNames, tostring(name)) end
    if model and model.Name then table.insert(searchNames, tostring(model.Name)) end

    for _, searchName in ipairs(searchNames) do
        -- 1. 精確符合
        if itemCategoryColors[searchName] then
            return itemCategoryColors[searchName]
        end

        -- 2. 不分大小寫符合
        local lowerSearch = searchName:lower()
        for catName, color in pairs(itemCategoryColors) do
            if catName:lower() == lowerSearch then
                return color
            end
        end

        -- 3. 包含符合（模糊匹配）
        for catName, color in pairs(itemCategoryColors) do
            local lowerCat = catName:lower()
            if lowerSearch:find(lowerCat) or lowerCat:find(lowerSearch) then
                return color
            end
        end
    end

    return _G.ESP_ItemHighlightColor
end

local ESP_TEXT_INTERVAL = 0.2
local itemTextCache = {}
local itemEntries = {}
local itemTracers = {}
