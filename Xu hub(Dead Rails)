local function GetNearestModelHorse()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local playerPos = hrp.Position
    local nearestTarget = nil
    local shortestDistance = math.huge

    for _, child in ipairs(workspace:GetDescendants()) do
        if child.Name == "Model_Horse" and (child:IsA("Model") or child:IsA("BasePart")) then
            local targetPos = nil
            
            if child:IsA("Model") then
                local success, pivot = pcall(function()
                    return child:GetPivot()
                end)
                if success and pivot then
                    targetPos = pivot.Position
                end
            elseif child:IsA("BasePart") then
                targetPos = child.Position
            end

            if targetPos then
                local distance = (playerPos - targetPos).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestTarget = child
                end
            end
        end
    end

    return nearestTarget
end

