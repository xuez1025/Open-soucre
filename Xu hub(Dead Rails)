    recordStartingZone()
end)

local function tweenBackToStartingZone()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not hrp or not humanoid then
        return false, "找不到角色"
    end

    if not isSitting() then
        WindUI:Notify({
            Title = "傳送",
            Content = "請先坐在載具座位上，再使用此功能",
            Duration = 3,
        })
        return false, "必須坐在載具座位上才能傳送"
    end

    local recorded, message = recordStartingZone()
    if not recorded then
        return false, message
    end
    local targetCFrame = savedStartingZoneCFrame

    startingZoneRunId = startingZoneRunId + 1
    local runId = startingZoneRunId

    if startingZoneTween then
        pcall(function()
            if startingZoneTween.PlaybackState == Enum.PlaybackState.Playing then
                startingZoneTween:Cancel()
            end
        end)
        startingZoneTween = nil
    end

    local savedState = saveCharacterState(hrp, humanoid)
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0
    humanoid.AutoRotate = false
    hrp.Anchored = true

    local arrived = moveWithLiveTweenSpeed(
        hrp,
        targetCFrame * CFrame.new(0, 3, 0),
        function()
            return runId == startingZoneRunId
        end,
        function(tween)
            startingZoneTween = tween
        end
    )

    startingZoneTween = nil
    restoreCharacterState(savedState)
    return arrived
end

saveCharacterState = function(hrp, humanoid)
    return {
        hrp        = hrp,
        humanoid   = humanoid,
        walkSpeed  = humanoid.WalkSpeed,
        jumpPower  = humanoid.JumpPower,
        jumpHeight = humanoid.JumpHeight,
        autoRotate = humanoid.AutoRotate,
        anchored   = hrp.Anchored,
    }
end

restoreCharacterState = function(saved)
    if not saved then return end
    local hrp      = saved.hrp
    local humanoid = saved.humanoid
    if hrp and hrp.Parent then
        hrp.Anchored = saved.anchored
    end
    if humanoid and humanoid.Parent then
        humanoid.WalkSpeed  = saved.walkSpeed
        humanoid.JumpPower  = saved.jumpPower
        humanoid.JumpHeight = saved.jumpHeight
        humanoid.AutoRotate = saved.autoRotate
    end
end

