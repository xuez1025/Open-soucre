-- 伺服器運行時間
local function convertToDetailedTime(S)
    local h = math.floor(S / 3600)
    S %= 3600
    local m = math.floor(S / 60)
    local s = S % 60
    return { Hours = h, Minutes = m, Seconds = s }
end

local function GetServerUptimeString()
    local t = time()
    local u = convertToDetailedTime(math.floor(t))
    return string.format(
        "%d時 %d分 %d秒",
        u.Hours, u.Minutes, u.Seconds
    )
end

-- 加入時間
local function GetLastJoinedString()
    local c = os.time()
    local j = c - math.floor(time())
    local jt = os.date("*t", j)

    local ap = jt.hour >= 12 and "下午" or "上午"
    local h12 = jt.hour % 12
    if h12 == 0 then h12 = 12 end

    local mn = { "1月","2月","3月","4月","5月","6月","7月","8月","9月","10月","11月","12月" }

    return string.format(
        "%s%d日 %s %02d點 %02d分 %02d秒",
        mn[jt.month], jt.day, ap, h12, jt.min, jt.sec
    )
end

