local function getBuildingCFrame(building)
    if building:IsA("Model") then
        return building:GetPivot()
    elseif building:IsA("BasePart") then
        return building.CFrame
    end
    return nil
end

local function isMovableBuilding(building)
    return building:IsA("Model") or building:IsA("BasePart")
end

local function getRandomBuildingCandidates(filter)
    local folder = workspace:FindFirstChild("RandomBuildings")
    if not folder then return {} end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local origin = hrp and hrp.Position or Camera.CFrame.Position
    local candidates = {}
    for _, building in ipairs(folder:GetChildren()) do
        if filter(building) then
            local cframe = getBuildingCFrame(building)
            if cframe then
                table.insert(candidates, {
                    Instance = building,
                    CFrame = cframe,
                    Distance = (cframe.Position - origin).Magnitude,
                    SortKey = building:GetFullName(),
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        if a.Distance ~= b.Distance then
            return a.Distance < b.Distance
        end
        return a.SortKey < b.SortKey
    end)
    return candidates
end

local function hasNamePart(building, namePart)
    return string.find(string.lower(building.Name), string.lower(namePart), 1, true) ~= nil
end

local function isClassifiedRandomBuilding(building)
    return hasNamePart(building, "OutlawCamp")
        or hasNamePart(building, "Farm")
        or hasNamePart(building, "EvilChurch")
end

local function createRandomBuildingTeleportController(options)
    local state = {
        RunId = 0,
        ActiveTween = nil,
        ActiveCharacterState = nil,
        CurrentIndex = nil,
        CurrentReached = false,
    }

    local function isEnabled()
        return _G[options.EnabledKey] == true
    end

    local function stop()
        state.RunId = state.RunId + 1

        if state.ActiveTween then
            pcall(function()
                if state.ActiveTween.PlaybackState == Enum.PlaybackState.Playing then
                    state.ActiveTween:Cancel()
                end
            end)
            state.ActiveTween = nil
        end

        if state.ActiveCharacterState then
            restoreCharacterState(state.ActiveCharacterState)
            state.ActiveCharacterState = nil
        end
    end

    local function start()
        stop()
        state.RunId = state.RunId + 1
        local runId = state.RunId

        task.spawn(function()
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart")
            local humanoid = character:WaitForChild("Humanoid")
            if not hrp or not humanoid then return end

            if not waitForSitting(function()
                return isEnabled() and runId == state.RunId
            end) then return end

            local savedState = saveCharacterState(hrp, humanoid)
            state.ActiveCharacterState = savedState
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            humanoid.JumpHeight = 0
            humanoid.AutoRotate = false
            hrp.Anchored = true

            local direction = Vector3.new(0, 0, -1)

            while isEnabled() and runId == state.RunId do
                if not character.Parent or not hrp.Parent then break end

                local candidates = getRandomBuildingCandidates(options.Filter)
                local targetIndex = math.max(
                    math.floor(tonumber(_G[options.IndexKey]) or 1),
                    1
                )
                local target = candidates[targetIndex]

                if target then
                    local arrived = moveWithLiveTweenSpeed(
                        hrp,
                        target.CFrame * CFrame.new(0, 5, 0),
                        function()
                            return isEnabled() and runId == state.RunId
                        end,
                        function(tween)
                            state.ActiveTween = tween
                        end
                    )
                    if not arrived then break end

                    state.CurrentIndex = targetIndex
                    state.CurrentReached = true

                    restoreCharacterState(savedState)
                    state.ActiveCharacterState = nil
                    break
                end

                local rotation = hrp.CFrame.Rotation
                local searchTarget = CFrame.new(hrp.Position + direction * 50) * rotation
                if not moveWithLiveTweenSpeed(hrp, searchTarget, function()
                    return isEnabled() and runId == state.RunId
                end, function(tween)
                    state.ActiveTween = tween
                end) then
                    break
                end
            end

            if runId == state.RunId then
                restoreCharacterState(savedState)
                if state.ActiveCharacterState == savedState then
                    state.ActiveCharacterState = nil
                end
            end
        end)
    end

    local function skip()
        local currentIndex = state.CurrentIndex or math.max(
            math.floor(tonumber(_G[options.IndexKey]) or 1),
            1
        )

        if not state.CurrentReached or state.CurrentIndex ~= currentIndex then
            WindUI:Notify({
                Title = options.Title,
                Content = "請先前往並成功抵達當前目標，才能前往下一個",
                Duration = 3,
            })
            return false
        end

        _G[options.IndexKey] = currentIndex + 1
        state.CurrentIndex = _G[options.IndexKey]
        state.CurrentReached = false

        state.RunId = state.RunId + 1
        if isEnabled() then
            start()
        end

        WindUI:Notify({
            Title = options.Title,
            Content = "跳過目前目標，尋找第 " .. tostring(_G[options.IndexKey]) .. " 個",
            Duration = 2,
        })
        return true
    end

    return {
        Start = start,
        Stop = stop,
        Skip = skip,
    }
end

