    end

    _G.TownIndex = currentIndex + 1
    townCurrentIndex = _G.TownIndex
    townCurrentReached = false

    townRunId = townRunId + 1
    if _G.TownTeleportEnabled then
        startTownTeleport()
    end

    WindUI:Notify({
        Title = "小鎮",
        Content = "立即前往 town_" .. tostring(_G.TownIndex),
        Duration = 2,
    })
    return true
end

