        end

        if v then
            _G.SafeZoneSelected = tostring(v)

            local index = tonumber(
                string.match(_G.SafeZoneSelected, "^safezone_(%d+)$")
            )

            if index then
                _G.SafeZoneIndex = index
                safeZoneCurrentIndex = index
                safeZoneCurrentSaved = safeZoneSavedLocations[index] ~= nil
            else
                safeZoneCurrentIndex = nil
                safeZoneCurrentSaved = false
            end
        end
    end,
})

