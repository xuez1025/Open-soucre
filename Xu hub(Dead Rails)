-- 物品
local ItemAuraAPI
do
local ItemAuraECS = nil
local ItemAuraRunConnection = nil
local ItemAuraBusy = false
local ItemAuraNextRun = 0
local ItemAuraTitleToId = {}
local ItemAuraIdToTitle = {}

local function LoadItemAuraECS()
    local ok, result = pcall(function()
        local universe = ReplicatedStorage.Shared.Universe
        local value = {}
        value.world = require(universe.ECS.world)
        value.comps = require(universe.ECS.components)
        value.replicator = require(ReplicatedStorage.Client.Universe.Replication.clientReplicator)
        value.pickup = universe.Network.RemoteEvent.Pickup
        return value
    end)
    if ok then
        return result
    end
    return false
end

local function ItemAuraAllowed(objectId)
    if next(_G.ItemAuraSelected) then
        if _G.ItemAuraSelected[normalizeName(tostring(objectId))] then
            return true
        end
        return false
    end
    return true
end

local function CollectItemAuraPass()
    if not ItemAuraECS then
        ItemAuraECS = LoadItemAuraECS()
    end
    if not ItemAuraECS then
        return
    end

    local world = ItemAuraECS.world
    local comps = ItemAuraECS.comps
    local state = world:get_resource(comps.ClientStateResource)
    local character = state and state.localCharacter
    if not character then
        return
    end

    local checked = 0
    for entity in world:query(comps.Storable, comps.ObjectId) do
        if not _G.ItemAuraEnabled then
            return
        end

        local objectId = world:get(entity, comps.ObjectId)
        if ItemAuraAllowed(objectId) and world:has(entity, comps.Pickupable) then
            local serverEntity = ItemAuraECS.replicator:get_server_entity(entity)
            if serverEntity and serverEntity ~= entity then
                ItemAuraECS.pickup:FireServer(serverEntity)
                if _G.ItemAuraDelay > 0 then
                    task.wait(_G.ItemAuraDelay)
                end
            end
        end

        checked += 1
        if checked % 20 == 0 then
            task.wait()
        end
    end
end

local function EnableItemAura()
    if ItemAuraRunConnection then
        ItemAuraRunConnection:Disconnect()
        ItemAuraRunConnection = nil
    end
    _G.ItemAuraEnabled = true
    ItemAuraECS = LoadItemAuraECS()
    if not ItemAuraECS then
        _G.ItemAuraEnabled = false
        WindUI:Notify({ Title = "物品", Content = "找不到遊戲物品模組", Duration = 3 })
        return
    end

    ItemAuraRunConnection = RunService.Heartbeat:Connect(function()
        if not ItemAuraRunConnection then
            return
        end
        if _G.ItemAuraEnabled and not ItemAuraBusy and os.clock() >= ItemAuraNextRun then
            ItemAuraBusy = true
            ItemAuraNextRun = os.clock() + 0.25
            task.spawn(function()
                CollectItemAuraPass()
                ItemAuraBusy = false
            end)
        end
    end)
end

local function DisableItemAura()
    _G.ItemAuraEnabled = false
    if ItemAuraRunConnection then
        ItemAuraRunConnection:Disconnect()
        ItemAuraRunConnection = nil
    end
    ItemAuraBusy = false
    ItemAuraNextRun = 0
end

local function GetItemAuraObjectFolder()
    local ok, folder = pcall(function()
        return ReplicatedStorage.Shared.Universe.Object.Objects
    end)
    if ok then
        return folder
    end
    return false
end

local function BuildItemAuraComponentNames()
    local names = {}
    for key, value in pairs(ItemAuraECS.comps) do
        names[value] = tostring(key)
    end
    return names
end

local function ReadItemAuraObject(module, names)
    local loaded, data = pcall(require, module)
    if not loaded or type(data) ~= "table" then
        return false
    end
    if type(data.components) ~= "table" then
        return false
    end

    local result = { id = module.Name, title = module.Name, pickupable = false }
    for component, value in pairs(data.components) do
        local name = names[component]
        if name == "Pickupable" then
            result.pickupable = true
        elseif name == "Name" then
            result.title = tostring(value)
        end
    end
    if type(data.tags) == "table" then
        for _, tag in pairs(data.tags) do
            if names[tag] == "Pickupable" then
                result.pickupable = true
            end
        end
    end
    return result
end

local function ScanItemAuraEntries()
    local entries = {}
    ItemAuraTitleToId = {}
    ItemAuraIdToTitle = {}
    if not ItemAuraECS then
        ItemAuraECS = LoadItemAuraECS()
    end
    if not ItemAuraECS then
        return entries
    end

    local folder = GetItemAuraObjectFolder()
    if not folder then
        return entries
    end
    local names = BuildItemAuraComponentNames()
    for _, module in ipairs(folder:GetDescendants()) do
        if module:IsA("ModuleScript") then
            local item = ReadItemAuraObject(module, names)
            if item and item.pickupable then
                local title = item.title
                if ItemAuraTitleToId[title] then
                    title = title .. " (" .. item.id .. ")"
                end
                ItemAuraTitleToId[title] = item.id
                ItemAuraIdToTitle[normalizeName(item.id)] = title
                table.insert(entries, title)
            end
        end
    end
    table.sort(entries)
    return entries
end

ItemAuraAPI = {
    Enable = EnableItemAura,
    Disable = DisableItemAura,
    Scan = ScanItemAuraEntries,
    GetTitleToId = function()
        return ItemAuraTitleToId
    end,
    GetIdToTitle = function()
        return ItemAuraIdToTitle
    end,
}

if _G.ItemAuraEnabled then
    ItemAuraAPI.Enable()
end
end


-- 輔助自瞄
-- 將區塊封裝，避免所有暫存 local 累積在主 chunk；UI 只持有這個公開介面。
local Aimbot = {}
do
    local state = {
        tracking = false,
        bound = false,
        targets = {},
        trackingConnection = nil,
        fovGui = nil,
        fovCircle = nil,
        fovStroke = nil,
    }

    local function addTarget(obj)
        if not obj:IsA("Humanoid") then return end
        local model = obj.Parent
        if model and model:IsA("Model") and model ~= Character
            and not Players:GetPlayerFromCharacter(model) then
            state.targets[model] = obj
        end
    end

    local function stopTracking()
        if state.trackingConnection then
            state.trackingConnection:Disconnect()
            state.trackingConnection = nil
        end
        table.clear(state.targets)
    end

    local function startTracking()
        if state.trackingConnection then return end
        table.clear(state.targets)
        for _, obj in ipairs(workspace:GetDescendants()) do addTarget(obj) end
        state.trackingConnection = workspace.DescendantAdded:Connect(addTarget)
    end

    local function updateFov()
        if not _G.AimShowFov then
            if state.fovGui then state.fovGui.Enabled = false end
            return
        end
        if not state.fovGui or not state.fovGui.Parent then
            state.fovGui = Instance.new("ScreenGui")
            state.fovGui.Name = "DaraAimbotFOV"
            state.fovGui.ResetOnSpawn = false
            state.fovGui.IgnoreGuiInset = true
            state.fovGui.Parent = PlayerGui
            state.fovCircle = Instance.new("Frame")
            state.fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
            state.fovCircle.Position = UDim2.fromScale(0.5, 0.5)
            state.fovCircle.BackgroundTransparency = 1
            state.fovCircle.BorderSizePixel = 0
            state.fovCircle.Parent = state.fovGui
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = state.fovCircle
            state.fovStroke = Instance.new("UIStroke")
            state.fovStroke.Thickness = 2
            state.fovStroke.Parent = state.fovCircle
        end
        state.fovGui.Enabled = true
        state.fovCircle.Size = UDim2.fromOffset(_G.AimFovRadius * 2, _G.AimFovRadius * 2)
        state.fovStroke.Color = _G.AimFovColor
    end

    local function selectPart(model)
        if _G.AimbotPart == "Head" then
            return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
        elseif _G.AimbotPart == "Legs" then
            return model:FindFirstChild("LowerTorso") or model:FindFirstChild("Left Leg")
                or model:FindFirstChild("HumanoidRootPart")
        end
        return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")
            or model:FindFirstChild("Torso")
    end

    local function visible(cam, part, model)
        if not _G.AimbotWallCheck then return true end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { model, Character }
        local origin = cam.CFrame.Position
        return workspace:Raycast(origin, part.Position - origin, params) == nil
    end

    local function getTarget(cam, center, model, humanoid)
        if not model.Parent or not humanoid.Parent or humanoid.Health <= 0 then return end
        local part = selectPart(model)
        if not part then return end
        local screen, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then return end
        local distance = (Vector2.new(screen.X, screen.Y) - center).Magnitude
        if distance <= _G.AimFovRadius and visible(cam, part, model) then
            return part, distance
        end
    end

    local function step(dt)
        if not _G.AimbotEnabled then return end
        local controller = getCameraController()
        local cam = workspace.CurrentCamera
        if not controller or not cam or not controller.Rotations then return end
        local current = controller.Rotations.MouseLook
        if typeof(current) ~= "Vector3" or not Humanoid or Humanoid.Health <= 0 then return end

        local center = cam.ViewportSize / 2
        local bestPart, bestDistance
        for model, humanoid in pairs(state.targets) do
            if not model.Parent or not humanoid.Parent or humanoid.Health <= 0 then
                state.targets[model] = nil
            else
                local part, distance = getTarget(cam, center, model, humanoid)
                if part and (not bestDistance or distance < bestDistance) then
                    bestPart, bestDistance = part, distance
                end
            end
        end
        if not bestPart then return end

        local origin = cam.CFrame.Position
        local ok, characterPosition = pcall(controller.GetPositionCharacter, controller)
        if ok and typeof(characterPosition) == "Vector3" then origin = characterPosition end
        local offset = bestPart.Position - origin
        if offset.Magnitude < 0.001 then return end
        local direction = offset.Unit
        local targetPitch = math.deg(math.asin(math.clamp(direction.Y, -1, 1)))
        local targetYaw = math.deg(math.atan2(-direction.X, -direction.Z))
        local yawDelta = ((targetYaw - current.Y + 180) % 360) - 180
        local pitchDelta = targetPitch - current.X
        local factor = math.clamp(1 - (tonumber(_G.AimbotSmoothness) or 5) / 20, 0.001, 1)
        local alpha = math.clamp(factor * math.min((dt or 1 / 60) * 60, 1), 0, 1)
        controller.Rotations.MouseLook = Vector3.new(
            math.clamp(current.X + pitchDelta * alpha, -80, 80),
            current.Y + yawDelta * alpha,
            current.Z
        )
    end

    function Aimbot.Sync()
        if _G.AimbotEnabled and not state.tracking then
            state.tracking = true
            startTracking()
        elseif not _G.AimbotEnabled and state.tracking then
            state.tracking = false
            stopTracking()
        end
    end

    function Aimbot.Start()
        if state.bound then return end
        state.bound = true
        -- 相機通常在 Camera priority 更新；放在後面，避免旋轉被覆蓋。
        RunService:BindToRenderStep("DaraHubAimbot", Enum.RenderPriority.Camera.Value + 1, step)
    end

    function Aimbot.Stop()
        if not state.bound then return end
        state.bound = false
        pcall(function() RunService:UnbindFromRenderStep("DaraHubAimbot") end)
    end

    Aimbot.UpdateFov = updateFov
    if _G.AimbotEnabled then Aimbot.Start(); Aimbot.Sync() end
    if _G.AimShowFov then updateFov() end
end

