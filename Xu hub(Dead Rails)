--穿牆
local noclipConnection = nil
local boatNoclipConn = nil
local boatNoclipRestore = {}
local boatNoclipTracked = {}
local boatNoclipBoat = nil

local function BoatNoclipGetBoat()
    local char = speaker.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if not seat then return nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    if model and model ~= workspace then return model end
    return seat.Parent
end

local function BoatNoclipApply(boat)
    for _, d in ipairs(boat:GetDescendants()) do
        if d:IsA("BasePart") then
            if not boatNoclipTracked[d] then
                boatNoclipTracked[d] = true
                boatNoclipRestore[d] = d.CanCollide
            end
            if d.CanCollide then
                d.CanCollide = false
            end
        end
    end
end

local function BoatNoclipRestoreAll()
    for part, orig in pairs(boatNoclipRestore) do
        pcall(function()
            if part.Parent and part.CanCollide ~= orig then
                part.CanCollide = orig
            end
        end)
    end
    boatNoclipRestore = {}
    boatNoclipTracked = {}
end

local function BoatNoclipStart()
    if boatNoclipConn then return end
    boatNoclipConn = RunService.Stepped:Connect(function()
        if not _G.NoclipEnabled then return end
        local boat = BoatNoclipGetBoat()
        if boat ~= boatNoclipBoat then
            BoatNoclipRestoreAll()
            boatNoclipBoat = boat
        end
        if boat then
            pcall(BoatNoclipApply, boat)
        end
    end)
end

local function BoatNoclipStop()
    if boatNoclipConn then
        boatNoclipConn:Disconnect()
        boatNoclipConn = nil
    end
    BoatNoclipRestoreAll()
    boatNoclipBoat = nil
end

local function SetNoclip(state)
    _G.NoclipEnabled = state
    if _G.NoclipEnabled then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = speaker.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
        
        BoatNoclipStart()
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        local char = speaker.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
        
        BoatNoclipStop()
    end
end

speaker.CharacterAdded:Connect(function()
    if _G.NoclipEnabled then
        SetNoclip(false)
    end
end)

