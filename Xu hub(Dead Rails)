local BANDAGE_FAST_TIME = 0.05

local function patchBandageScript(cs)
    for _, conn in ipairs(getconnections(RunService.RenderStepped)) do
        local fn = conn.Function
        if type(fn) == "function" then
            local ok, env = pcall(getfenv, fn)
            if ok and type(env) == "table" and rawget(env, "script") == cs then
                local okC, consts = pcall(debug.getconstants, fn)
                if okC then
                    for i, v in pairs(consts) do
                        if v == 3.7 then
                            pcall(debug.setconstant, fn, i, BANDAGE_FAST_TIME)
                        end
                    end
                end
            end
        end
    end
end

local bandage = { connections = {}, watched = {}, enabled = false }

local function watchTool(tool)
    if not bandage.enabled or bandage.watched[tool] or not tool:IsA("Tool") then
        return
    end
    task.spawn(function()
        local cs = tool:WaitForChild("BandageClient", 5)
        if not cs or not bandage.enabled or bandage.watched[tool] then return end

        bandage.watched[tool] = true

        table.insert(bandage.connections,
            tool.Equipped:Connect(function()
                task.delay(0.1, patchBandageScript, cs)
            end)
        )

        if tool.Parent == Character then
            task.delay(0.1, patchBandageScript, cs)
        end
    end)
end

local function watchContainer(c)
    for _, ch in ipairs(c:GetChildren()) do
        watchTool(ch)
    end
    table.insert(bandage.connections,
        c.ChildAdded:Connect(watchTool)
    )
end

local function stopBandage()
    bandage.enabled = false
    for _, c in ipairs(bandage.connections) do c:Disconnect() end
    table.clear(bandage.connections)
    table.clear(bandage.watched)
end

local function startBandage()
    stopBandage()
    bandage.enabled = true

    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then watchContainer(bp) end
    if Character then watchContainer(Character) end

    table.insert(bandage.connections,
        LocalPlayer.CharacterAdded:Connect(function(c)
            table.clear(bandage.watched)
            watchContainer(c)
            local nb = LocalPlayer:WaitForChild("Backpack", 5)
            if nb then watchContainer(nb) end
        end)
    )
end

