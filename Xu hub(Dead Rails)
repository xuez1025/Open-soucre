local townActiveState = nil
local townCurrentIndex = nil
local townCurrentReached = false

local function findTown(index)
    local towns = workspace:FindFirstChild("Towns")
    local town = towns and towns:FindFirstChild("town_" .. tostring(index))
    if not town then return nil end

    if town:IsA("Model") then
        return town:GetPivot()
    elseif town:IsA("BasePart") then
        return town.CFrame
    end

    return nil
end

local function stopTownTeleport()
    townRunId = townRunId + 1

    if townActiveTween then
        pcall(function()
            if townActiveTween.PlaybackState == Enum.PlaybackState.Playing then
                townActiveTween:Cancel()
            end
        end)
        townActiveTween = nil
    end

    if townActiveState then
        restoreCharacterState(townActiveState)
        townActiveState = nil
    end
end

local function tweenTownTo(hrp, targetCFrame, runId)
    return moveWithLiveTweenSpeed(
        hrp,
        targetCFrame,
        function()
            return _G.TownTeleportEnabled and runId == townRunId
        end,
        function(tween)
            townActiveTween = tween
        end
    )
end

local function startTownTeleport()
    stopTownTeleport()
    townRunId = townRunId + 1
    local runId = townRunId

    task.spawn(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart")
        local humanoid = character:WaitForChild("Humanoid")
        if not hrp or not humanoid then return end

        if not waitForSitting(function()
            return _G.TownTeleportEnabled and runId == townRunId
        end) then return end

        local savedState = saveCharacterState(hrp, humanoid)
        townActiveState = savedState
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
        humanoid.AutoRotate = false
        hrp.Anchored = true

        local direction = Vector3.new(0, 0, -1)

        while _G.TownTeleportEnabled and runId == townRunId do
            if not character.Parent or not hrp.Parent then break end

            local targetIndex = math.max(math.floor(tonumber(_G.TownIndex) or 1), 1)
            local townCFrame = findTown(targetIndex)

            if townCFrame then
                local arrived = tweenTownTo(hrp, townCFrame * CFrame.new(0, 5, 0), runId)
                if not arrived then break end
                townCurrentIndex = targetIndex
                townCurrentReached = true
                restoreCharacterState(savedState)
                break
            end

            local rotation = hrp.CFrame.Rotation
            local target = CFrame.new(hrp.Position + direction * 50) * rotation
            if not moveWithLiveTweenSpeed(hrp, target, function()
                return _G.TownTeleportEnabled and runId == townRunId
            end, function(tween)
                townActiveTween = tween
            end) then
                break
            end
        end

        if runId == townRunId then
            restoreCharacterState(savedState)
            if townActiveState == savedState then
                townActiveState = nil
            end
        end
    end)
end

if _G.TownTeleportEnabled then
    startTownTeleport()
end

local function skipToNextTown()
    local currentIndex = townCurrentIndex or math.max(
