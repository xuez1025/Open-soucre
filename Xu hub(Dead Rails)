local HEAL_ITEMS = { "Bandage", "Snake Oil" }

local ITEM_RULES = {
    ["Bandage"]   = { passTool = false, equip = false },
    ["Snake Oil"] = { passTool = true,  equip = true  },
}

local function scanContainer(container, key)
    if not container then return nil end
    for _, ch in ipairs(container:GetChildren()) do
        if ch:IsA("Tool") and normalizeName(ch.Name) == key then
            return ch
        end
    end
    return nil
end

local function findHealItem()
    for _, itemName in ipairs(HEAL_ITEMS) do
        if _G.HealSelected[itemName] then
            local key = normalizeName(itemName)
            local tool = scanContainer(Character, key)
                or scanContainer(LocalPlayer:FindFirstChildOfClass("Backpack"), key)
            local remote = tool and tool:FindFirstChild("Use")
            if remote and remote:IsA("RemoteEvent") then
                return tool, remote, itemName
            end
        end
    end
    return nil
end

local function useHealItem()
    local tool, remote, itemName = findHealItem()
    if not remote then return false end

    local rule = ITEM_RULES[itemName]
    local previous

    if rule.equip and Humanoid and tool.Parent ~= Character then
        previous = Character:FindFirstChildWhichIsA("Tool")
        Humanoid:EquipTool(tool)
        task.wait(0.15)
    end

    if rule.passTool then
        remote:FireServer(tool)
    else
        remote:FireServer()
    end

    if previous and previous.Parent and Humanoid then
        task.wait(0.1)
        Humanoid:EquipTool(previous)
    end
    return true
end

local function healStep()
    if not Humanoid or Humanoid.Health <= 0 or Humanoid.Health >= Humanoid.MaxHealth then
        return false
    end
    if Humanoid.Health > _G.HealMinHealth then
        return false
    end
    return useHealItem()
end

task.spawn(function()
    local nextAt = 0
    while task.wait(0.1) do
        if not LocalPlayer or not LocalPlayer:IsDescendantOf(game.Players) then break end
        if _G.AutoHealEnabled then
            if tick() >= nextAt then
                if healStep() then
                    nextAt = tick() + _G.HealDelay
                end
            end
        end
    end
end)

if _G.AutoHealEnabled then
end

--自動救隊友
local revive = {
    delay = 0.5,
    lastTry = setmetatable({}, { __mode = "k" }),
    lastWarn = 0,
    connection = nil,
}

local function hasBandageForRevive()
    local function scan(container)
        if not container then return false end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and normalizeName(child.Name) == normalizeName("Bandage") then
                return true
            end
        end
        return false
    end

    return scan(Character) or scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
end

local function getRevivePrompt(player)
    local model = player.Character or workspace:FindFirstChild(player.Name)
    local root = model and model:FindFirstChild("HumanoidRootPart")
    local prompt = root and root:FindFirstChild("RevivePrompt")

    if prompt and prompt:IsA("ProximityPrompt") then
        return prompt, root
    end
    return nil, root
end

local function warnRevive(content)
    if os.clock() - revive.lastWarn < 5 then return end
    revive.lastWarn = os.clock()
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "自動復活",
            Text = content,
            Duration = 3,
        })
    end)
end

local function reviveStep()
    if not _G.AutoReviveEnabled then return end

    local currentCharacter = LocalPlayer.Character
    local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
    local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
    if not currentRoot or not currentHumanoid or currentHumanoid.Health <= 0 then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local prompt, root = getRevivePrompt(player)
            if prompt and root then
                if not prompt.Enabled then
                    prompt.Enabled = true
                end

                if prompt.Enabled then
                    local distance = (root.Position - currentRoot.Position).Magnitude
                    local now = os.clock()

                    if distance <= prompt.MaxActivationDistance
                        and now - (revive.lastTry[prompt] or 0) >= revive.delay then
                        if not hasBandageForRevive() then
                            warnRevive("背包中沒有繃帶")
                            return
                        end

                        revive.lastTry[prompt] = now
                        local previousHoldDuration = prompt.HoldDuration
                        prompt.HoldDuration = 0
                        pcall(fireproximityprompt, prompt)
                        if prompt.Parent then
                            prompt.HoldDuration = previousHoldDuration
                        end
                    end
                end
            end
        end
    end
end

local function stopAutoRevive()
    if revive.connection then
        revive.connection:Disconnect()
        revive.connection = nil
    end
end

local function startAutoRevive()
    stopAutoRevive()
    revive.connection = RunService.Heartbeat:Connect(function(deltaTime)
        revive.elapsed = (revive.elapsed or 0) + deltaTime
        if revive.elapsed >= 0.1 then
            revive.elapsed = 0
            task.spawn(reviveStep)
        end
    end)
end

if _G.AutoReviveEnabled then
    startAutoRevive()
end

--ESP Players
local PlayerESP = {}
do
local ESP_TEXT_INTERVAL = 0.2
local espTextCache = {}
local Tracers = {}
local espWasActive = false

local function removeTracer(p)
    if Tracers[p] then
        Tracers[p].Visible = false
        Tracers[p]:Remove()
        Tracers[p] = nil
    end
end

local function removeESP(p)
    removeTracer(p)
    if p.Character then
        local h = p.Character:FindFirstChild("ESP_Highlight")
        if h then h:Destroy() end
        local head = p.Character:FindFirstChild("Head")
        if head then
            local bill = head:FindFirstChild("ESP_Billboard")
            if bill then bill:Destroy() end
        end
    end
end

local function createESP(p)
    if p == LocalPlayer or not _G.ESP_Master then return end
    local char = p.Character if not char then return end
    local head = char:FindFirstChild("Head") if not head then return end

    if not char:FindFirstChild("ESP_Highlight") then
        local h = Instance.new("Highlight")
        h.Name = "ESP_Highlight"
        h.FillColor = _G.ESP_HighlightColor
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.FillTransparency = 0.55
        h.OutlineTransparency = 0.1
        h.Adornee = char
        h.Parent = char
    end

    if not head:FindFirstChild("ESP_Billboard") then
        local bill = Instance.new("BillboardGui")
        bill.Name = "ESP_Billboard"
        bill.AlwaysOnTop = true
        bill.Size = UDim2.new(0, 200, 0, 160)
        bill.StudsOffset = Vector3.new(0, 4.5, 0)
        bill.Adornee = head
        bill.Parent = head

        local text = Instance.new("TextLabel", bill)
        text.Name = "InfoLabel"
        text.Size = UDim2.new(1, 0, 0, 130)
        text.BackgroundTransparency = 1
        text.TextStrokeTransparency = 0.1
        text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        text.Font = Enum.Font.GothamBold
        text.TextSize = _G.ESP_FontSize
        text.TextColor3 = Color3.fromRGB(255, 255, 255)
        text.RichText = true
        text.TextYAlignment = Enum.TextYAlignment.Bottom

        local barBG = Instance.new("Frame", bill)
        barBG.Name = "HealthBarBG"
        barBG.Size = UDim2.new(0, 110, 0, 5)
        barBG.Position = UDim2.new(0.5, -55, 0, 140)
        barBG.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        barBG.BorderSizePixel = 0
        barBG.Visible = false

        local cornerBG = Instance.new("UICorner")
        cornerBG.CornerRadius = UDim.new(1, 0)
        cornerBG.Parent = barBG

        local barFG = Instance.new("Frame", barBG)
        barFG.Name = "HealthBarFG"
        barFG.Size = UDim2.new(1, 0, 1, 0)
        barFG.BackgroundColor3 = Color3.fromRGB(0, 255, 130)
        barFG.BorderSizePixel = 0

        local cornerFG = Instance.new("UICorner")
        cornerFG.CornerRadius = UDim.new(1, 0)
        cornerFG.Parent = barFG
    end
end

local function updateTracer(p, targetHRP)
    if not _G.ESP_ShowTracers or not _G.ESP_Master then 
        removeTracer(p)
        return 
    end
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myHRP and targetHRP then
        local startPos, startEv = Camera:WorldToViewportPoint(myHRP.Position)
        local endPos, ev = Camera:WorldToViewportPoint(targetHRP.Position)
        if ev and startEv then
            local tr = Tracers[p] or Drawing.new("Line")
            Tracers[p] = tr
            tr.Visible = true
            tr.From = Vector2.new(startPos.X, startPos.Y)
            tr.To = Vector2.new(endPos.X, endPos.Y)
            tr.Color = _G.ESP_TracerColor
            tr.Thickness = 1.8
            tr.Transparency = 0.75
        else
            removeTracer(p)
        end
    else
        removeTracer(p)
    end
end

RunService.RenderStepped:Connect(function()
    if _G.ESP_Master then
        espWasActive = true
        local now = os.clock()
        local updateText = (now - _G.ESP_LastTextUpdate) >= ESP_TEXT_INTERVAL
        if updateText then _G.ESP_LastTextUpdate = now end

        local players = Players:GetPlayers()
        local localChar = LocalPlayer.Character
        local myHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")

        for _, p in ipairs(players) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local head = char:FindFirstChild("Head")
                local hrp2 = char:FindFirstChild("HumanoidRootPart")
                local hum2 = char:FindFirstChildOfClass("Humanoid")

                if head and hrp2 and hum2 then
                    createESP(p)

                    local bill = head:FindFirstChild("ESP_Billboard")
                    local h = char:FindFirstChild("ESP_Highlight")

                    if bill and h then
                        local info = bill:FindFirstChild("InfoLabel")
                        local barBG = bill:FindFirstChild("HealthBarBG")
                        local barFG = barBG and barBG:FindFirstChild("HealthBarFG")

                        if updateText then
                            local display = ""

                            if _G.ESP_ShowName then 
                                display = display .. "<b>" .. p.Name .. "</b>\n" 
                            end

                            espTextCache[p] = display
                            if info then 
                                info.Text = display 
                                info.TextSize = _G.ESP_FontSize
                            end
                        elseif info and espTextCache[p] then
                            info.Text = espTextCache[p]
                            info.TextSize = _G.ESP_FontSize
                        end

                        local hpText = ""
                        if _G.ESP_ShowHealth then 
                            hpText = '<font color="#FFFFFF">HP: ' .. math.floor(hum2.Health) .. "/" .. math.floor(hum2.MaxHealth) .. '</font> '
                        end

                        local distText = ""
                        if _G.ESP_ShowDistance and myHRP then 
                            distText = '<font color="#FFFFFF">[' .. math.floor((myHRP.Position - hrp2.Position).Magnitude) .. 'm]</font>' 
                        end

                        if info and (_G.ESP_ShowHealth or _G.ESP_ShowDistance) then
                            info.Text = (espTextCache[p] or "") .. hpText .. distText .. "\n"
                        end

                        if barBG and barFG then
                            if _G.ESP_ShowHealth then
                                barBG.Visible = true
                                local hpPercent = math.clamp(hum2.Health / hum2.MaxHealth, 0, 1)
                                barFG.Size = UDim2.fromScale(hpPercent, 1)

                                if hpPercent > 0.5 then
                                    barFG.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpPercent) * 2, 255, 50)
                                else
                                    barFG.BackgroundColor3 = Color3.fromRGB(255, 255 * hpPercent * 2, 50)
                                end
                            else
                                barBG.Visible = false
                            end
                        end
                    end

                    updateTracer(p, hrp2)
                else
                    removeESP(p)
                end
            else
                removeESP(p)
            end
        end
    elseif espWasActive then
        espWasActive = false
        espTextCache = {}
        for _, p in ipairs(Players:GetPlayers()) do
            removeESP(p)
        end
    end
end)

