        data.world = require(universe.ECS.world)
        data.comps = require(universe.ECS.components)
        data.replicator = require(ReplicatedStorage.Client.Universe.Replication.clientReplicator)
        return data
    end)

    if not ok then
        return
    end

    return result
end

local ItemECS = loadItemECS()

local function itemECSGet(id, component)
    if not ItemECS then
        return
    end

    local ok, value = pcall(ItemECS.world.get, ItemECS.world, id, component)
    if not ok then
        return
    end

    return value
end

local function getItemPosition(model, transform)
    if transform then
        if transform.Position then
            return transform.Position
        end
        if transform.p then
            return transform.p
        end
    end

    if model then
        return model:GetPivot().Position
    end
end

local function getItemPart(model)
    if not model then
        return
    end

    local primary = model.PrimaryPart
    if primary then
        return primary
    end

    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function getItemDistance(position)
    if not ItemECS then return 0 end
    local state = ItemECS.world:get_resource(ItemECS.comps.ClientStateResource)
    local character = state and state.localCharacter
    local myTransform = itemECSGet(character, ItemECS.comps.Transform)
    local myPosition = getItemPosition(character, myTransform)

    if myPosition and position then
        return (position - myPosition).Magnitude
    end

    local camera = workspace.CurrentCamera
    if camera and position then
        return (position - camera.CFrame.Position).Magnitude
    end

    return 0
end

local function removeItemTracer(model)
    local tracer = itemTracers[model]
    if tracer then
        tracer.Visible = false
        tracer:Remove()
        itemTracers[model] = nil
    end
end

local function removeItemESP(model)
    removeItemTracer(model)
    itemTextCache[model] = nil

    if model then
        local highlight = model:FindFirstChild("ESP_ItemHighlight")
        if highlight then
            highlight:Destroy()
        end

        local part = getItemPart(model)
        if part then
            local billboard = part:FindFirstChild("ESP_ItemBillboard")
            if billboard then
                billboard:Destroy()
            end
        end
    end
end

local function createItemESP(model, part, itemColor)
    if not model or not part then
        return
    end

    local highlight = model:FindFirstChild("ESP_ItemHighlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESP_ItemHighlight"
        highlight.Adornee = model
        highlight.Parent = model
    end
    highlight.FillColor = itemColor
    highlight.OutlineColor = itemColor
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    if not _G.ESP_ItemShowName and not _G.ESP_ItemShowDistance then
        local oldBillboard = part:FindFirstChild("ESP_ItemBillboard")
        if oldBillboard then
            oldBillboard:Destroy()
        end
        return
    end

    local billboard = part:FindFirstChild("ESP_ItemBillboard")
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_ItemBillboard"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 220, 0, 80)
        billboard.StudsOffset = Vector3.new(0, 2, 0)
        billboard.Adornee = part
        billboard.Parent = part

        local info = Instance.new("TextLabel")
        info.Name = "InfoLabel"
        info.Size = UDim2.new(1, 0, 1, 0)
        info.BackgroundTransparency = 1
        info.TextColor3 = itemColor
        info.TextStrokeTransparency = 0.1
        info.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        info.Font = Enum.Font.GothamBold
        info.TextWrapped = true
        info.TextYAlignment = Enum.TextYAlignment.Bottom
        info.Parent = billboard
    end

    local info = billboard:FindFirstChild("InfoLabel")
    if info then
        info.TextSize = _G.ESP_ItemFontSize
        info.TextColor3 = itemColor
    end
end

local function updateItemTracer(model, part, itemColor)
    if not _G.ESP_ItemShowTracers then
        removeItemTracer(model)
        return
    end
    if not part then
        removeItemTracer(model)
        return
    end

    local camera = workspace.CurrentCamera
    local localCharacter = LocalPlayer.Character
    local myHRP = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    if not camera or not myHRP then
        removeItemTracer(model)
        return
    end

    local startPosition, startVisible = camera:WorldToViewportPoint(myHRP.Position)
    local endPosition, endVisible = camera:WorldToViewportPoint(part.Position)
    if not startVisible or not endVisible then
        removeItemTracer(model)
        return
    end

    local tracer = itemTracers[model]
    if not tracer then
        tracer = Drawing.new("Line")
        itemTracers[model] = tracer
    end

    tracer.Visible = true
    tracer.From = Vector2.new(startPosition.X, startPosition.Y)
    tracer.To = Vector2.new(endPosition.X, endPosition.Y)
    tracer.Color = itemColor
    tracer.Thickness = 1.8
    tracer.Transparency = 0.75
end

local function updateItemESP()
    if not ItemECS then
        return
    end

    local now = os.clock()
    local updateText = now - itemLastTextUpdate >= ESP_TEXT_INTERVAL
    if updateText then
        itemLastTextUpdate = now
    end

    local alive = {}
    for id in ItemECS.world:query(ItemECS.comps.Storable, ItemECS.comps.ObjectId, ItemECS.comps.ModelInstance) do
        local model = itemECSGet(id, ItemECS.comps.ModelInstance)
        if model and model.Parent then
            local name = itemECSGet(id, ItemECS.comps.ObjectId)
            local transform = itemECSGet(id, ItemECS.comps.Transform)
            local position = getItemPosition(model, transform)
            local part = getItemPart(model)

            if part and position then
                alive[model] = true
                itemEntries[model] = part
                
                -- 取得對應的分類顏色（傳入名稱與 Model 進行智慧比對）
                local itemColor = getItemColor(name, model)
                createItemESP(model, part, itemColor)

                local distance = getItemDistance(position)
                local billboard = part:FindFirstChild("ESP_ItemBillboard")
                local info = billboard and billboard:FindFirstChild("InfoLabel")
                if info and updateText then
                    local lines = {}
                    if _G.ESP_ItemShowName then
                        table.insert(lines, tostring(name))
                    end
                    if _G.ESP_ItemShowDistance then
                        table.insert(lines, string.format("距離: %.0f", distance))
                    end
                    local text = table.concat(lines, "\n")
                    itemTextCache[model] = text
                    info.Text = text
                    info.TextSize = _G.ESP_ItemFontSize
                    info.TextColor3 = itemColor
                elseif info and itemTextCache[model] then
                    info.Text = itemTextCache[model]
                    info.TextSize = _G.ESP_ItemFontSize
                    info.TextColor3 = itemColor
                end

                updateItemTracer(model, part, itemColor)
            end
        end
    end

    for model in pairs(itemEntries) do
        if not alive[model] then
            removeItemESP(model)
            itemEntries[model] = nil
        end
    end
end

local function clearItemESP()
    for model in pairs(itemEntries) do
        removeItemESP(model)
        itemEntries[model] = nil
    end

    for model in pairs(itemTracers) do
        removeItemTracer(model)
    end
end

local function startItemESP()
    if itemESPConnection then
        return
    end

    itemESPWasActive = true
    itemESPConnection = RunService.RenderStepped:Connect(function()
        pcall(updateItemESP)
    end)
end

local function stopItemESP()
    if itemESPConnection then
        itemESPConnection:Disconnect()
        itemESPConnection = nil
    end

    itemESPWasActive = false
    clearItemESP()
end

local function refreshItemESP()
    if _G.ESP_ItemMaster then
        startItemESP()
    else
        stopItemESP()
    end
end

if _G.ESP_ItemMaster then
    refreshItemESP()
end

ItemESP.itemTracers = itemTracers
ItemESP.removeItemTracer = removeItemTracer
ItemESP.refreshItemESP = refreshItemESP
