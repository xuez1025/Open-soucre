        local name = indexed[index]
        if not name then break end
        table.insert(values, name)
    end

    return values
end

local function scanTeleportLocations()
    local values = { "初始區" }
    local included = { ["初始區"] = true }
    for _, safeZoneName in ipairs(scanSafeZones()) do
        table.insert(values, safeZoneName)
        included[safeZoneName] = true
    end

    for index in pairs(safeZoneSavedLocations) do
        local safeZoneName = "safezone_" .. tostring(index)
        if not included[safeZoneName] then
            table.insert(values, safeZoneName)
        end
    end

    table.sort(values, function(a, b)
        if a == "初始區" then return true end
        if b == "初始區" then return false end
        return (tonumber(string.match(a, "^safezone_(%d+)$")) or math.huge)
            < (tonumber(string.match(b, "^safezone_(%d+)$")) or math.huge)
    end)
    return values
end

