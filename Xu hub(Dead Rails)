local autopilotControls = nil
local autopilotPatched = setmetatable({}, { __mode = "k" })

local function patchAutopilotController(controller)
    if not controller or autopilotPatched[controller] then return end
    autopilotPatched[controller] = true

    local originalGetMoveVector = controller.GetMoveVector
    controller.GetMoveVector = function(self, ...)
        local moveVector = originalGetMoveVector(self, ...)

        if not _G.AutoPilotEnabled or not isSitting() then
            return moveVector
        end

        if not self:IsMoveVectorCameraRelative() then
            return moveVector
        end

        if moveVector.Magnitude > 0 then
            return moveVector
        end

        return Vector3.new(0, 0, -1)
    end
end

local function stopAutopilot()
    _G.AutoPilotEnabled = false
    pcall(function()
        RunService:UnbindFromRenderStep("DaraHubAutoPilot")
    end)
end

local function startAutopilot()
    if not autopilotControls then
        local ok, controls = pcall(function()
            local playerModule = LocalPlayer:WaitForChild("PlayerScripts")
                :WaitForChild("PlayerModule", 5)
            return require(playerModule):GetControls()
        end)

        if not ok or not controls then
            return false
        end
        autopilotControls = controls
    end

    pcall(function()
        RunService:UnbindFromRenderStep("DaraHubAutoPilot")
    end)

    RunService:BindToRenderStep(
        "DaraHubAutoPilot",
        Enum.RenderPriority.Input.Value - 1,
        function()
            local ok, controller = pcall(function()
                return autopilotControls:GetActiveController()
            end)
            if ok then
                patchAutopilotController(controller)
            end
        end
    )

    _G.AutoPilotEnabled = true
    return true
end

local function setAutopilot(state)
