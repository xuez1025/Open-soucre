        restoreCharacterState(safeZoneActiveState)
        safeZoneActiveState = nil
    end
end

local function startSafeZoneTeleport(indexOverride)
    stopSafeZoneTeleport()
    safeZoneRunId = safeZoneRunId + 1
    local runId = safeZoneRunId
    local forcedIndex = indexOverride

    task.spawn(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart")
        local humanoid = character:WaitForChild("Humanoid")
        if not hrp or not humanoid then return end

        if not waitForSitting(function()
            return (forcedIndex ~= nil or _G.SafeZoneTeleportEnabled)
                and runId == safeZoneRunId
        end) then return end

        local savedState = saveCharacterState(hrp, humanoid)
        safeZoneActiveState = savedState
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
        humanoid.AutoRotate = false
        hrp.Anchored = true

        local direction = Vector3.new(0, 0, -1)
        while (forcedIndex ~= nil or _G.SafeZoneTeleportEnabled) and runId == safeZoneRunId do
            if not character.Parent or not hrp.Parent then break end

            local targetIndex = math.max(
                math.floor(tonumber(forcedIndex or _G.SafeZoneIndex) or 1),
                1
            )
            local safeZoneCFrame = findSafeZone(targetIndex)

            if safeZoneCFrame then
                local arrived = moveWithLiveTweenSpeed(
                    hrp,
                    safeZoneCFrame * CFrame.new(0, 5, 0),
                    function()
                        return (forcedIndex ~= nil or _G.SafeZoneTeleportEnabled)
                            and runId == safeZoneRunId
                    end,
                    function(tween)
                        safeZoneActiveTween = tween
                    end
                )
                if not arrived then break end
                -- 只有實際抵達後，才把當前安全區座標寫入 Dropdown 可用的快取
                saveCurrentSafeZone(targetIndex, safeZoneCFrame)
                restoreCharacterState(savedState)
                break
            end

            local rotation = hrp.CFrame.Rotation
            local target = CFrame.new(hrp.Position + direction * 50) * rotation
            if not moveWithLiveTweenSpeed(hrp, target, function()
                return (forcedIndex ~= nil or _G.SafeZoneTeleportEnabled)
                    and runId == safeZoneRunId
            end, function(tween)
                safeZoneActiveTween = tween
            end) then
                break
            end
        end

        if runId == safeZoneRunId then
            restoreCharacterState(savedState)
            if safeZoneActiveState == savedState then
                safeZoneActiveState = nil
            end
        end
    end)
end

