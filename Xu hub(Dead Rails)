local savedStartingZoneCFrame = nil
local startingZoneTween = nil
local startingZoneRunId = 0
local saveCharacterState
local restoreCharacterState

local function getStartingZoneCFrame()
    local startingZone = workspace:FindFirstChild("StartingZone")
    if not startingZone then
        return nil, "找不到 workspace.StartingZone，無法儲存"
    end

    local ok, cframe = pcall(function()
        if startingZone:IsA("BasePart") then
            return startingZone.CFrame
        elseif startingZone:IsA("Model") then
            return startingZone:GetPivot()
        elseif startingZone:IsA("CFrameValue") then
            return startingZone.Value
        end
        return nil
    end)

    if not ok or typeof(cframe) ~= "CFrame" then
        return nil, "workspace.StartingZone 無法取得有效位置，無法儲存"
    end

    return cframe
end

local function recordStartingZone()
    local cframe, message = getStartingZoneCFrame()
    if cframe then
        savedStartingZoneCFrame = cframe
        return true
    end

    if typeof(savedStartingZoneCFrame) == "CFrame" then
        return true
    end

    return false, message or "找不到 workspace.StartingZone，無法儲存"
end

