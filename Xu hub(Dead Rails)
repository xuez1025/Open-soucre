end

-- 所有搜尋／傳送移動都必須在載具座位上進行；傳送到火車不使用此函式，因此維持例外。
local function waitForSitting(shouldContinue)
    while not isSitting() do
        if shouldContinue and not shouldContinue() then
            return false
        end
        task.wait(0.1)
    end
    return true
end

local function moveWithLiveTweenSpeed(hrp, targetCFrame, shouldContinue, setActiveTween)
    while true do
        if shouldContinue and not shouldContinue() then
            return false
        end
        if not isSitting() then
            return false
        end

        local distance = (targetCFrame.Position - hrp.Position).Magnitude
        if distance <= 0.05 then
            hrp.CFrame = targetCFrame
            if setActiveTween then setActiveTween(nil) end
            return true
        end

        local speed = getTweenSpeed()
        local duration = math.max(math.min(distance / speed, 0.12), 0.01)
        local tween = TweenService:Create(
            hrp,
            TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            { CFrame = targetCFrame }
        )

        if setActiveTween then setActiveTween(tween) end
        tween:Play()

        while tween.PlaybackState == Enum.PlaybackState.Playing do
            if shouldContinue and not shouldContinue() then
                tween:Cancel()
                if setActiveTween then setActiveTween(nil) end
                return false
            end
            if not isSitting() then
                tween:Cancel()
                if setActiveTween then setActiveTween(nil) end
                return false
            end

            if math.abs(getTweenSpeed() - speed) > 0.001 then
                tween:Cancel()
                break
            end
            task.wait(0.03)
        end

        if setActiveTween then setActiveTween(nil) end
    end
end

