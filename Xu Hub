local function StopAutoFpsLock()
    for _, conn in ipairs(_G.AutoFpsLockSignals) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(_G.AutoFpsLockSignals)

    pcall(function()
        if LocalPlayer then
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if playerGui then
                local main = playerGui:FindFirstChild("Main")
                if main then
                    local skills = main:FindFirstChild("Skills")
                    if skills then
                        for _, config in ipairs(skillConfigs) do
                            for _, styleName in ipairs(config.styles) do
                                local styleFolder = skills:FindFirstChild(styleName)
                                if styleFolder then
                                    local skillBtn = styleFolder:FindFirstChild(config.key)
                                    if skillBtn then
                                        local cooldown = skillBtn:FindFirstChild("Cooldown")
                                        if cooldown then
                                            cooldown:SetAttribute("AutoFpsBound", nil)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    if setfpscap then setfpscap(0) end
end

local function StartAutoFpsLock()
    StopAutoFpsLock()
    
    local isLocked = false
    local delayTask = nil
    
    task.spawn(function()
        while _G.AutoFpsLock and task.wait(0.5) do
            pcall(function()
                if not LocalPlayer then return end
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if not playerGui then return end
                local main = playerGui:FindFirstChild("Main")
                if not main then return end
                local skills = main:FindFirstChild("Skills")
                if not skills then return end
                
                for _, config in ipairs(skillConfigs) do
                    for _, styleName in ipairs(config.styles) do
                        local styleFolder = skills:FindFirstChild(styleName)
                        if styleFolder then
                            local skillBtn = styleFolder:FindFirstChild(config.key)
                            if skillBtn then
                                local cooldown = skillBtn:FindFirstChild("Cooldown")
                                if cooldown and not cooldown:GetAttribute("AutoFpsBound") then
                                    cooldown:SetAttribute("AutoFpsBound", true)
                                    local fullCdSize = UDim2.new(1, 0, 1, -1)
                                    
                                    if cooldown.Size == fullCdSize then
                                        if not isLocked and setfpscap then
                                            isLocked = true
                                            setfpscap(config.targetFps)
                                        end
                                    end
                                    
                                    local conn = cooldown:GetPropertyChangedSignal("Size"):Connect(function()
                                        if not _G.AutoFpsLock then return end
                                        
                                        if cooldown.Size == fullCdSize then
                                            if delayTask then delayTask = nil end
                                            if not isLocked and setfpscap then
                                                isLocked = true
                                                setfpscap(config.targetFps)
                                            end
                                        else
                                            if isLocked and not delayTask then
                                                delayTask = true
                                                task.spawn(function()
                                                    task.wait(0.01)
                                                    delayTask = nil
                                                    if setfpscap then
                                                        setfpscap(0)
                                                    end
                                                    isLocked = false
                                                end)
                                            end
                                        end
                                    end)
                                    table.insert(_G.AutoFpsLockSignals, conn)
                                end
                            end
                        end
                    end
                end
            end)
        end
        isLocked = false
        if setfpscap then setfpscap(0) end
    end)
end

if _G.AutoFpsLock then 
    StartAutoFpsLock() 
end

