-- 快速互動
local SavedPrompts = {}
local ppsLoop1, ppsLoop2

local function startInstantPrompts()
    if ppsLoop1 or ppsLoop2 then return end

    ppsLoop1 = ProximityPromptService.PromptShown:Connect(function(prompt)
        if SavedPrompts[prompt] then return end
        SavedPrompts[prompt] = prompt.HoldDuration
        prompt.HoldDuration = 0
    end)

    ppsLoop2 = ProximityPromptService.PromptHidden:Connect(function(prompt)
        if not SavedPrompts[prompt] then return end
        prompt.HoldDuration = SavedPrompts[prompt]
        SavedPrompts[prompt] = nil
    end)
end

local function stopInstantPrompts()
    if ppsLoop1 then ppsLoop1:Disconnect() ppsLoop1 = nil end
    if ppsLoop2 then ppsLoop2:Disconnect() ppsLoop2 = nil end

    for prompt, duration in pairs(SavedPrompts) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = duration
        end
    end
    table.clear(SavedPrompts)
end

local function toggleInstantPrompts(state)
    _G.InstantPrompts = state
    if state then
        startInstantPrompts()
    else
        stopInstantPrompts()
    end
end

