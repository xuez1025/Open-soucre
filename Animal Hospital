local espObjects = {}

local function clearESP()
    for _, item in ipairs(espObjects) do
        if item and item.Parent then
            item:Destroy()
        end
    end
    espObjects = {}
end

local function applyESP(targetData)
    local target = targetData.instance
    if not target or not target.Parent then return end
    
    local labelText = targetData.label
    local themeColor = targetData.color

    -- Highlight 外框高亮
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = target
    highlight.FillColor = themeColor
    highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = target
    table.insert(espObjects, highlight)

    -- 3D 文字標籤
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Adornee = target
    billboard.Size = UDim2.new(0, 100, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = labelText
    textLabel.TextColor3 = themeColor
    textLabel.TextStrokeTransparency = 0
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextSize = 14
    textLabel.Parent = billboard

    billboard.Parent = target
    table.insert(espObjects, billboard)
end

local function updateESP()
    clearESP()
    
    local wsChildren = workspace:GetChildren()
    for i = 1, math.min(100, #wsChildren) do
        local child = wsChildren[i]
        pcall(function()
            local items = child:FindFirstChild("Items")
            if items then
                for itemName, cfg in pairs(ITEM_CONFIGS) do
                    -- 檢查該物品對應的獨立開關是否開啟
                    if _G[cfg.Var] then
                        local folder = items:FindFirstChild(itemName)
                        if folder then
                            for _, item in ipairs(folder:GetChildren()) do
                                if item:IsA("BasePart") or item:IsA("Model") then
                                    applyESP({
                                        instance = item,
                                        label = itemName,
                                        color = cfg.Color
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end

