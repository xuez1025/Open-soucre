end

local function parseLightColor(color)
    if not color then return "⚪ 未知" end
    local r = math.round(color.R * 255)
    local g = math.round(color.G * 255)
    local b = math.round(color.B * 255)

    if math.abs(r - 165) <= 10 and math.abs(g - 0) <= 10 and math.abs(b - 0) <= 10 then
        return "🟢 有人"
    elseif math.abs(r - 27) <= 10 and math.abs(g - 42) <= 10 and math.abs(b - 53) <= 10 then
        return "🔴 沒人"
    end

    return string.format("⚪ 未知 (%d, %d, %d)", r, g, b)
end

