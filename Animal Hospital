local RoomButtons = {}

-- 取得房間物件（自動相容 Medical 與 Emergency 區域）
local function getRoomObject(roomName, index)
    local rooms = workspace:FindFirstChild("Rooms")
    if not rooms then return nil end

    -- 6~8 號房預設位於 Emergency，1~5 號房位於 Medical
    if index >= 6 then
        local emergency = rooms:FindFirstChild("Emergency")
        if emergency and emergency:FindFirstChild(roomName) then
            return emergency[roomName]
        end
    else
        local medical = rooms:FindFirstChild("Medical")
        if medical and medical:FindFirstChild(roomName) then
            return medical[roomName]
        end
    end

    -- 備用交叉搜尋（避免未解鎖或地圖結構變動導致無法定位）
    return (rooms:FindFirstChild("Medical") and rooms.Medical:FindFirstChild(roomName))
        or (rooms:FindFirstChild("Emergency") and rooms.Emergency:FindFirstChild(roomName))
end

for i = 1, 8 do
    local roomName = "Room" .. i
    RoomButtons[i] = Tabs.Teleport:Button({
        Title = "傳送至 房間 " .. i,
        Desc = "狀態: 檢測中...",
        Callback = function()
            local target = (workspace:FindFirstChild("Areas") and workspace.Areas:FindFirstChild(roomName))
                or getRoomObject(roomName, i)
            teleportTo(target)
        end
    })
end

local function parseLightColor(color)
    if not color then return "⚪ 未知" end
    local r = math.round(color.R * 255)
    local g = math.round(color.G * 255)
    local b = math.round(color.B * 255)

    if math.abs(r - 165) <= 10 and math.abs(g - 0) <= 10 and math.abs(b - 0) <= 10 then
        return "🟢 有人"
    elseif math.abs(r - 27) <= 10 and math.abs(g - 42) <= 10 and math.abs(b - 53) <= 10 then
        return "🔴 沒人"
    end

    return string.format("⚪ 未知 (%d, %d, %d)", r, g, b)
end

task.spawn(function()
    while getgenv().AnimalHospitalLoaded do
        for i = 1, 8 do
            local roomName = "Room" .. i
            local statusStr = "⚪ 尚未解鎖"

            local roomObj = getRoomObject(roomName, i)
            local mainSign = roomObj and roomObj:FindFirstChild("MainSign")
            local light = mainSign and mainSign:FindFirstChild("Light")

            if light then
                local col = light:IsA("BasePart") and light.Color or (light:IsA("Light") and light.Color or nil)
                statusStr = parseLightColor(col)
            end

            local btn = RoomButtons[i]
            if btn and btn.SetDesc then
                pcall(function()
                    btn:SetDesc("狀態: " .. statusStr)
                end)
            end
        end
        task.wait(1)
    end
end)

