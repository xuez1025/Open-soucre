-- 傳送房間
local function teleportTo(target)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        WindUI:Notify({ Title = "傳送失敗", Content = "角色尚未載入！", Duration = 3 })
        return
    end

    if typeof(target) == "Instance" then
        local targetPos
        if target:IsA("Model") then
            targetPos = target:GetPivot().Position
        elseif target:IsA("BasePart") then
            targetPos = target.Position
        end

        if targetPos then
            local finalPos = targetPos + Vector3.new(0, -15, 0)
            local _, currentYaw, _ = hrp.CFrame:ToOrientation()
            hrp.CFrame = CFrame.new(finalPos) * CFrame.Angles(0, currentYaw, 0)
            WindUI:Notify({ Title = "傳送成功", Content = "已傳送至 " .. target.Name, Duration = 2 })
        else
            WindUI:Notify({ Title = "傳送失敗", Content = "找不到目標位置！", Duration = 3 })
        end
    else
        WindUI:Notify({ Title = "傳送失敗", Content = "找不到目標位置！", Duration = 3 })
    end
end

