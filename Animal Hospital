local espHighlights = {}

local EXCLUDED_NAMES = {"ghost", "hider", "tall monster", "tallmonster"}

local function isExcluded(npc)
    local nameLower = string.lower(npc.Name)
    for _, filter in ipairs(EXCLUDED_NAMES) do
        if string.find(nameLower, filter) then
            return true
        end
    end
    return false
end

-- 判斷是否為 Skinwalker
local function checkSkinwalker(npc)
    local attr = npc:GetAttribute("Skinwalker")
    if attr == true or attr == "enabled" or attr == "Skinwalker" then return true end

    local child = npc:FindFirstChild("Skinwalker")
    if child then
        if child:IsA("BoolValue") and child.Value == true then return true end
        if (child:IsA("Script") or child:IsA("LocalScript")) and child.Enabled == true then return true end
    end
    return false
end

local function clearNPCESP()
    for _, highlight in pairs(espHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    espHighlights = {}
end

-- ESP
local function updateNPCESP()
    if not _G.NPCESPEnabled then
        clearNPCESP()
        return
    end

    local npcsFolder = Workspace:FindFirstChild("NPCs")
    local targets = npcsFolder and npcsFolder:GetChildren() or Workspace:GetChildren()
    local validNPCs = {}

    for _, npc in ipairs(targets) do
        if npc:IsA("Model") and (npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildOfClass("Humanoid")) then
            if not isExcluded(npc) then
                validNPCs[npc] = true
                local isSkinwalker = checkSkinwalker(npc) and _G.SkinwalkerESPEnabled

                -- 色彩設定: Skinwalker 為紅色（需開啟 Skinwalker toggle），普通 NPC 為綠色
                local targetColor = isSkinwalker and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 50)

                if not espHighlights[npc] then
                    local highlight = Instance.new("Highlight")
                    highlight.Adornee = npc
                    highlight.FillColor = targetColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.Parent = CoreGui
                    espHighlights[npc] = highlight
                else
                    espHighlights[npc].FillColor = targetColor
                end
            end
        end
    end

    for npc, highlight in pairs(espHighlights) do
        if not npc.Parent or not validNPCs[npc] then
            highlight:Destroy()
            espHighlights[npc] = nil
        end
    end
end

