local RoomButtons = {}

-- 取得房間物件（自動相容 Medical 與 Emergency 區域）
local function getRoomObject(roomName, index)
    local rooms = workspace:FindFirstChild("Rooms")
    if not rooms then return nil end

    -- 6~8 號房預設位於 Emergency，1~5 號房位於 Medical
    if index >= 6 then
        local emergency = rooms:FindFirstChild("Emergency")
        if emergency and emergency:FindFirstChild(roomName) then
            return emergency[roomName]
        end
    else
        local medical = rooms:FindFirstChild("Medical")
        if medical and medical:FindFirstChild(roomName) then
            return medical[roomName]
        end
    end

    -- 備用交叉搜尋（避免未解鎖或地圖結構變動導致無法定位）
    return (rooms:FindFirstChild("Medical") and rooms.Medical:FindFirstChild(roomName))
        or (rooms:FindFirstChild("Emergency") and rooms.Emergency:FindFirstChild(roomName))
end

