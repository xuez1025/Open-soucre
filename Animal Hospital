local ROOM_COLORS = {
    [1] = Color3.fromRGB(255, 75, 75),   -- Room 1: 鮮紅色
    [2] = Color3.fromRGB(255, 165, 0),  -- Room 2: 楓糖橘
    [3] = Color3.fromRGB(255, 235, 59),  -- Room 3: 亮黃色
    [4] = Color3.fromRGB(76, 175, 80),   -- Room 4: 薄荷綠
    [5] = Color3.fromRGB(0, 229, 255),   -- Room 5: 青藍色
    [6] = Color3.fromRGB(41, 121, 255),  -- Room 6: 寶藍色
    [7] = Color3.fromRGB(170, 0, 255),   -- Room 7: 紫色
    [8] = Color3.fromRGB(255, 64, 129)   -- Room 8: 粉紅色
}

local DEFAULT_COLOR = Color3.fromRGB(255, 255, 255)

local espObjects = {}

local function clearESP()
    for _, item in ipairs(espObjects) do
        if item and item.Parent then
            item:Destroy()
        end
    end
    espObjects = {}
end

local function generateColoredLabel(roomList)
    local labelText = ""
    for _, roomNum in ipairs(roomList) do
        local color = ROOM_COLORS[roomNum] or DEFAULT_COLOR
        local r = math.floor(color.R * 255)
        local g = math.floor(color.G * 255)
        local b = math.floor(color.B * 255)
        labelText = labelText .. string.format('<font color="rgb(%d,%d,%d)">[%d]</font>', r, g, b, roomNum)
    end
    return labelText
end

local function getNeededItemsFromRooms()
    local neededItems = {}
    local roomsFolder = workspace:FindFirstChild("Rooms")
    
    if not roomsFolder then return neededItems end

    local departmentFolders = {
        roomsFolder:FindFirstChild("Medical"),
        roomsFolder:FindFirstChild("Emergency")
    }

    for _, dept in ipairs(departmentFolders) do
        if dept then
            for roomNum = 1, 8 do
                local room = dept:FindFirstChild("Room" .. roomNum)
                if room then
                    local inv = room:FindFirstChild("Minigame") 
                        and room.Minigame:FindFirstChild("TV")
                        and room.Minigame.TV:FindFirstChild("Screen")
                        and room.Minigame.TV.Screen:FindFirstChild("UI")
                        and room.Minigame.TV.Screen.UI:FindFirstChild("Report")
                        and room.Minigame.TV.Screen.UI.Report:FindFirstChild("inv")

                    if inv then
                        for _, child in ipairs(inv:GetChildren()) do
                            if not child:IsA("UIGridLayout") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                                local itemName = child.Name
                                if not neededItems[itemName] then
                                    neededItems[itemName] = {}
                                end
                                
                                if not table.find(neededItems[itemName], roomNum) then
                                    table.insert(neededItems[itemName], roomNum)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    for itemName, roomList in pairs(neededItems) do
        table.sort(roomList)
    end

    return neededItems
end

local function getTargets(neededItems)
    local targets = {}
    local wsChildren = workspace:GetChildren()

    for i = 1, math.min(100, #wsChildren) do
        local child = wsChildren[i]

        pcall(function()
            local itemsFolder = child:FindFirstChild("Items")
            if itemsFolder then
                for itemName, roomList in pairs(neededItems) do
                    local folder = itemsFolder:FindFirstChild(itemName)
                    if folder then
                        local labelText = generateColoredLabel(roomList)
                        local primaryRoom = roomList[1]
                        local themeColor = ROOM_COLORS[primaryRoom] or DEFAULT_COLOR

                        for _, item in ipairs(folder:GetChildren()) do
                            if item:IsA("BasePart") or item:IsA("Model") then
                                table.insert(targets, {
                                    instance = item,
                                    label = labelText,
                                    color = themeColor
                                })
                            end
                        end
                    end
                end
            end
        end)
    end

    for i = 1, #wsChildren do
        local child = wsChildren[i]
        pcall(function()
            if child.Name ~= "Items" then
                for itemName, roomList in pairs(neededItems) do
                    local heldItem = child:FindFirstChild(itemName)
                    if heldItem and (heldItem:IsA("BasePart") or heldItem:IsA("Model") or heldItem:IsA("Tool")) then
                        local labelText = generateColoredLabel(roomList)
                        local primaryRoom = roomList[1]
                        local themeColor = ROOM_COLORS[primaryRoom] or DEFAULT_COLOR

                        table.insert(targets, {
                            instance = heldItem,
                            label = labelText,
                            color = themeColor
                        })
                    end
                end
            end
        end)
    end

    return targets
end

local function applyESP(targetData)
    local target = targetData.instance
    if not target or not target.Parent then return end

    local labelText = targetData.label
    local themeColor = targetData.color

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = target
    highlight.FillColor = themeColor
    highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Parent = target
    table.insert(espObjects, highlight)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Adornee = target
    billboard.Size = UDim2.new(0, 150, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.RichText = true -- 啟用 RichText 讓不同文字獨立套用色彩標籤
    textLabel.Text = labelText
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextSize = 24
    textLabel.Parent = billboard

    billboard.Parent = target
    table.insert(espObjects, billboard)
end

local function updateESP()
    clearESP()
    if not _G.ESP_NeededItems then return end

    local neededItems = getNeededItemsFromRooms()
    local targets = getTargets(neededItems)
    for _, targetData in ipairs(targets) do
        applyESP(targetData)
    end
end

task.spawn(function()
    while getgenv().AnimalHospitalLoaded do
        if _G.ESP_NeededItems then
            updateESP()
        else
            clearESP()
        end
        task.wait(1.5)
    end
    clearESP()
end)

