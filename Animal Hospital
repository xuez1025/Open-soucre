-- 理智全滿
local SanityLoopRunning = false
local SanityConnections = {}
local SanityLib

local function startSanityFull()
    if SanityLoopRunning then return end
    SanityLoopRunning = true

    local function keepSanityFull()
        LocalPlayer:SetAttribute("Sanity", 100)
    end

    -- 嘗試掛載遊戲 Lib 的 "PlayerLostSanity"，失敗不影響主功能
    if not SanityLib then
        pcall(function()
            SanityLib = require(ReplicatedStorage:WaitForChild("Lib"))
        end)
    end
    if SanityLib then
        pcall(function()
            SanityLib.Inject("PlayerLostSanity", keepSanityFull)
        end)
    end

    table.insert(SanityConnections, LocalPlayer:GetAttributeChangedSignal("Sanity"):Connect(keepSanityFull))
    table.insert(SanityConnections, RunService.Heartbeat:Connect(keepSanityFull))
    keepSanityFull()
end

local function stopSanityFull()
    if not SanityLoopRunning then return end
    SanityLoopRunning = false

    for _, conn in ipairs(SanityConnections) do
        conn:Disconnect()
    end
    table.clear(SanityConnections)

    if SanityLib then
        pcall(function()
            SanityLib.Uninject("PlayerLostSanity")
        end)
    end
end

local function toggleSanityFull(state)
    _G.SanityFull = state
    if state then
        startSanityFull()
    else
        stopSanityFull()
    end
end

