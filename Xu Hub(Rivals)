-- ── Toggle with pill ──────────────────────────────────────
-- 修正：將 Vis 註冊至 VisRefreshers[key]，快捷鍵觸發後可呼叫
local function MkToggle(parent, label, key, onChange)
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,32); row.BackgroundColor3=C2; row.BorderSizePixel=0
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,6)

    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(1,-54,1,0); lbl.Position=UDim2.new(0,10,0,0)
    lbl.Text=label; lbl.TextColor3=TXT; lbl.Font=FNT; lbl.TextSize=13
    lbl.BackgroundTransparency=1; lbl.TextXAlignment=Enum.TextXAlignment.Left

    local pill=Instance.new("Frame",row)
    pill.Size=UDim2.new(0,38,0,20); pill.Position=UDim2.new(1,-47,0.5,-10); pill.BorderSizePixel=0
    Instance.new("UICorner",pill).CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame",pill)
    knob.Size=UDim2.new(0,16,0,16); knob.BorderSizePixel=0
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local function Vis(instant)
        local on=NS[key]
        local pp=on and Accent or C3
        local kc=on and Color3.fromRGB(8,8,8) or DIM
        local kp=on and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
        if instant then
            pill.BackgroundColor3=pp; knob.BackgroundColor3=kc; knob.Position=kp
        else
            TS:Create(pill,TweenInfo.new(0.17),{BackgroundColor3=pp}):Play()
            TS:Create(knob,TweenInfo.new(0.17),{BackgroundColor3=kc,Position=kp}):Play()
        end
    end
    OnTheme(function() Vis(true) end)

    -- ← 註冊外部刷新入口
    VisRefreshers[key] = function() Vis(false) end

    row.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            NS[key]=not NS[key]; Vis(false); Save(); UpdateArr()
            if key=="ShowMobileButton" then MobBtn.Visible=NS[key] end
            if key=="RageGunsEnabled"  then _G.RageSettings.Enabled=NS[key] end
            if onChange then onChange(NS[key]) end
        end
    end)
    Vis(true)
    return row
end

