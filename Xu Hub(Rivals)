local function GetStickTarget()
    local target,closest=nil,9999
    local mp=UIS:GetMouseLocation()
    for _,v in pairs(Players:GetPlayers()) do
        if PassTargetChecks(v) then
            local root=v.Character.HumanoidRootPart
            local sp=Camera:WorldToViewportPoint(root.Position)
            local mag=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
            if mag<closest and IsVisible(root, v.Character) then
                closest=mag; target=root
            end
        end
    end
    return target
end

