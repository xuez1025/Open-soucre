local MenuOpen = false   -- 起始為關閉，INIT 時以 ToggleMenu 滑入
-- 視窗整體位置（× 按鈕需完全顯示在畫面內，故再上移 30px）
local MenuHiddenPos = UDim2.new(0.5,-TotalW/2,-1.2,-30)
local MenuShownPos  = UDim2.new(0.5,-TotalW/2,0.1,-30)
local function ToggleMenu()
    if MenuOpen then
        MenuOpen=false
        TS:Create(Win,TweenInfo.new(0.6,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
            {Position=MenuHiddenPos}):Play()
        TS:Create(MenuBlur,TweenInfo.new(0.4),{Size=0}):Play()
    else
        MenuOpen=true
        Win.Position=MenuHiddenPos
        TS:Create(Win,TweenInfo.new(0.6,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
            {Position=MenuShownPos}):Play()
        TS:Create(MenuBlur,TweenInfo.new(0.4),{Size=20}):Play()
    end
end

