local function MkAdjust(parent, label, key, step, isRage)
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,32); row.BackgroundColor3=C2; row.BorderSizePixel=0
    row.LayoutOrder=NextLayoutOrder()
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,6)

    local function Val() return isRage and _G.RageSettings[key] or NS[key] end

    -- 設定值（AimFOV 需同步到自瞄核心）
    local function SetVal(v)
        if key=="AimFOV" then AimSetFOV(v)
        else NS[key]=v; Save() end
    end

    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(0.52,0,1,0); lbl.Position=UDim2.new(0,10,0,0)
    lbl.Text=label; lbl.TextColor3=TXT; lbl.Font=FNT; lbl.TextSize=12
    lbl.BackgroundTransparency=1; lbl.TextXAlignment=Enum.TextXAlignment.Left

    local vLbl=Instance.new("TextLabel",row)
    vLbl.Size=UDim2.new(0,38,1,0); vLbl.Position=UDim2.new(0.52,0,0,0)
    vLbl.Text=tostring(Val()); vLbl.Font=FNT; vLbl.TextSize=12; vLbl.BackgroundTransparency=1
    vLbl.TextXAlignment=Enum.TextXAlignment.Center
    OnTheme(function() vLbl.TextColor3=Accent end)

    local function MkBtn(txt, xOff)
        local b=Instance.new("TextButton",row)
        b.Size=UDim2.new(0,26,0,22); b.Position=UDim2.new(1,xOff,0.5,-11)
        b.BackgroundColor3=C3; b.BorderSizePixel=0
        b.Font=FNT; b.Text=txt; b.TextSize=16
        Instance.new("UICorner",b).CornerRadius=UDim.new(0,5)
        OnTheme(function() b.TextColor3=Accent end)
        return b
    end
    local btnM=MkBtn("-",-58); local btnP=MkBtn("+",-28)

    local function Refresh() vLbl.Text=tostring(Val()) end
    btnM.MouseButton1Click:Connect(function()
        if isRage then _G.RageSettings[key]=math.max(0,_G.RageSettings[key]-step)
        else SetVal(NS[key]-step) end; Refresh()
    end)
    btnP.MouseButton1Click:Connect(function()
        if isRage then _G.RageSettings[key]=_G.RageSettings[key]+step
        else SetVal(NS[key]+step) end; Refresh()
    end)
end

