-- RenderStepped
RS.RenderStepped:Connect(function()
    local mouse=UIS:GetMouseLocation()
    local menuOpen=Win.Visible

    CursorBox.Visible=menuOpen; CursorBorder.Visible=menuOpen; CursorLabel.Visible=menuOpen
    CursorBox.Color=Accent

    if menuOpen then
        UIS.MouseIconEnabled=false
        CursorBox.Position=mouse-Vector2.new(3,3); CursorBorder.Position=mouse-Vector2.new(4,4)
        trailPos=trailPos:Lerp(mouse,0.15); CursorLabel.Position=trailPos+Vector2.new(12,12)
    else
        UIS.MouseIconEnabled=true
    end

    FOVCircle.Visible=NS.FOVVisible; FOVCircle.Position=mouse
    FOVCircle.Radius=NS.FOVSize;     FOVCircle.Color=Accent

    if NS.AimEnabled then
        local target=GetClosestTarget()
        if target then
            local pressed=false
            pcall(function()
                pressed = NS.AimBind:find("MouseButton") and
                    UIS:IsMouseButtonPressed(Enum.UserInputType[NS.AimBind]) or
                    UIS:IsKeyDown(Enum.KeyCode[NS.AimBind])
            end)
            if pressed then
                local tPos=Camera:WorldToViewportPoint(target.Position)
                if NS.Hardlock then
                    mousemoverel(tPos.X-mouse.X, tPos.Y-mouse.Y)
                else
                    local smooth=NS.SmoothEnabled and NS.SmoothValue or 0
                    if smooth<=1 then
                        mousemoverel(tPos.X-mouse.X, tPos.Y-mouse.Y)
                    else
                        local w=1/(math.pow(smooth,1.8)*0.02)
                        mousemoverel((tPos.X-mouse.X)*w,(tPos.Y-mouse.Y)*w)
                    end
                end
            end
        end
    end
end)

-- Heartbeat
RS.Heartbeat:Connect(function()
    if not LP.Character then return end
    local Root=LP.Character:FindFirstChild("HumanoidRootPart")

    if NS.HvHMovement and Root then
        local av=Root.Velocity
        Root.Velocity=av+Vector3.new(math.random(-250,250),math.random(-5,5),math.random(-250,250))
        RS.RenderStepped:Wait()
        Root.Velocity=av
        Root.CFrame=Root.CFrame*CFrame.Angles(0,math.rad(math.random(-5,5)),0)
    end

    if NS.Fly and Root then
        local vel=Vector3.new(0,0,0)
        if UIS:IsKeyDown(Enum.KeyCode.W) then vel=vel+(Camera.CFrame.LookVector*NS.FlySpeed) end
        if UIS:IsKeyDown(Enum.KeyCode.S) then vel=vel-(Camera.CFrame.LookVector*NS.FlySpeed) end
        if UIS:IsKeyDown(Enum.KeyCode.A) then vel=vel-(Camera.CFrame.RightVector*NS.FlySpeed) end
        if UIS:IsKeyDown(Enum.KeyCode.D) then vel=vel+(Camera.CFrame.RightVector*NS.FlySpeed) end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vel=vel+(Vector3.new(0,1,0)*NS.FlySpeed) end
        Root.Velocity=Vector3.new(0,0,0)
        Root.CFrame=Root.CFrame+(vel*RS.Heartbeat:Wait())
    end

    if NS.StickEnabled and Root then
        if not NS.StickTarget or not NS.StickTarget.Parent or NS.StickTarget.Parent.Humanoid.Health<=0 then
            NS.StickTarget=GetStickTarget()
        end
        if NS.StickTarget then
            local angle=NS.StickSpin and tick()*NS.SpinBotSpeed or 0
            local offset=Vector3.new(math.cos(angle)*NS.StickDistance,NS.StickHeight,math.sin(angle)*NS.StickDistance)
            Root.CFrame=CFrame.new(NS.StickTarget.Position+offset,NS.StickTarget.Position)
            Root.Velocity=Vector3.new(0,0,0)
        end
    else
        NS.StickTarget=nil
    end

    if NS.Noclip then
        for _,v in pairs(LP.Character:GetChildren()) do
            if v:IsA("BasePart") then v.CanCollide=false end
        end
    end
end)

