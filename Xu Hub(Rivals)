UIS.InputBegan:Connect(function(i,g)
    if not g then
        -- 飛行快捷鍵
        if i.KeyCode.Name == NS.FlyBind then
            NS.Fly = not NS.Fly
            RefreshKey("Fly")      -- ← 同步 GUI pill
            Save(); UpdateArr()
        end

        -- 跟隨玩家快捷鍵
        if i.KeyCode.Name == NS.StickBind then
            NS.StickEnabled = not NS.StickEnabled
            if NS.StickEnabled then NS.StickTarget = GetStickTarget() end
            RefreshKey("StickEnabled")  -- ← 同步 GUI pill（含展開/收合）
            Save(); UpdateArr()
        end

        -- 選單快捷鍵
        if i.KeyCode.Name == NS.MenuBind and MGui.Parent then
            ToggleMenu()
        end
    end
end)

