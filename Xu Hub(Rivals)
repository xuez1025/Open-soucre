-- ┌─────────────────────────────────────────┐
-- │  TARGET CHECKS（自瞄 / 跟隨玩家共用）    │
-- └─────────────────────────────────────────┘
local KOTags = {"K.O", "KO", "Knocked", "Knockout", "Downed"}
local trueVal = function(v) return v == true or v == 1 or v == "true" end

-- 玩家 / 角色是否帶有指定狀態屬性
local function HasStateFlag(plr, char, keys)
    for _,k in ipairs(keys) do
        if trueVal(plr:GetAttribute(k)) then return true end
        if char and trueVal(char:GetAttribute(k)) then return true end
    end
    return false
end

-- 隊友檢測（TeamID 屬性優先，其次 Team 物件）
local function IsTeammate(plr)
    if not NS.TeamCheck then return false end
    if not plr then return false end
    local myTeam = LP:GetAttribute("TeamID")
    local theirTeam = plr:GetAttribute("TeamID")
    if myTeam ~= nil and theirTeam ~= nil then return myTeam == theirTeam end
    return LP.Team ~= nil and plr.Team ~= nil and LP.Team == plr.Team
end

-- 倒地檢測
local function IsKnocked(char)
    local be = char:FindFirstChild("BodyEffects")
    if be then
        for _,n in ipairs(KOTags) do
            local v = be:FindFirstChild(n)
            if v and v.Value then return true end
        end
    end
    return false
end

-- 穿牆檢測（射線是否被地圖擋住）
local function IsVisible(part, char)
    if not NS.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character, char, Camera}
    local ray = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
    return (not ray) or ray.Instance:IsDescendantOf(char)
end

-- 統一的目標檢查：回傳 true 表示可作為目標
local function PassTargetChecks(plr)
    if not plr or plr == LP then return false end
    local char = plr.Character
    if not char or not char.Parent then return false end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end

    -- 出生無敵 / 觀戰
    if NS.SpawnCheck and char:FindFirstChildOfClass("ForceField") then return false end
    if NS.RespawnCheck and HasStateFlag(plr, char, {"IsRespawning"}) then return false end

    if NS.TeamCheck and IsTeammate(plr) then return false end
    if NS.KatanaCheck and char:FindFirstChild("Katana") then return false end
    if NS.KOCheck and IsKnocked(char) then return false end
    return true
end

-- 大廳 / 安全區 / 觀戰 檢查（只影響自瞄）
local function PassAimWorldChecks(plr)
    local char = plr.Character
    if NS.LobbyCheck and HasStateFlag(LP, LP.Character, {"InLobby", "InSpawn", "IsSpectating", "InIntermission"}) then
        return false
    end
    if NS.SafeZoneCheck then
        if HasStateFlag(plr, char, {"InSafeZone", "InSpawn"}) then return false end
        if HasStateFlag(LP, LP.Character, {"InSafeZone", "InSpawn"}) then return false end
    end
    return true
end

local function AimIsAlive(plr)
    if not plr.Character then return false end
    local hum=plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health>0
end

-- 依「鎖定部位」取得要瞄準的部件
local function AimGetPart(char)
    local partMode = NS.AimPart or "頭部"
    if partMode=="隨機" then
        local pool={}
        local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso then table.insert(pool,torso) end
        local arms={char:FindFirstChild("LeftUpperArm"), char:FindFirstChild("RightUpperArm"),
                    char:FindFirstChild("Left Arm"), char:FindFirstChild("Right Arm")}
        for _,a in pairs(arms) do if a then table.insert(pool,a) end end
        if #pool==0 then return char:FindFirstChild("Head") end
        return pool[math.random(1,#pool)]
    elseif partMode=="軀幹" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif partMode=="手臂" then
        local arms={char:FindFirstChild("LeftUpperArm"), char:FindFirstChild("RightUpperArm"),
                    char:FindFirstChild("Left Arm"), char:FindFirstChild("Right Arm")}
        local valid={}
        for _,a in pairs(arms) do if a then table.insert(valid,a) end end
        if #valid==0 then return char:FindFirstChild("Head") end
        return valid[math.random(1,#valid)]
    end
    return char:FindFirstChild("Head")
end

local function AimTargetInFOV()
    local center=Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local best,bestDist=nil, AIM.FOV/2
    for _,plr in pairs(Players:GetPlayers()) do
        if plr~=LP and AimIsAlive(plr) and plr.Character
            and PassTargetChecks(plr) and PassAimWorldChecks(plr) then
            local part=AimGetPart(plr.Character)
            if part then
                local sp,onScreen=Camera:WorldToViewportPoint(part.Position)
                if onScreen and IsVisible(part, plr.Character) then
                    local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
                    if d<=bestDist then bestDist=d; best=part end
                end
            end
        end
    end
    return best
end

