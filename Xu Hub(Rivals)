local function IsVisible(part, character)
    if not NS.WallCheck then return true end
    local rp=RaycastParams.new()
    rp.FilterType=Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances={LP.Character,Camera}
    local result=workspace:Raycast(Camera.CFrame.Position,(part.Position-Camera.CFrame.Position).Unit*1000,rp)
    return not result or result.Instance:IsDescendantOf(character)
end

local function GetStickTarget()
    local target,closest=nil,9999
    local mp=UIS:GetMouseLocation()
    for _,v in pairs(Players:GetPlayers()) do
        if v~=LP and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character.Humanoid.Health>0 then
            if NS.KatanaCheck and v.Character:FindFirstChild("Katana") then continue end
            local sp=Camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            local mag=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
            if mag<closest then closest=mag; target=v.Character.HumanoidRootPart end
        end
    end
    return target
end

local function GetClosestTarget()
    local target,closest=nil,NS.FOVSize
    local mp=UIS:GetMouseLocation()
    for _,v in pairs(Players:GetPlayers()) do
        if v~=LP and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health>0 then
            if NS.TeamCheck and v.Team==LP.Team then continue end
            if NS.KatanaCheck and v.Character:FindFirstChild("Katana") then continue end
            local part
            if NS.AimPart=="Closest" then
                local minD=9999
                for _,child in pairs(v.Character:GetChildren()) do
                    if child:IsA("BasePart") then
                        local sp,on2=Camera:WorldToViewportPoint(child.Position)
                        if on2 then
                            local mag=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
                            if mag<minD then minD=mag; part=child end
                        end
                    end
                end
            else
                part=v.Character:FindFirstChild(NS.AimPart)
            end
            if part then
                local sp,on2=Camera:WorldToViewportPoint(part.Position)
                if on2 then
                    local mag=(Vector2.new(sp.X,sp.Y)-mp).Magnitude
                    if mag<closest and IsVisible(part,v.Character) then
                        closest=mag; target=part
                    end
                end
            end
        end
    end
    return target
end

