local function GoTab(id)
    if CurTab==id then return end; CurTab=id
    for tid,p in pairs(Pages) do p.Visible=(tid==id) end
    for tid,tb in pairs(TabBtns) do
        local act=(tid==id)
        tb.btn.BackgroundColor3=act and C2 or C1
        tb.btn.TextColor3      =act and Accent or DIM
        tb.ind.BackgroundColor3=act and Accent or Color3.new(0,0,0)
        tb.ind.BackgroundTransparency=act and 0 or 1
    end
end

