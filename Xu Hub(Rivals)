-- ── Toggle（膠囊式，按下滑動變色）──────────────────────────
-- subBuild：子選項（例如數值調整、裝置按鈕），僅在開啟時顯示
-- subHeight：可省略；未給時自動量測子選項內容高度
-- 版面：外層 wrapper 由 UIListLayout 排版；開關固定 32 高，子選項以內容高度撐開
local function MkToggle(parent, label, key, onChange, subBuild, subHeight)
    -- 外層：固定寬度由清單決定；高度 = 32（開關）+ 展開時的子選項高度
    local wrapper=Instance.new("Frame",parent)
    wrapper.Size=UDim2.new(1,0,0,32); wrapper.BackgroundTransparency=1
    wrapper.ClipsDescendants=true
    wrapper.LayoutOrder=NextLayoutOrder()

    local B=Instance.new("TextButton",wrapper)
    B.Size=UDim2.new(1,0,0,32); B.BorderSizePixel=0; B.AutoButtonColor=false
    B.BackgroundColor3=C1; B.BackgroundTransparency=0.1
    B.Font=FNT; B.TextSize=14; B.Text=label; B.TextColor3=TXT
    B.TextXAlignment=Enum.TextXAlignment.Left
    Instance.new("UIPadding",B).PaddingLeft=UDim.new(0,10)
    Instance.new("UICorner",B).CornerRadius=UDim.new(0,6)
    local St=Instance.new("UIStroke",B)
    St.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; St.Thickness=1

    local pill=Instance.new("Frame",B)
    pill.Size=UDim2.new(0,38,0,20); pill.Position=UDim2.new(1,-47,0.5,-10); pill.BorderSizePixel=0
    Instance.new("UICorner",pill).CornerRadius=UDim.new(0,12)

    local knob=Instance.new("Frame",pill)
    knob.Size=UDim2.new(0,16,0,16); knob.BorderSizePixel=0
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local sub=nil
    local subContentH = subHeight or 0
    if subBuild then
        -- 子選項容器：高度依內容自動量測（不再依賴手動填的高度）
        sub=Instance.new("Frame",wrapper)
        sub.BackgroundTransparency=1; sub.BorderSizePixel=0
        sub.Size=UDim2.new(1,0,0,0); sub.Position=UDim2.new(0,0,0,34)
        sub.ClipsDescendants=true
        local subLL=Instance.new("UIListLayout",sub)
        subLL.Padding=UDim.new(0,4)
        subLL.SortOrder=Enum.SortOrder.LayoutOrder
        local subPad=Instance.new("UIPadding",sub)
        subPad.PaddingLeft=UDim.new(0,6)
        subPad.PaddingBottom=UDim.new(0,4)
        subBuild(sub)
        -- 內容建立後量測實際高度（UIListLayout 排版可能延遲一幀）
        if not subHeight then
            local t0 = os.clock()
            while subLL.AbsoluteContentSize.Y <= 0 and os.clock()-t0 < 0.2 do
                RS.Heartbeat:Wait()
            end
            subContentH = math.max(0, math.ceil(subLL.AbsoluteContentSize.Y))
        end
    end

    local function Vis(instant)
        local on=NS[key]
        local txt    = on and Accent or TXT
        local stroke = on and Accent or Color3.fromRGB(20,20,20)
        local pp     = on and Accent or C3
        local kc     = on and Color3.fromRGB(8,8,8) or DIM
        local kp     = on and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
        B.TextColor3=txt; St.Color=stroke
        pill.BackgroundColor3=pp; knob.BackgroundColor3=kc; knob.Position=kp
        if not instant then
            TS:Create(pill,TweenInfo.new(0.17),{BackgroundColor3=pp}):Play()
            TS:Create(knob,TweenInfo.new(0.17),{BackgroundColor3=kc,Position=kp}):Play()
        end
        if sub then
            -- 子選項依內容高度展開；外框同步增高，清單排列才不會重疊
            local subTarget=UDim2.new(1,0,0, on and subContentH or 0)
            local wrapTarget=UDim2.new(1,0,0, on and (32+subContentH) or 32)
            if instant then
                sub.Size=subTarget; wrapper.Size=wrapTarget
            else
                TS:Create(sub,TweenInfo.new(0.25,Enum.EasingStyle.Quart),{Size=subTarget}):Play()
                TS:Create(wrapper,TweenInfo.new(0.25,Enum.EasingStyle.Quart),{Size=wrapTarget}):Play()
            end
        end
    end
    -- 只更新顏色，不動版面
    OnTheme(function()
        local on=NS[key]
        B.TextColor3=on and Accent or TXT
        St.Color=on and Accent or Color3.fromRGB(20,20,20)
        pill.BackgroundColor3=on and Accent or C3
        knob.BackgroundColor3=on and Color3.fromRGB(8,8,8) or DIM
        knob.Position=on and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
    end)

    -- 註冊外部刷新入口（快捷鍵觸發時同步外觀）
    VisRefreshers[key] = function() Vis(false) end

    B.MouseButton1Click:Connect(function()
        NS[key]=not NS[key]; Vis(false); Save(); UpdateArr()
        if key=="ShowMobileButton" then MobBtn.Visible=NS[key] end
        if key=="RageGunsEnabled"  then _G.RageSettings.Enabled=NS[key] end
        if key=="AimSnapEnabled"   then AIM.Enabled=NS[key]; AimUpdateCircle() end
        if onChange then onChange(NS[key]) end
    end)
    Vis(true)
    return B
end

