local function CreateESP(plr)
    local hl=Instance.new("Highlight")
    hl.Parent=CoreGui; hl.Name="XuCharms_"..plr.Name
    RS.RenderStepped:Connect(function()
        local Char=plr.Character
        if Char and Char:FindFirstChild("HumanoidRootPart") and plr~=LP
            and Char:FindFirstChild("Humanoid") and Char.Humanoid.Health>0 then
            hl.Enabled          = NS.CharmsOutline
            hl.Adornee          = Char
            hl.FillColor        = Accent
            hl.FillTransparency = 1
            hl.OutlineColor     = Accent
            hl.OutlineTransparency = NS.CharmsOutline and 0 or 1
            return
        end
        hl.Enabled=false
    end)
end
for _,p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)

