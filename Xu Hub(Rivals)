    if drag.on and i.UserInputType==Enum.UserInputType.MouseMovement then
        local d=i.Position-drag.s
        local obj=drag.target or Win
        obj.Position=UDim2.new(drag.p.X.Scale,drag.p.X.Offset+d.X,drag.p.Y.Scale,drag.p.Y.Offset+d.Y)
