local function UpdateArr()
    if not NS.ShowArrayList then
        for _,v in pairs(ArrLabels) do v.obj:Destroy() end; ArrLabels={}; return
    end
    for _,feat in pairs(GetArrFeats()) do
        local name, enabled = feat[1], feat[2]
        if enabled and not ArrLabels[name] then
            local lbl = Instance.new("TextLabel", ArrHolder)
            lbl.Name=name; lbl.Size=UDim2.new(0,0,0,22); lbl.BorderSizePixel=0
            lbl.BackgroundColor3=C1; lbl.BackgroundTransparency=0.05
            lbl.TextColor3=Accent; lbl.Text=" "..name.." "
            lbl.Font=FNT; lbl.TextSize=14
            lbl.TextXAlignment=Enum.TextXAlignment.Right; lbl.ClipsDescendants=true
            local bar = Instance.new("Frame", lbl)
            bar.Size=UDim2.new(0,2,1,0); bar.Position=UDim2.new(1,-2,0,0)
            bar.BackgroundColor3=Accent; bar.BorderSizePixel=0
            ArrLabels[name] = {obj=lbl, bar=bar}
            local w = game:GetService("TextService"):GetTextSize(
                lbl.Text,lbl.TextSize,lbl.Font,Vector2.new(600,600)).X+10
            TS:Create(lbl,TweenInfo.new(0.3,Enum.EasingStyle.Quart),{Size=UDim2.new(0,w,0,22)}):Play()
        elseif not enabled and ArrLabels[name] then
            local obj=ArrLabels[name].obj; ArrLabels[name]=nil
            local t=TS:Create(obj,TweenInfo.new(0.2,Enum.EasingStyle.Quart),{Size=UDim2.new(0,0,0,22)})
            t:Play(); t.Completed:Connect(function() obj:Destroy() end)
        end
    end
    for _,v in pairs(ArrLabels) do
        v.obj.TextColor3=Accent; v.bar.BackgroundColor3=Accent
    end
end
OnTheme(function() UpdateArr() end)

