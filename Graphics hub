--衝刺修改
local DashConnection = nil

local function ManageDashLength()
    if _G.DashLengthEnabled then
        if DashConnection then 
            task.cancel(DashConnection) 
            DashConnection = nil
        end
        
        DashConnection = task.spawn(function()
            while _G.DashLengthEnabled do
                local character = LocalPlayer and LocalPlayer.Character
                if character then
                    local currentValue = character:GetAttribute("DashLength")
                    if currentValue ~= _G.DashLength then
                        character:SetAttribute("DashLength", _G.DashLength)
                        character:SetAttribute("DashLengthAir", _G.DashLength)
                    end
                end
                task.wait(0.1)
            end
        end)
    else
        if DashConnection then
            task.cancel(DashConnection)
            DashConnection = nil
        end
        
        local character = LocalPlayer and LocalPlayer.Character
        if character then
            character:SetAttribute("DashLength", 1)
            character:SetAttribute("DashLengthAir", 1)
        end
    end
end

if _G.DashLengthEnabled then 
    ManageDashLength() 
end

--突破FPS
local function applyFPSCap(state)
    if state then
        if setfpscap then
            setfpscap(999)
        end
    else
        if setfpscap then
            setfpscap(0)
        end
    end
end

--低配模式
_G.SetLowVisualState = function(state)
    _G.LowVisualMode = state
    
    if _G.LowVisualMode then
        WindUI:Notify({ 
            Title = "優化系統", 
            Content = "低配模式已啟動，正在清理地圖並優化效能...", 
            Duration = 3 
        })
        
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj:Destroy()
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
            elseif obj:IsA("PostEffect") or obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("DepthOfFieldEffect") or obj:IsA("SunRaysEffect") then
                obj.Enabled = false
            end
        end
        
        if not _G.LowVisualConnection then
            _G.LowVisualConnection = Workspace.DescendantAdded:Connect(function(obj)
                if obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj:Destroy()
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                    obj.Enabled = false
                end
            end)
        end
    else
        if _G.LowVisualConnection then
            _G.LowVisualConnection:Disconnect()
            _G.LowVisualConnection = nil
        end
    end
end

--移除迷霧
_G.ApplyRemoveFog = function()
    local layers = Lighting:FindFirstChild("LightingLayers")
    if layers then pcall(function() layers:Destroy() end) end
    
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if sky then pcall(function() sky:Destroy() end) end
    
    Lighting.FogEnd = 9e9
end

local function ToggleFogService(enable)
    _G.RemoveFogEnabled = enable
    
    if enable then
        _G.ApplyRemoveFog()
        
        if not fogConnection then
            fogConnection = Lighting:GetPropertyChangedSignal("FogEnd"):Connect(function()
                if _G.RemoveFogEnabled and Lighting.FogEnd ~= 9e9 then
                    Lighting.FogEnd = 9e9
                end
            end)
        end
    else
        if fogConnection then
            fogConnection:Disconnect()
            fogConnection = nil
        end
    end
end

--Day&Night
Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
    if _G.DayToggleState then
        if Lighting.ClockTime ~= 14 then
            Lighting.ClockTime = 14
        end
    elseif _G.NightToggleState then
        if Lighting.ClockTime ~= 0 then
            Lighting.ClockTime = 0
        end
    end
end)

