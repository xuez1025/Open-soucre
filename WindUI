-- WindUI 載入
local WindUI = loadstring(game:HttpGet(
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
))()

local Window = WindUI:CreateWindow({
    Title         = "Xu-hub",
    Icon          = "user-check",
    Author        = "by xuez1025",
    Folder        = "Xu-Hub",
    Size          = UDim2.fromOffset(600, 400),
    Transparent   = true,
    Theme         = "Dark",
    User = {
        Enabled   = true,
        Anonymous = false,
        Callback  = function()
            local LocalPlayer = game.Players.LocalPlayer
            WindUI:Notify({ 
                Title = LocalPlayer.Name, 
                Content = "ID: " .. LocalPlayer.UserId, 
                Duration = 3 
            })
        end
    },
    Acrylic       = false,
    HideSearchBar = false,
    SideBarWidth  = 200,
    OpenButton = {
        Title           = "Xu-hub",
        CornerRadius    = UDim.new(1, 0),
        StrokeThickness = 3,
        Enabled         = true,
        OnlyMobile      = false,
        Draggable       = true,
        OnlyIcon        = false,
        Color           = ColorSequence.new(Color3.fromHex("#7F00FF"), Color3.fromHex("#00C6FF")),
    }
})

--變數
_G.CurrentKey = "G"
_G.KeyDisabled = false

_G.TestToggleValue = false
_G.TestSliderValue = 50
_G.TestDropdownValue = "選項1"

-- 建立分頁
local Tabs = {
    Components = Window:Tab({ Title = "元件測試", Icon = "box" }),
    Settings = Window:Tab({ Title = "設定", Icon = "settings" })
}

-- ==================== 新增元件測試分頁 ====================
Tabs.Components:Section({ Title = "全域變數元件測試 (示範)" })

-- 按鈕 (Button)
Tabs.Components:Button({
    Title = "測試按鈕",
    Callback = function()
        WindUI:Notify({ 
            Title = "系統提示", 
            Content = "當前綁定的快捷鍵為: " .. _G.CurrentKey, 
            Duration = 3 
        })
    end
})

-- 開關 (Toggle)
Tabs.Components:Toggle({
    Title = "測試開關",
    Value = _G.TestToggleValue,
    Callback = function(state)
        _G.TestToggleValue = state
    end
})

-- 滑動條 (Slider)
Tabs.Components:Slider({
    Title = "測試滑塊",
    Step = 1,
    Value = {
        Min = 0,
        Max = 100,
        Default = _G.TestSliderValue
    },
    Callback = function(value)
        _G.TestSliderValue = value
    end
})

-- 下拉選單 (Dropdown)
Tabs.Components:Dropdown({
    Title = "測試下拉選單",
    Value = _G.TestDropdownValue,
    Values = {"選項1", "選項2", "選項3"},
    Callback = function(value)
        _G.TestDropdownValue = value
    end
})

-- ==================== 設定分頁 ====================
Tabs.Settings:Section({ Title = "快捷鍵設定" })

Tabs.Settings:Keybind({ 
    Title = "快捷鍵", 
    Desc = "可更改", 
    Value = _G.CurrentKey,
    Callback = function(v)
        _G.CurrentKey = v
        
        if not _G.KeyDisabled then
            Window:SetToggleKey(Enum.KeyCode[v])
        end
    end
})

Tabs.Settings:Toggle({
    Title = "停用快捷鍵",
    Desc = "開啟後將禁用快捷鍵",
    Value = _G.KeyDisabled,
    Callback = function(state)
        _G.KeyDisabled = state
        
        if state then
            -- 停用快捷鍵
            Window:SetToggleKey(nil)
        else
            -- 恢復快捷鍵
            Window:SetToggleKey(Enum.KeyCode[_G.CurrentKey])
        end
    end
})
