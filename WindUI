--------------------------
-- WindUI 載入
--------------------------
local WindUI = loadstring(request({
    Url = "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"
}).Body)()

local Window = WindUI:CreateWindow({
    Title         = "Xu-hub",
    Icon          = "user-check",
    Author        = "by xuez1025",
    Folder        = "Xu-Hub",
    Size          = UDim2.fromOffset(600, 400),
    Transparent   = true,
    Theme         = "Dark",
    User = {
        Enabled   = true,
        Anonymous = false,
        Callback  = function()
            local LocalPlayer = game.Players.LocalPlayer
            WindUI:Notify({ 
                Title = LocalPlayer.Name, 
                Content = "ID: " .. LocalPlayer.UserId, 
                Duration = 3 
            })
        end
    },
    Acrylic       = false,
    HideSearchBar = false,
    SideBarWidth  = 200,
    OpenButton = {
        Title           = "Xu-hub",
        CornerRadius    = UDim.new(1, 0),
        StrokeThickness = 3,
        Enabled         = true,
        OnlyMobile      = false,
        Draggable       = true,
        OnlyIcon        = false,
        Color           = ColorSequence.new(Color3.fromHex("#7F00FF"), Color3.fromHex("#00C6FF")),
    }
})

--------------------------
--功能變數
--------------------------
--快捷鍵
local CurrentKey = "G"
local KeyDisabled = false

--自動執行
_G.AutoExecute = false
local ScriptLoadstring = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/xuez1025/Open-soucre/refs/heads/main/WindUI"))()'

--------------------------
-- 建立分頁
--------------------------
local Tabs = {
    Settings = Window:Tab({ Title = "設定", Icon = "settings" })
}

--------------------------
--元件
--------------------------
Tabs.Settings:Section({ Title = "設定" })

Tabs.Settings:Toggle({
    Title = "換服後自動執行",
    Desc = "切換伺服器時自動載入",
    Value = _G.AutoExecute,
    Callback = function(state)
        _G.AutoExecute = state
        
        if _G.AutoExecute and queue_on_teleport then
            queue_on_teleport(ScriptLoadstring)
            WindUI:Notify({
                Title = "通知",
                Content = "已開啟自動執行",
                Duration = 3
            })
        elseif not queue_on_teleport then
            WindUI:Notify({
                Title = "支援錯誤",
                Content = "你目前的注入器不支援",
                Duration = 3
            })
        end
    end
})

Tabs.Settings:Keybind({ 
    Title = "快捷鍵", 
    Desc = "可更改", 
    Value = CurrentKey,
    Callback = function(v)
        CurrentKey = v
        
        if not KeyDisabled then
            Window:SetToggleKey(Enum.KeyCode[v])
        end
    end
})

Tabs.Settings:Toggle({
    Title = "停用快捷鍵",
    Desc = "開啟後將禁用快捷鍵",
    Value = false,
    Callback = function(state)
        KeyDisabled = state
        
        if state then
            Window:SetToggleKey(nil)
        else
            Window:SetToggleKey(Enum.KeyCode[CurrentKey])
        end
    end
})
