-- WindUI 載入
local WindUI = loadstring(game:HttpGet(
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
))()

local Window = WindUI:CreateWindow({
    Title         = "Xu-hub",
    Icon          = "user-check",
    Author        = "by xuez1025",
    Folder        = "Xu-Hub",
    Size          = UDim2.fromOffset(600, 400),
    Transparent   = true,
    Theme         = "Dark",
    User = {
        Enabled   = true,
        Anonymous = false,
        Callback  = function()
            local LocalPlayer = game.Players.LocalPlayer
            WindUI:Notify({ 
                Title = LocalPlayer.Name, 
                Content = "ID: " .. LocalPlayer.UserId, 
                Duration = 3 
            })
        end
    },
    Acrylic       = false,
    HideSearchBar = false,
    SideBarWidth  = 200,
    OpenButton = {
        Title           = "Xu-hub",
        CornerRadius    = UDim.new(1, 0),
        StrokeThickness = 3,
        Enabled         = true,
        OnlyMobile      = false,
        Draggable       = true,
        OnlyIcon        = false,
        Color           = ColorSequence.new(Color3.fromHex("#7F00FF"), Color3.fromHex("#00C6FF")),
    }
})

-- ==================== 變數區域 ====================
_G.CurrentKey = "G"
_G.KeyDisabled = false

_G.TestToggleValue = false
_G.TestSliderValue = 50
_G.TestDropdownValue = "選項1"

-- 新增：換服自動執行設定與腳本來源字串（請將 URL 替換為你的腳本網址）
_G.AutoExecute = false
local ScriptLoadstring = 'loadstring(game:HttpGet("YOUR_SCRIPT_URL_HERE"))()'

-- ==================== 建立分頁 ====================
local Tabs = {
    Components = Window:Tab({ Title = "元件測試", Icon = "box" }),
    Settings   = Window:Tab({ Title = "設定", Icon = "settings" })
}

-- ==================== 元件測試分頁 ====================
Tabs.Components:Section({ Title = "全域變數元件測試 (示範)" })

-- 按鈕 (Button)
Tabs.Components:Button({
    Title = "測試按鈕",
    Callback = function()
        WindUI:Notify({ 
            Title = "系統提示", 
            Content = "當前綁定的快捷鍵為: " .. _G.CurrentKey, 
            Duration = 3 
        })
    end
})

-- 開關 (Toggle)
Tabs.Components:Toggle({
    Title = "測試開關",
    Value = _G.TestToggleValue,
    Callback = function(state)
        _G.TestToggleValue = state
    end
})

-- 滑動條 (Slider)
Tabs.Components:Slider({
    Title = "測試滑塊",
    Step = 1,
    Value = {
        Min = 0,
        Max = 100,
        Default = _G.TestSliderValue
    },
    Callback = function(value)
        _G.TestSliderValue = value
    end
})

-- 下拉選單 (Dropdown)
Tabs.Components:Dropdown({
    Title = "測試下拉選單",
    Value = _G.TestDropdownValue,
    Values = {"選項1", "選項2", "選項3"},
    Callback = function(value)
        _G.TestDropdownValue = value
    end
})

-- ==================== 設定分頁 ====================
Tabs.Settings:Section({ Title = "系統設定" })

-- 新增：換服自動啟動腳本 Toggle
Tabs.Settings:Toggle({
    Title = "換服後自動執行",
    Desc = "切換伺服器時自動重新載入 Xu-hub",
    Value = _G.AutoExecute,
    Callback = function(state)
        _G.AutoExecute = state
        
        -- 依照要求：不使用 OnTeleport:Connect，直接判斷並註冊換服佇列
        if _G.AutoExecute and queue_on_teleport then
            queue_on_teleport(ScriptLoadstring)
            WindUI:Notify({
                Title = "換服執行器",
                Content = "已加入換服啟動佇列！",
                Duration = 3
            })
        elseif not queue_on_teleport then
            WindUI:Notify({
                Title = "支援錯誤",
                Content = "你目前的注入器不支援 queue_on_teleport 功能",
                Duration = 3
            })
        end
    end
})

Tabs.Settings:Section({ Title = "快捷鍵設定" })

Tabs.Settings:Keybind({ 
    Title = "快捷鍵", 
    Desc = "可更改", 
    Value = _G.CurrentKey,
    Callback = function(v)
        _G.CurrentKey = v
        
        if not _G.KeyDisabled then
            Window:SetToggleKey(Enum.KeyCode[v])
        end
    end
})

Tabs.Settings:Toggle({
    Title = "停用快捷鍵",
    Desc = "開啟後將禁用快捷鍵",
    Value = _G.KeyDisabled,
    Callback = function(state)
        _G.KeyDisabled = state
        
        if state then
            -- 停用快捷鍵
            Window:SetToggleKey(nil)
        else
            -- 恢復快捷鍵
            Window:SetToggleKey(Enum.KeyCode[_G.CurrentKey])
        end
    end
})
